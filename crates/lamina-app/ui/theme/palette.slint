// As duas paletas do Lamina (spec DF, seção 4): os mesmos nomes no escuro e no claro. É o único
// lugar da interface com cor escrita (trava `cargo xtask cores`); os valores passam pela trava
// `cargo xtask contraste` (regras 2 a 5 da DF).
//
// Escala neutra de 12 passos (g1 a g12), sem matiz: g1 a g6 são fundos (do mais fundo ao mais
// alto), g7 e g8 fios, g9 a g12 textos e ícones (do mais apagado ao mais forte). Os papéis
// (palco, faixa, painel…) apontam para passos da escala.

export struct Colors {
    g1: color, g2: color, g3: color, g4: color, g5: color, g6: color,
    g7: color, g8: color, g9: color, g10: color, g11: color, g12: color,
    stage: color, strip: color, panel: color, bar: color, raised: color, field: color,
    line: color, line-strong: color,
    text: color, text-2: color, text-3: color, text-strong: color, text-disabled: color,
    accent: color, accent-hover: color, accent-soft: color, on-accent: color, focus: color, link: color,
    warning: color, warning-soft: color, error: color, error-soft: color, success: color,
    hover: color, press: color, overlay: color, overlay-strong: color,
    shadow: color, shadow-strong: color, veil: color, dim: color,
    tag-new-bg: color, tag-bg: color, tag-text: color,
}

export global Palettes {
    out property <Colors> dark: {
        g1: #111111, g2: #1c1c1c, g3: #222222, g4: #262626, g5: #303030, g6: #383838,
        g7: #444444, g8: #555555, g9: #6b6b6b, g10: #858585, g11: #a6a6a6, g12: #e6e6e6,
        stage: #1c1c1c, strip: #262626, panel: #303030, bar: #222222, raised: #383838, field: #1e1e1e,
        line: #3a3a3a, line-strong: #858585,
        text: #e6e6e6, text-2: #a6a6a6, text-3: #858585, text-strong: #f5f5f5, text-disabled: #6b6b6b,
        accent: #19acc9, accent-hover: #3dbbd4, accent-soft: #19acc933, on-accent: #111111, focus: #19acc9, link: #2ebcd8,
        warning: #e3b341, warning-soft: #e3b34126, error: #ef7d75, error-soft: #ef7d7526, success: #5cc283,
        hover: #ffffff14, press: #ffffff26, overlay: #ffffff40, overlay-strong: #ffffffb0,
        shadow: #00000080, shadow-strong: #000000a0, veil: #000000a0, dim: #00000066,
        tag-new-bg: #6b6b6b, tag-bg: #444444, tag-text: #ffffff,
    };
    out property <Colors> light: {
        g1: #cfcfcf, g2: #dcdcdc, g3: #e2e2e2, g4: #e8e8e8, g5: #f4f4f4, g6: #ffffff,
        g7: #c8c8c8, g8: #b0b0b0, g9: #8f8f8f, g10: #707070, g11: #555555, g12: #1c1c1c,
        stage: #dcdcdc, strip: #e8e8e8, panel: #f4f4f4, bar: #e2e2e2, raised: #ffffff, field: #ffffff,
        line: #c8c8c8, line-strong: #7a7a7a,
        text: #1c1c1c, text-2: #555555, text-3: #707070, text-strong: #000000, text-disabled: #9a9a9a,
        accent: #0095b6, accent-hover: #12a8c9, accent-soft: #0095b62e, on-accent: #111111, focus: #007a96, link: #006377,
        warning: #8a5d00, warning-soft: #e3b34133, error: #b3261e, error-soft: #b3261e1f, success: #1e7a3c,
        hover: #00000010, press: #0000001f, overlay: #00000033, overlay-strong: #000000a0,
        shadow: #00000033, shadow-strong: #00000055, veil: #00000066, dim: #00000033,
        tag-new-bg: #a6a6a6, tag-bg: #d4d4d4, tag-text: #000000,
    };
}

// Cores que não mudam com o tema: o que é conteúdo, calibração ou função do editor sobre a lâmina
// (a lâmina é igual à impressão, regra 5 da JP; os tokens nunca tocam o desenho dela).
export global Fixed {
    out property <color> paper: #ffffff;
    out property <color> ink: #000000;
    out property <color> placeholder: #808080;
    out property <color> placeholder-line: #80808099;
    // Guia do ímã, destino de soltar e laço de seleção sobre a lâmina (iguais nos dois temas).
    out property <color> guide: #ff4fd8;
    out property <color> guide-soft: #d84fc4;
    out property <color> target: #ffd23f;
    // O contorno do quadro em recorte, sobre a foto.
    out property <color> crop: #e3b341;
    // Controles de temperatura e matiz (spec TM): azul a âmbar, verde a magenta.
    out property <color> cold: #4a90e2;
    out property <color> warm: #f5c542;
    out property <color> green: #4caf50;
    out property <color> magenta: #d84fc4;
    // O arco-íris do seletor de cor do Novo álbum.
    out property <color> red: #ff0000;
    out property <color> yellow: #ffff00;
    out property <color> lime: #00ff00;
    out property <color> cyan: #00ffff;
    out property <color> blue: #0000ff;
    out property <color> pink: #ff00ff;
    out property <color> white-clear: #ffffff00;
    out property <color> black-clear: #00000000;
}
