// Janela principal do Lamina (spec `janela-principal`). Só desenho: os dados e as decisões vêm
// do lamina-editor, pelo Rust (src/). Aqui ficam a janela, as propriedades, o menu, o teclado e
// os diálogos; a barra do projeto, a área da lâmina e as faixas de baixo estão em topbar.slint,
// stage.slint e bottom.slint, e o estado do arrastar no global DragUi (drag.slint).

import { Button, ScrollView, Palette } from "std-widgets.slint";
// A interface inteira em Inter (spec DF, saída 3), do mesmo arquivo do repositório que o lamina-render
// usa no texto da lâmina (uma fonte só para manter e licenciar).
import "../../lamina-render/fonts/inter/Inter.ttf";
import { Theme, Fixed, Type } from "theme.slint";
import { SpreadData, FrameData, BoxData } from "canvas.slint";
import { ConfirmDialog, MessageDialog, BusyOverlay, RecoverDialog, RecoverUi } from "dialogs.slint";
import { PhotoMenuUi, RemoveAskDialog } from "photo_menu.slint";
export { PhotoMenuUi }
import { NumberStep } from "number_field.slint";
export { NumberStep }
import { NewProjectDialog, NewProjectUi, FormatCard, DrawData } from "new_project.slint";
import { ImportUi, DropOverlay } from "importing.slint";
import { BuildUi, BuildAlbumDialog } from "build_album.slint";
import { BandUi, LayoutBand, LayoutItem } from "band.slint";
import { LookUi, Swatch } from "look.slint";
import { FrameUi } from "frame.slint";
import { FontUi, FontRowUi } from "font_list.slint";
import { AboutDialog } from "about.slint";
import { CalibrateUi, CalibrateDialog } from "calibrate.slint";
import { ModelNameDialog, ModelsDialog, ModelUi } from "models.slint";
import { HistoryItem } from "history.slint";
import { ExportDialog } from "export.slint";
import { PresetNameDialog, PresetsDialog, PresetUi } from "spec.slint";
import { CoverDialog, CoverUi } from "cover.slint";
import { CoverLook } from "cover_look.slint";
export { CoverUi, CoverLook }
import { TimelineItem } from "timeline.slint";
import { PhotoData } from "photo_strip.slint";
import { UpdateBar } from "update_bar.slint";
import { RightPanel, PanelDivider } from "panel.slint";
import { DragGhost, GhostData } from "ghost.slint";
import { ContextUi, ContextMenu, ContextRow } from "context.slint";
import { PaletteUi } from "palette.slint";
import { PhotoUi } from "photo.slint";
import { DetailRow } from "side.slint";
import { OrganizeUi, LassoBox, MarkData, TickData, BarRow } from "organize.slint";
import { Motion } from "motion.slint";
import { ClearRecentsDialog, RecentsUi, RecentCard, RecentItem } from "welcome.slint";
import { ClearAllDialog, ClearUi } from "clear_all.slint";
import { RelinkDialog, RelinkUi, RelinkRowUi } from "relink.slint";
import { DragUi } from "drag.slint";
import { TopBar, NoticeBar, PageMeterData } from "topbar.slint";
import { Stage } from "stage.slint";
import { BottomStrips } from "bottom.slint";
import { ShortcutsUi, ShortcutsDialog, ShortcutGroup, ShortcutRow } from "shortcuts.slint";
import { NewsUi, NewsDialog, NewsEntryData } from "news.slint";
import { RollUi, RollCell, RollButton, RollHitData } from "roll.slint";
import { Gallery } from "gallery.slint";

export { BuildUi }
export { PageMeterData, CalibrateUi, SpreadData, FrameData, BoxData, LayoutItem, BandUi, Swatch, HistoryItem, PhotoData, TimelineItem, PresetUi, LookUi, FrameUi, FontUi, FontRowUi, ModelUi, RecentsUi, ClearUi, RelinkUi, RelinkRowUi, RecentCard, RecentItem, Motion, GhostData, OrganizeUi, MarkData, TickData, BarRow, ContextUi, ContextRow, PaletteUi, PhotoUi, DetailRow, NewProjectUi, FormatCard, DrawData, ImportUi, ShortcutsUi, RecoverUi, ShortcutGroup, ShortcutRow, NewsUi, NewsEntryData, RollUi, RollCell, RollButton, RollHitData }

export component AppWindow inherits Window {
    title: root.window-title;
    icon: @image-url("../icons/lamina-256.png");
    min-width: 800px;
    min-height: 600px;
    preferred-width: 1400px;
    preferred-height: 900px;
    background: Theme.stage;
    forward-focus: keys;
    default-font-family: "Inter";
    default-font-size: Type.body;
    // Os widgets padrão acompanham o tema claro ou escuro (spec DF, regra 4).
    property <bool> dark-theme: Theme.dark;
    changed dark-theme => { Palette.color-scheme = root.dark-theme ? ColorScheme.dark : ColorScheme.light; }
    init => { Palette.color-scheme = root.dark-theme ? ColorScheme.dark : ColorScheme.light; }

    in property <string> window-title: "Lamina";
    in property <string> project-title;
    // Spec NA: o nome do álbum sem o "• " e o campo de renomear do topo.
    in property <string> album-name;
    in-out property <bool> renaming;
    callback rename-album(string);
    // Clique no cabeçalho de uma faixa de baixo (spec FX, regra 9): o Rust ignora o segundo toque.
    callback strip-header-clicked(int);
    // A largura do painel da direita (spec FX, regra 13): o arrasto, o soltar e o clique duplo.
    in property <length> panel-width: 300px;
    callback panel-width-drag(length);
    callback panel-width-set(length);
    callback panel-width-reset();
    in property <string> counter;
    in-out property <bool> gallery;
    in property <bool> has-project;
    in property <bool> can-save;
    in property <bool> can-prev;
    in property <bool> can-next;
    in property <bool> guides: true;
    // A sombra da dobra: a preferência (menu) e se aparece agora (spec DJ, regra 2).
    in property <bool> gutter-shadow-on: true;
    in property <bool> gutter-shadow;
    in property <PageMeterData> page-meter;
    // A altura da faixa Lâminas (spec DJ, regra 12).
    in property <length> strip-height: 128px;
    // "Reduzir movimento" ligado (spec MV, regra 14): a marca no menu Visualizar.
    in property <bool> reduce-motion;
    // Ir para outra lâmina (spec MV, seção 4): a lâmina que sai. O deslize e o relógio dele são da
    // área da lâmina (stage.slint).
    in property <SpreadData> leaving;
    in property <bool> has-leaving;
    // As vagas da lâmina grande: sempre a mesma lista (spec RL, regra 32).
    in property <[FrameData]> slots;
    callback nav-ended <=> stage.nav-ended;
    // `dir`: 1 = para a frente (a nova vem da direita), -1 = para trás.
    public function start-nav(dir: int) {
        stage.start-nav(dir);
    }
    in property <SpreadData> current;
    in property <int> current-index;
    in property <[SpreadData]> spreads;
    in property <[PhotoData]> photos;
    in property <int> filter;
    in property <int> selected-photo: -1;
    in property <string> info-album;
    in property <string> info-spread;
    in property <string> info-warnings;
    in property <string> info-photo;
    in property <string> notice;
    in property <string> version;
    // Atualização automática (spec DS): o texto da barra e as marcas do menu Ajuda.
    in property <string> update-bar;
    in property <bool> auto-updates: true;
    in property <bool> beta-updates;
    callback update-restart();
    callback update-dismiss();
    in property <bool> can-undo;
    in property <bool> can-redo;

    // A aba do painel da direita: Detalhes, a de partida (os layouts ficam na faixa, spec FL).
    in-out property <int> panel-tab: 1;
    // O painel da direita aberto (Alt+4) e a aba Detalhes (spec AF).
    in property <bool> panel-open: true;
    // As dicas da barra de cima (spec JE): Início, Fotos, Painel e Exportar.
    in property <[string]> bar-tips: ["", "", "", ""];
    in property <[DetailRow]> details;
    in property <int> details-kind;
    in property <string> details-count;
    in property <[DetailRow]> details-print;

    in-out property <bool> show-confirm;
    in-out property <bool> show-message;
    in-out property <bool> show-about;
    in property <string> message-title;
    in property <string> message-text;
    in property <string> message-details;
    in property <string> message-folder;
    callback open-folder();
    // Janela Exportar (spec EI).
    in-out property <bool> show-export;
    in property <string> ex-folder;
    in-out property <bool> ex-all: true;
    in-out property <string> ex-range;
    in-out property <bool> ex-pages;
    in-out property <int> ex-quality: 95;
    in-out property <int> ex-format;
    in-out property <int> ex-cover;
    in-out property <bool> ex-has-cover;
    in-out property <bool> ex-marks;
    in-out property <bool> ex-adobe;
    in property <string> ex-error;
    in property <int> ex-step;
    in property <[string]> ex-warnings;
    in property <string> ex-album;
    in property <string> ex-replace-text;
    callback ex-pick-folder();
    callback ex-changed();
    callback ex-export();
    callback ex-go-to(int);
    callback ex-ignore(int);
    callback ex-proceed();
    callback ex-replace();
    callback ex-back();
    in property <bool> has-missing;
    // O álbum em branco e "Montar o álbum…" (spec BR).
    in property <bool> empty-album;
    in property <float> blank-aspect: 0.5;
    in property <color> blank-color: Fixed.paper;
    in property <bool> can-build-album;
    // Fora da faixa de páginas do laboratório (spec PR): ao lado do contador.
    in property <string> counter-warning;
    // Faixas de baixo (spec PN): o resumo de cada uma e se está aberta.
    in property <string> strip-spreads;
    in property <string> strip-timeline;
    in property <string> strip-photos;
    in property <bool> spreads-open: true;
    in property <bool> timeline-open: true;
    in property <bool> photos-open: true;
    // A grade do painel de fotos (spec PF): zoom, colunas, rolagem e a altura mostrada, que o Rust
    // calcula com os limites da divisória (contas no editor).
    in-out property <float> photo-zoom: 96;
    in property <int> photo-columns: 1;
    in-out property <length> photo-scroll;
    in property <length> photo-shown: 252px;
    callback photo-room <=> bottom.photo-room;
    callback photo-height-drag <=> bottom.photo-height-drag;
    pure callback photo-lasso-speed <=> bottom.lasso-speed;
    callback photo-view <=> bottom.photo-view;
    callback photo-zoom-to <=> bottom.photo-zoom-to;
    callback photo-zoom-wheel <=> bottom.photo-zoom-wheel;
    callback photo-lasso <=> bottom.photo-lasso;
    callback photo-height-set <=> bottom.photo-height-set;
    callback photo-height-reset <=> bottom.photo-height-reset;
    in property <string> busy-text;

    // Campos da janela "Novo álbum".

    callback command(string);
    callback key(string, bool, bool, bool) -> bool;
    callback go-to <=> bottom.go-to;
    callback photo-clicked(int);
    callback photo-double-clicked <=> bottom.photo-double-clicked;
    callback filter-changed <=> bottom.filter-changed;
    callback confirm(int);
    // Arrastar (spec FQ; spec MV, regra 12): o gesto mora no global DragUi. O fantasma vem do
    // editor quando o arrasto começa; o destaque é o quadro onde a soltura cairia; ao soltar num
    // quadro, o fantasma pousa nele.
    in property <GhostData> ghost;
    callback drag-started(int, int);
    pure callback drop-at <=> stage.drop-at;
    pure callback strip-gap <=> bottom.strip-gap;
    pure callback strip-shift <=> bottom.strip-shift;
    pure callback strip-landing <=> bottom.strip-landing;
    pure callback strip-edge <=> bottom.strip-edge;
    property <int> drag-kind: DragUi.kind;
    changed drag-kind => {
        if (root.drag-kind == 1 || root.drag-kind == 2) {
            root.drag-started(root.drag-kind, DragUi.from);
        }
    }
    property <float> land-p: DragUi.landing ? min(1, (animation-tick() - DragUi.land-t0) / max(1ms, Motion.land-ms * 1ms)) : 1;
    property <float> land-e: 1 - pow(1 - root.land-p, 3);
    changed land-p => {
        if (DragUi.landing && root.land-p >= 1) {
            DragUi.landing = false;
        }
    }
    in property <int> selected-frame: -1;
    in property <[TimelineItem]> timeline;
    // Histórico (spec HI).
    in property <[HistoryItem]> history;
    in property <int> history-pos;
    in property <string> undo-text;
    in property <string> redo-text;
    callback history-go(int);
    // Recorte (spec RC).
    in property <int> crop-frame: -1;
    in property <bool> has-preview;
    in property <BoxData> preview;
    in property <image> preview-img;
    in property <string> info-frame;
    in property <bool> info-frame-warn;
    callback frame-double <=> stage.frame-double;
    callback crop-drag <=> stage.crop-drag;
    callback crop-end <=> stage.crop-end;
    callback crop-wheel <=> stage.crop-wheel;
    // Quadros à mão (spec TX): alças e arrasto do texto; o mouse na lâmina para o T.
    callback frame-grab <=> stage.frame-grab;
    callback frame-drag <=> stage.frame-drag;
    callback organize-press <=> stage.organize-press;
    callback frame-release <=> stage.frame-release;
    in-out property <float> hover-fx: -1;
    // Dica embaixo da lâmina: o que dá para fazer com o quadro selecionado.
    in property <string> hint;
    callback photo-pressed <=> bottom.photo-pressed;
    callback drop-photo(int, float, float);
    // Fotos do navegador soltas num vão da faixa de lâminas: (foto arrastada, vão).
    callback drop-photos-gap <=> bottom.drop-photos-gap;
    // O ponteiro sobre a área de lâmina nova, para os arquivos soltos do Explorador (spec IM).
    out property <bool> new-spread-hover: bottom.new-spread-hover;
    callback drop-frame <=> stage.drop-frame;
    callback frame-selected <=> stage.frame-selected;
    // Clique num quadro, com Ctrl (ou Cmd) e Shift: no modo organizar, soma ou tira (spec EG).
    callback frame-clicked <=> stage.frame-clicked;
    // A grade do recorte (spec AF).
    in property <bool> crop-grid-thirds;
    in property <bool> crop-grid-fine;
    // Clique direito na lâmina: o menu de contexto (spec EG, regra 13).
    callback context-requested <=> stage.context-requested;
    // O laço do modo organizar: os dois cantos em frações da largura da lâmina e o Shift.
    callback lasso-done <=> stage.lasso-done;
    callback move-spread <=> bottom.move-spread;
    callback cut-moved <=> bottom.cut-moved;
    pure callback seq-marker <=> bottom.seq-marker;
    callback seq-drop <=> bottom.seq-drop;

    public function focus-main() {
        keys.focus();
    }

    // Abre o endereço no navegador do sistema (formulário de sugestões, spec SR).
    public function open-url(url: string) -> bool {
        return Platform.open-url(url);
    }

    // O menu nativo fica estável durante a edição (spec MV, regra 16): mudar o título ou o
    // "enabled" de um item faz o Slint 1.18 refazer a barra inteira e o Windows redimensionar a
    // janela duas vezes (~70 ms antes do primeiro quadro). Cada comando confere sozinho se pode rodar.
    MenuBar {
        Menu {
            title: "Arquivo";
            MenuItem { title: "Novo álbum…  (Ctrl+N)"; activated => { root.command("arquivo.novo"); } }
            MenuItem { title: "Abrir…  (Ctrl+O)"; activated => { root.command("arquivo.abrir"); } }
            Menu {
                title: "Abrir recente";
                for item in RecentsUi.menu: MenuItem { title: item.label; enabled: item.enabled; activated => { RecentsUi.open(item.index); } }
            }
            MenuItem { title: "Abrir o álbum de exemplo"; activated => { root.command("arquivo.exemplo"); } }
            MenuSeparator { }
            MenuItem { title: "Importar fotos…  (Ctrl+I)"; enabled: root.has-project; activated => { root.command("arquivo.importar"); } }
            MenuItem { title: "Importar uma pasta de fotos…"; enabled: root.has-project; activated => { root.command("arquivo.importar-pasta"); } }
            MenuItem { title: "Limpar recentes não fixados…"; enabled: RecentsUi.menu.length > 0; activated => { root.command("arquivo.limpar-recentes"); } }
            MenuSeparator { }
            MenuItem { title: "Fechar álbum  (Ctrl+W)"; enabled: root.has-project; activated => { root.command("arquivo.fechar"); } }
            MenuSeparator { }
            MenuItem { title: "Salvar  (Ctrl+S)"; enabled: root.has-project; activated => { root.command("arquivo.salvar"); } }
            MenuItem { title: "Salvar como…  (Ctrl+Shift+S)"; enabled: root.has-project; activated => { root.command("arquivo.salvar-como"); } }
            // O mesmo que o clique duplo no nome do álbum, no topo (spec NA).
            MenuItem { title: "Renomear álbum…"; enabled: root.has-project; activated => { root.command("arquivo.renomear"); } }
            MenuSeparator { }
            MenuItem { title: "Exportar…  (Ctrl+E)"; enabled: root.has-project; activated => { root.command("arquivo.exportar"); } }
            MenuItem { title: "Reencontrar fotos…"; enabled: root.has-missing; activated => { root.command("arquivo.procurar-fotos"); } }
            MenuSeparator { }
            MenuItem { title: "Especificação do álbum…"; enabled: root.has-project; activated => { root.command("arquivo.especificacao"); } }
            MenuItem { title: "Montagem do álbum…"; enabled: root.has-project; activated => { root.command("arquivo.montagem"); } }
            MenuItem { title: "Presets…"; activated => { root.command("arquivo.presets"); } }
            MenuSeparator { }
            // Como o X da janela (spec SA).
            MenuItem { title: "Sair  (Ctrl+Q)"; activated => { root.command("arquivo.sair"); } }
        }
        Menu {
            title: "Editar";
            MenuItem { title: "Desfazer  (Ctrl+Z)"; enabled: root.has-project; activated => { root.command("editar.desfazer"); } }
            MenuItem { title: "Refazer  (Ctrl+Y)"; enabled: root.has-project; activated => { root.command("editar.refazer"); } }
            MenuSeparator { }
            MenuItem { title: "Copiar  (Ctrl+C)"; enabled: root.has-project; activated => { root.command("editar.copiar"); } }
            MenuItem { title: "Colar  (Ctrl+V)"; enabled: root.has-project; activated => { root.command("editar.colar"); } }
            MenuItem { title: "Duplicar  (Ctrl+D)"; enabled: root.has-project; activated => { root.command("editar.duplicar"); } }
            MenuItem { title: "Selecionar todos os quadros  (Ctrl+A)"; enabled: root.has-project; activated => { root.command("editar.selecionar-quadros"); } }
            MenuItem { title: "Selecionar todas as fotos mostradas  (Ctrl+A)"; enabled: root.has-project; activated => { root.command("editar.selecionar-fotos"); } }
        }
        Menu {
            title: "Lâmina";
            MenuItem { title: "Próxima lâmina  (Page Down)"; enabled: root.has-project; activated => { root.command("lamina.proxima"); } }
            MenuItem { title: "Lâmina anterior  (Page Up)"; enabled: root.has-project; activated => { root.command("lamina.anterior"); } }
            MenuItem { title: "Primeira lâmina  (Home)"; enabled: root.has-project; activated => { root.command("lamina.primeira"); } }
            MenuItem { title: "Última lâmina  (End)"; enabled: root.has-project; activated => { root.command("lamina.ultima"); } }
            MenuSeparator { }
            MenuItem { title: "Nova lâmina em branco"; enabled: root.has-project; activated => { root.command("lamina.nova-em-branco"); } }
            MenuItem { title: "Nova lâmina em branco antes"; enabled: root.has-project; activated => { root.command("lamina.nova-em-branco-antes"); } }
            MenuSeparator {}
            MenuItem { title: "Novo texto  (T)"; enabled: root.has-project; activated => { root.command("lamina.novo-texto"); } }
            MenuItem { title: "Editar texto"; enabled: root.has-project; activated => { root.command("lamina.editar-texto"); } }
            MenuItem { title: "Novo quadro de foto"; enabled: root.has-project; activated => { root.command("lamina.novo-quadro"); } }
            MenuItem { title: "Trazer para a frente"; enabled: root.has-project; activated => { root.command("lamina.frente"); } }
            MenuItem { title: "Enviar para trás"; enabled: root.has-project; activated => { root.command("lamina.tras"); } }
            MenuSeparator { }
            MenuItem { title: "Montar o álbum…"; enabled: root.has-project; activated => { root.command("lamina.montar-album"); } }
            // Limpar as lâminas (spec LL): cada um pergunta antes.
            MenuItem { title: "Tirar as fotos de todas as lâminas…"; enabled: root.has-project; activated => { root.command("lamina.tirar-todas-as-fotos"); } }
            MenuItem { title: "Apagar todas as lâminas…"; enabled: root.has-project; activated => { root.command("lamina.apagar-todas"); } }
            MenuSeparator { }
            MenuItem { title: "Organizar lâmina  (O)"; enabled: root.has-project; activated => { root.command("lamina.organizar"); } }
            Menu {
                title: "Alinhar";
                MenuItem { title: "À esquerda"; enabled: root.has-project; activated => { root.command("organizar.alinhar-esquerda"); } }
                MenuItem { title: "Ao centro"; enabled: root.has-project; activated => { root.command("organizar.alinhar-centro"); } }
                MenuItem { title: "À direita"; enabled: root.has-project; activated => { root.command("organizar.alinhar-direita"); } }
                MenuItem { title: "Ao topo"; enabled: root.has-project; activated => { root.command("organizar.alinhar-topo"); } }
                MenuItem { title: "Ao meio"; enabled: root.has-project; activated => { root.command("organizar.alinhar-meio"); } }
                MenuItem { title: "À base"; enabled: root.has-project; activated => { root.command("organizar.alinhar-base"); } }
            }
            Menu {
                title: "Igualar";
                MenuItem { title: "Largura"; enabled: root.has-project; activated => { root.command("organizar.igualar-largura"); } }
                MenuItem { title: "Altura"; enabled: root.has-project; activated => { root.command("organizar.igualar-altura"); } }
                MenuItem { title: "Tamanho"; enabled: root.has-project; activated => { root.command("organizar.igualar-tamanho"); } }
            }
            Menu {
                title: "Distribuir";
                MenuItem { title: "Na horizontal"; enabled: root.has-project; activated => { root.command("organizar.distribuir-horizontal"); } }
                MenuItem { title: "Na vertical"; enabled: root.has-project; activated => { root.command("organizar.distribuir-vertical"); } }
            }
            MenuSeparator { }
            MenuItem { title: "Salvar como modelo…"; enabled: root.has-project; activated => { root.command("lamina.salvar-modelo"); } }
            MenuItem { title: "Meus modelos…"; activated => { root.command("lamina.modelos"); } }
        }
        Menu {
            title: "Capa";
            MenuItem { title: "Criar a capa…"; enabled: root.has-project; activated => { root.command("capa.criar"); } }
            MenuItem { title: "Ir para a capa"; enabled: root.has-project; activated => { root.command("capa.ir"); } }
            MenuItem { title: "Medidas da capa…"; enabled: root.has-project; activated => { root.command("capa.medidas"); } }
            MenuItem { title: "Mostrar o guia"; enabled: root.has-project; activated => { root.command("capa.guia"); } }
            MenuSeparator { }
            MenuItem { title: "Apagar a capa"; enabled: root.has-project; activated => { root.command("capa.apagar"); } }
        }
        Menu {
            title: "Layout";
            MenuItem { title: "Próximo layout  (↓)"; enabled: root.has-project; activated => { root.command("layout.proximo"); } }
            MenuItem { title: "Layout anterior  (↑)"; enabled: root.has-project; activated => { root.command("layout.anterior"); } }
            MenuSeparator { }
            MenuItem { title: "Espelhar lâmina  (E)"; enabled: root.has-project; activated => { root.command("layout.espelhar"); } }
            MenuItem { title: "Favoritar layout  (F)"; enabled: root.has-project; activated => { root.command("layout.favoritar"); } }
            MenuItem { title: "Rejeitar layout  (X)"; enabled: root.has-project; activated => { root.command("layout.rejeitar"); } }
            MenuItem { title: BandUi.list == 1 ? "Mostrar na ordem  (R)" : "Mostrar reordenadas  (R)"; enabled: root.has-project; activated => { root.command("layout.reordenadas"); } }
            MenuSeparator { }
            MenuItem { title: "Apagar o aprendizado de layouts…"; activated => { root.command("layout.apagar-aprendizado"); } }
        }
        Menu {
            title: "Visualizar";
            MenuItem { title: root.guides ? "Esconder guias  (G)" : "Mostrar guias  (G)"; enabled: root.has-project; activated => { root.command("ver.guias"); } }
            MenuSeparator { }
            MenuItem { title: (root.spreads-open ? "✓ " : "    ") + "Faixa de lâminas  (Alt+1)"; enabled: root.has-project; activated => { root.command("ver.faixa-laminas"); } }
            MenuItem { title: (root.timeline-open ? "✓ " : "    ") + "Sequência  (Alt+2)"; enabled: root.has-project; activated => { root.command("ver.linha-do-tempo"); } }
            MenuItem { title: (root.photos-open ? "✓ " : "    ") + "Fotografias  (Alt+3)"; enabled: root.has-project; activated => { root.command("ver.fotos"); } }
            // As três faixas de baixo de uma vez (spec FX, regra 8).
            MenuItem { title: "    Faixas de baixo  (Alt+0)"; enabled: root.has-project; activated => { root.command("ver.faixas"); } }
            MenuItem { title: (root.panel-open ? "✓ " : "    ") + "Mostrar painel  (Alt+4)"; enabled: root.has-project; activated => { root.command("ver.painel"); } }
            // Sem a marca: o título fixo não refaz a barra a cada abrir e fechar (spec MV, regra 16).
            MenuItem { title: "    Faixa de layouts  (L)"; enabled: root.has-project; activated => { root.command("ver.faixa-layouts"); } }
            MenuSeparator { }
            MenuItem { title: (root.gutter-shadow-on ? "✓ " : "    ") + "Sombra da dobra"; activated => { root.command("ver.sombra-dobra"); } }
            MenuItem { title: (root.reduce-motion ? "✓ " : "    ") + "Reduzir movimento"; activated => { root.command("ver.reduzir-movimento"); } }
            MenuSeparator { }
            MenuItem { title: "Lupa  (Z)"; enabled: OrganizeUi.on; activated => { root.command("organizar.lupa"); } }
            MenuItem { title: "Tamanho real (1:1)  (1)"; enabled: OrganizeUi.on; activated => { root.command("organizar.tamanho-real"); } }
            MenuItem { title: "Calibrar o tamanho real…"; enabled: root.has-project; activated => { root.command("organizar.calibrar"); } }
        }
        Menu {
            title: "Ajuda";
            MenuItem { title: "Atalhos do teclado…  (Ctrl+/)"; activated => { root.command("ajuda.atalhos"); } }
            MenuItem { title: "O que há de novo…"; activated => { root.command("ajuda.novidades"); } }
            MenuSeparator { }
            MenuItem { title: "Verificar atualizações agora"; activated => { root.command("ajuda.verificar-atualizacoes"); } }
            MenuItem { title: (root.auto-updates ? "✓ " : "    ") + "Verificar atualizações automaticamente"; activated => { root.command("ajuda.atualizar-automaticamente"); } }
            MenuItem { title: (root.beta-updates ? "✓ " : "    ") + "Receber versões de teste (beta)"; activated => { root.command("ajuda.versoes-de-teste"); } }
            MenuSeparator { }
            MenuItem { title: "Enviar sugestão ou problema…"; activated => { root.command("ajuda.enviar-sugestao"); } }
            MenuItem { title: "Abrir pasta de registros"; activated => { root.command("ajuda.abrir-registros"); } }
            MenuSeparator { }
            MenuItem { title: "Sobre o Lamina"; activated => { root.command("ajuda.sobre"); } }
        }
    }

    keys := FocusScope {
        key-pressed(event) => {
            if (CoverUi.open || NewProjectUi.show || root.show-confirm || root.show-message || root.show-about || root.show-export || PresetUi.show-spec || PresetUi.show-name || PresetUi.show-list || ModelUi.show-name || ModelUi.show-list || RecentsUi.show-clear || ClearUi.show || RelinkUi.show || PhotoMenuUi.show-ask || CalibrateUi.show || ShortcutsUi.show || NewsUi.show || BuildUi.show || RecoverUi.show || root.busy-text != "") {
                return reject;
            }
            // No modo organizar, Espaço segurado é a mão (spec EG, seção 3).
            if (OrganizeUi.on && event.text == " ") {
                OrganizeUi.hand = true;
                return accept;
            }
            // Esc com uma lâmina levantada na faixa: ela volta ao lugar (spec FX, regra 5); com uma
            // foto levantada na Sequência, desiste (spec SQ).
            if ((DragUi.kind == 3 || DragUi.kind == 5) && event.text == Key.Escape) {
                DragUi.cancel = true;
                return accept;
            }
            // Teclas especiais chegam como o caractere do Slint; o Rust traduz o nome.
            root.key(event.text, event.modifiers.control, event.modifiers.shift, event.modifiers.alt) ? accept : reject
        }
        key-released(event) => {
            if (event.text == " " && OrganizeUi.hand) {
                OrganizeUi.hand = false;
                return accept;
            }
            reject
        }

        VerticalLayout {
            top := TopBar {
                // Por cima do resto, para os balões de dica dos botões descerem sobre a lâmina.
                z: 10;
                page-meter: root.page-meter;
                has-project: root.has-project;
                project-title: root.project-title;
                album-name: root.album-name;
                renaming <=> root.renaming;
                rename(text) => { root.rename-album(text); }
                counter: root.counter;
                counter-warning: root.counter-warning;
                strips-open: root.spreads-open || root.timeline-open || root.photos-open;
                panel-open: root.panel-open;
                tip-home: root.bar-tips[0];
                tip-photos: root.bar-tips[1];
                tip-panel: root.bar-tips[2];
                tip-export: root.bar-tips[3];
                command(name) => { root.command(name); }
            }

            if root.update-bar != "": UpdateBar {
                text: root.update-bar;
                restart => { root.update-restart(); }
                dismiss => { root.update-dismiss(); }
            }

            if root.notice != "": NoticeBar {
                text: root.notice;
                has-missing: root.has-missing;
                command(name) => { root.command(name); }
            }

            HorizontalLayout {
                vertical-stretch: 1;
                // A lâmina e as faixas de baixo numa coluna; o painel da direita ao lado, na altura
                // toda (correção do dono de 2026-10-29, spec FX).
                VerticalLayout {
                    horizontal-stretch: 1;
                    // Lâmina atual.
                    stage := Stage {
                        horizontal-stretch: 1;
                        vertical-stretch: 1;
                        has-project: root.has-project;
                        current: root.current;
                        slots: root.slots;
                        guides: root.guides;
                        gutter-shadow: root.gutter-shadow;
                        selected-frame: root.selected-frame;
                        empty-album: root.empty-album;
                        photo-count: root.photos.length;
                        blank-aspect: root.blank-aspect;
                        blank-color: root.blank-color;
                        can-build: root.can-build-album;
                        hint: root.hint;
                        crop-frame: root.crop-frame;
                        has-preview: root.has-preview;
                        preview: root.preview;
                        preview-img: root.preview-img;
                        crop-grid-thirds: root.crop-grid-thirds;
                        crop-grid-fine: root.crop-grid-fine;
                        hover-fx <=> root.hover-fx;
                        ghost: root.ghost;
                        leaving: root.leaving;
                        has-leaving: root.has-leaving;
                        command(name) => { root.command(name); }
                        focus-main => { root.focus-main(); }
                    }
                    bottom := BottomStrips {
                        strip-height: root.strip-height;
                        has-project: root.has-project;
                        strip-spreads: root.strip-spreads;
                        strip-timeline: root.strip-timeline;
                        strip-photos: root.strip-photos;
                        spreads-open: root.spreads-open;
                        timeline-open: root.timeline-open;
                        photos-open: root.photos-open;
                        spreads: root.spreads;
                        current-index: root.current-index;
                        current-aspect: root.current.aspect;
                        timeline: root.timeline;
                        photos: root.photos;
                        selected-photo: root.selected-photo;
                        filter: root.filter;
                        can-build: root.can-build-album;
                        photo-zoom <=> root.photo-zoom;
                        photo-columns: root.photo-columns;
                        photo-scroll <=> root.photo-scroll;
                        photo-shown: root.photo-shown;
                        room: root.height;
                        above: top.height + (root.update-bar != "" ? 30px : 0px) + (root.notice != "" ? 30px : 0px);
                        command(name) => { root.command(name); }
                        header-clicked(i) => { root.strip-header-clicked(i); }
                        focus-main => { root.focus-main(); }
                        // Fora da faixa de lâminas, a foto cai na lâmina grande (num quadro ou nela).
                        photos-dropped => {
                            stage.land();
                            root.drop-photo(DragUi.from, stage.frac-x(), stage.frac-y());
                        }
                    }
                }

                // A borda do painel, que muda a largura dele (spec FX, regra 13).
                if root.has-project && root.panel-open: PanelDivider {
                    shown: root.panel-width;
                    moved(w) => { root.panel-width-drag(w); }
                    released => { root.panel-width-set(root.panel-width); }
                    reset => { root.panel-width-reset(); }
                }
                // Painel da direita: Detalhes (padrão), Aparência, Quadro e Histórico.
                if root.has-project && root.panel-open: RightPanel {
                    panel-width: root.panel-width;
                    tab <=> root.panel-tab;
                    details: root.details;
                    details-kind: root.details-kind;
                    details-print: root.details-print;
                    details-count: root.details-count;
                    history: root.history;
                    history-pos: root.history-pos;
                    info-album: root.info-album;
                    info-spread: root.info-spread;
                    info-warnings: root.info-warnings;
                    info-frame: root.info-frame;
                    info-frame-warn: root.info-frame-warn;
                    info-photo: root.info-photo;
                    history-go(i) => { root.history-go(i); }
                    done => { root.focus-main(); }
                }
            }
        }
    }

    // A faixa de layouts (spec FL) desce sobre a área da lâmina; com ela aberta, o primeiro clique
    // fora dela só a fecha (regra 2).
    if root.has-project && BandUi.open: TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                BandUi.close();
                root.focus-main();
            }
        }
        // A roda fora da faixa não passa para o rolo de baixo: a lâmina andaria sob a prévia.
        scroll-event(e) => { accept }
    }
    if root.has-project: LayoutBand {
        x: stage.absolute-position.x;
        y: stage.absolute-position.y;
        width: stage.width;
        aspect: root.current.aspect;
        done => { root.focus-main(); }
    }

    if NewProjectUi.show: NewProjectDialog {
        closed => { root.focus-main(); }
    }
    if root.show-confirm: ConfirmDialog {
        name: root.project-title;
        answer(choice) => { root.confirm(choice); }
    }
    if root.show-export: ExportDialog {
        folder: root.ex-folder;
        all-spreads <=> root.ex-all;
        range <=> root.ex-range;
        pages <=> root.ex-pages;
        cover <=> root.ex-cover;
        has-cover: root.ex-has-cover;
        quality <=> root.ex-quality;
        format <=> root.ex-format;
        marks <=> root.ex-marks;
        adobe <=> root.ex-adobe;
        error: root.ex-error;
        step: root.ex-step;
        warnings: root.ex-warnings;
        album-warning: root.ex-album;
        replace-text: root.ex-replace-text;
        pick-folder => { root.ex-pick-folder(); }
        changed => { root.ex-changed(); }
        export => { root.ex-export(); }
        go-to(i) => { root.ex-go-to(i); }
        ignore(i) => { root.ex-ignore(i); }
        proceed => { root.ex-proceed(); }
        replace => { root.ex-replace(); }
        back => { root.ex-back(); }
        cancel => {
            root.show-export = false;
            root.focus-main();
        }
    }
    if CoverUi.open: CoverDialog { }
    if PresetUi.show-list: PresetsDialog { }
    if PresetUi.show-name: PresetNameDialog { }
    if ModelUi.show-name: ModelNameDialog { }
    if ModelUi.show-list: ModelsDialog { }
    if ShortcutsUi.show: ShortcutsDialog {
        closed => { root.focus-main(); }
    }
    // Abaixo da mensagem de erro: um erro ao reabrir o álbum fica por cima (spec NV, regra 6).
    if NewsUi.show: NewsDialog {
        closed => { root.focus-main(); }
        send-feedback => { root.command("ajuda.enviar-sugestao"); }
        try-now(name) => {
            root.focus-main();
            root.command(name);
        }
    }
    if root.show-message: MessageDialog {
        title: root.message-title;
        message: root.message-text;
        details: root.message-details;
        folder: root.message-folder;
        open-folder => { root.open-folder(); }
        send-problem => { root.command("ajuda.enviar-sugestao"); }
        close => {
            root.show-message = false;
            root.focus-main();
        }
    }
    if root.show-about: AboutDialog {
        version: root.version;
        close => {
            root.show-about = false;
            root.focus-main();
        }
    }
    if BuildUi.show: BuildAlbumDialog { }
    if CalibrateUi.show: CalibrateDialog { }
    if RecentsUi.show-clear: ClearRecentsDialog {
        closed => { root.focus-main(); }
    }
    if ClearUi.show: ClearAllDialog {
        closed => { root.focus-main(); }
    }
    if RelinkUi.show: RelinkDialog {
        closed => { root.focus-main(); }
    }
    if PhotoMenuUi.show-ask: RemoveAskDialog {
        closed => { root.focus-main(); }
    }
    // Por cima de tudo na abertura, até das novidades (spec CS, regra 4).
    if RecoverUi.show: RecoverDialog { }
    if DragUi.kind == 1 || DragUi.kind == 2 || DragUi.landing: DragGhost {
        ghost: root.ghost;
        landing: DragUi.landing;
        width: DragUi.landing ? DragUi.land-w0 + (DragUi.land-w1 - DragUi.land-w0) * root.land-e : root.ghost.w * 1px;
        height: DragUi.landing ? DragUi.land-h0 + (DragUi.land-h1 - DragUi.land-h0) * root.land-e : root.ghost.h * 1px;
        x: DragUi.landing ? DragUi.land-x0 + (DragUi.land-x1 - DragUi.land-x0) * root.land-e : DragUi.x - self.width / 2;
        y: DragUi.landing ? DragUi.land-y0 + (DragUi.land-y1 - DragUi.land-y0) * root.land-e : DragUi.y - self.height / 2;
        opacity: DragUi.landing ? 0.85 * (1 - root.land-p) + 0.15 : 0.85;
    }
    if OrganizeUi.lassoing && stage.lasso-moved: LassoBox { }
    if ImportUi.dropping: DropOverlay { }
    if ContextUi.open: ContextMenu {
        width: root.width;
        height: root.height;
    }
    if root.busy-text != "": BusyOverlay {
        text: root.busy-text;
    }
    // Galeria de componentes (spec DF, saída 6), aberta por `LAMINA_GALERIA=1`.
    if root.gallery: Gallery {
        close => {
            root.gallery = false;
            root.focus-main();
        }
    }
}
