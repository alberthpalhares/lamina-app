// O menu de contexto da lâmina (spec EG, regra 13). Só desenho: o editor monta os itens a partir
// do registro de comandos e o Rust preenche o `ContextUi`.

import { Theme, Radius } from "theme.slint";
import { Icons } from "icons.slint";

// Uma linha do menu: 0 = comando, 1 = submenu (abre e fecha no lugar), 2 = separador.
export struct ContextRow {
    label: string,
    kind: int,
    enabled: bool,
    open: bool,
    indent: bool,
    checked: bool,
}

export global ContextUi {
    in-out property <bool> open;
    // Onde o clique direito aconteceu, em pixels da janela.
    in property <length> x;
    in property <length> y;
    in property <[ContextRow]> rows;
    callback pick(int);
    callback close();
}

// O menu por cima da janela inteira: clicar fora fecha.
export component ContextMenu inherits Rectangle {
    TouchArea {
        clicked => { ContextUi.close(); }
        pointer-event(e) => {
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) {
                ContextUi.close();
            }
        }
    }
    Rectangle {
        x: max(0px, min(ContextUi.x, root.width - self.width - 4px));
        y: max(0px, min(ContextUi.y, root.height - self.height - 4px));
        width: 250px;
        height: list.preferred-height;
        background: Theme.panel;
        border-radius: Radius.medium;
        border-width: 1px;
        border-color: Theme.line;
        drop-shadow-blur: 12px;
        drop-shadow-color: Theme.shadow;
        list := VerticalLayout {
            padding: 4px;
            for r[i] in ContextUi.rows: Rectangle {
                height: r.kind == 2 ? 9px : 26px;
                border-radius: Radius.small;
                background: r.kind != 2 && touch.has-hover && (r.enabled || r.kind == 1) ? Theme.hover : transparent;
                if r.kind == 2: Rectangle {
                    y: 4px;
                    height: 1px;
                    background: Theme.line;
                }
                if r.checked: Image {
                    accessible-role: none;
                    x: 8px;
                    y: (parent.height - 14px) / 2;
                    width: 14px;
                    height: 14px;
                    source: Icons.check;
                    colorize: Theme.text;
                }
                if r.kind != 2: Text {
                    x: r.indent || r.checked ? 26px : 10px;
                    height: parent.height;
                    text: r.label;
                    color: r.enabled || r.kind == 1 ? Theme.text : Theme.text-2;
                    vertical-alignment: center;
                }
                if r.kind == 1: Image {
                    accessible-role: none;
                    x: parent.width - 22px;
                    y: (parent.height - 14px) / 2;
                    width: 14px;
                    height: 14px;
                    source: Icons.chevron-right;
                    colorize: Theme.text-2;
                    transform-rotation: r.open ? 90deg : 0deg;
                }
                touch := TouchArea {
                    enabled: r.kind == 1 || (r.kind == 0 && r.enabled);
                    clicked => { ContextUi.pick(i); }
                }
            }
        }
    }
}
