// "O que há de novo" (specs NV e PV): o que a página mostra. Só dados: quais versões aparecem, os
// filtros, a busca, os destaques e os textos saem do `lamina-editor` (`updates::news`). O desenho
// está em `news_page.slint`, `news_item.slint` e `news_cover.slint`.

// Uma linha da lista: a novidade e, na primeira que aparece de cada versão, o cabeçalho dela.
export struct NewsEntryData {
    // A posição do item na lista completa: não muda com o filtro nem com a busca.
    index: int,
    date: string,
    version: string,
    intro: string,
    // A versão que roda, marcada "Esta versão" (só pela Ajuda).
    current: bool,
    label: string,
    text: string,
    // O "Experimente"; vazio = sem.
    try-it: string,
    // O comando do "Experimente agora"; vazio = sem botão.
    command: string,
    // Com comando e `try-ready` falso, o botão fica apagado, com `try-hint` ao lado.
    try-ready: bool,
    try-hint: string,
    // O endereço conferido pelo editor; vazio = sem vídeo.
    video: string,
    kind-tag: string,
    kind-new: bool,
    system-tag: string,
    // Há um arquivo de capa: a linha pede a capa quando nasce.
    has-file: bool,
    // A capa de animação toca com um clique (nunca com "Reduzir movimento").
    animated: bool,
    has-cover: bool,
    cover: image,
}

// Um cartão da faixa de destaques.
export struct NewsCardData {
    index: int,
    label: string,
    has-file: bool,
    video: string,
    has-cover: bool,
    cover: image,
}

export struct NewsFilterData {
    label: string,
}

export global NewsUi {
    in-out property <bool> show;
    in property <string> title;
    in property <string> subtitle;
    // Depois de atualizar: o botão "Ver todas as versões".
    in property <bool> more;
    // Sem nenhuma nota: "Ainda não há notas desta versão."; vazio = há notas.
    in property <string> empty;
    // A busca sem resultado: "Nenhuma novidade com “…”."; vazio = há resultado.
    in property <string> no-results;
    in property <[NewsFilterData]> filters;
    in property <int> filter;
    in-out property <string> query;
    in property <[NewsEntryData]> entries;
    in property <[NewsCardData]> highlights;
    in property <bool> show-highlights;
    // Muda a cada troca de filtro ou de busca: a lista volta ao começo.
    in property <int> generation;
    // O quadro da animação que toca e o item dela (-1 = nenhum): toca na própria capa.
    in property <image> frame;
    in property <int> playing: -1;
    // Um cartão de destaque pede para a lista rolar até este item; a página atende e volta a -1.
    in-out property <int> jump: -1;
    // A última linha a que um cartão de destaque levou (-1 = nenhuma).
    out property <int> arrived: -1;

    callback search(string);
    callback filter-chosen(int);
    callback all-versions();
    // Um clique numa capa de animação: toca ou para.
    callback cover-clicked(int);
    // A linha ou o cartão nasceu: o Rust traz a capa.
    callback cover-requested(int);
    // Um clique numa capa de vídeo ou em "Assistir ao vídeo": abre no navegador.
    callback open-video(string);
    // A lista rolou: a animação para (spec PV, regra 9).
    callback scrolled();
    // A página fechou: o Rust solta as capas da memória (NV-B17).
    callback released();

    public function close() {
        show = false;
        released();
    }

    // Para a lista marcar aonde um cartão de destaque levou.
    public function mark-arrived(index: int) {
        arrived = index;
    }
}
