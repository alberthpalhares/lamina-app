// Os ícones da interface (spec DF, regra 7): um só desenho, o do Lucide (licença ISC em
// icons/lucide/LICENSE), traço 2 em 24×24, pintados pelo token com `colorize`. O "1:1" é desenho
// nosso no mesmo traço (icons/zr/um-para-um.svg).

export global Icons {
    out property <image> home: @image-url("../icons/lucide/house.svg");
    out property <image> panel-right: @image-url("../icons/lucide/panel-right.svg");
    out property <image> panel-right-close: @image-url("../icons/lucide/panel-right-close.svg");
    out property <image> strips: @image-url("../icons/lucide/panel-bottom.svg");
    out property <image> strips-closed: @image-url("../icons/lucide/panel-bottom-close.svg");
    out property <image> export: @image-url("../icons/lucide/download.svg");
    out property <image> open: @image-url("../icons/lucide/folder-open.svg");
    out property <image> save: @image-url("../icons/lucide/save.svg");
    out property <image> undo: @image-url("../icons/lucide/undo-2.svg");
    out property <image> redo: @image-url("../icons/lucide/redo-2.svg");
    out property <image> plus: @image-url("../icons/lucide/plus.svg");
    out property <image> minus: @image-url("../icons/lucide/minus.svg");
    out property <image> close: @image-url("../icons/lucide/x.svg");
    out property <image> check: @image-url("../icons/lucide/check.svg");
    out property <image> star: @image-url("../icons/lucide/star.svg");
    out property <image> pin: @image-url("../icons/lucide/pin.svg");
    out property <image> pin-filled: @image-url("../icons/lucide/pin-cheio.svg");
    out property <image> move: @image-url("../icons/lucide/move.svg");
    out property <image> grip: @image-url("../icons/lucide/grip-vertical.svg");
    out property <image> chevron-down: @image-url("../icons/lucide/chevron-down.svg");
    out property <image> chevron-right: @image-url("../icons/lucide/chevron-right.svg");
    out property <image> chevron-left: @image-url("../icons/lucide/chevron-left.svg");
    out property <image> pointer: @image-url("../icons/lucide/mouse-pointer-2.svg");
    out property <image> frame: @image-url("../icons/lucide/image.svg");
    out property <image> image-plus: @image-url("../icons/lucide/image-plus.svg");
    out property <image> text: @image-url("../icons/lucide/type.svg");
    out property <image> hand: @image-url("../icons/lucide/hand.svg");
    out property <image> zoom: @image-url("../icons/lucide/zoom-in.svg");
    out property <image> zoom-out: @image-url("../icons/lucide/zoom-out.svg");
    out property <image> search: @image-url("../icons/lucide/search.svg");
    out property <image> fit: @image-url("../icons/lucide/scan.svg");
    out property <image> mirror: @image-url("../icons/lucide/flip-horizontal.svg");
    out property <image> pencil: @image-url("../icons/lucide/pencil.svg");
    out property <image> layouts: @image-url("../icons/lucide/layout-template.svg");
    out property <image> lock: @image-url("../icons/lucide/lock.svg");
    out property <image> lock-open: @image-url("../icons/lucide/lock-open.svg");
    out property <image> detach: @image-url("../icons/lucide/external-link.svg");
    out property <image> magnet: @image-url("../icons/lucide/magnet.svg");
    out property <image> lasso: @image-url("../icons/lucide/lasso-select.svg");
    out property <image> align-left: @image-url("../icons/lucide/align-start-vertical.svg");
    out property <image> align-center: @image-url("../icons/lucide/align-center-vertical.svg");
    out property <image> align-right: @image-url("../icons/lucide/align-end-vertical.svg");
    out property <image> align-top: @image-url("../icons/lucide/align-start-horizontal.svg");
    out property <image> align-middle: @image-url("../icons/lucide/align-center-horizontal.svg");
    out property <image> align-bottom: @image-url("../icons/lucide/align-end-horizontal.svg");
    out property <image> distribute-horizontal: @image-url("../icons/lucide/align-horizontal-distribute-center.svg");
    out property <image> distribute-vertical: @image-url("../icons/lucide/align-vertical-distribute-center.svg");
    out property <image> equal-height: @image-url("../icons/lucide/stretch-vertical.svg");
    out property <image> equal-width: @image-url("../icons/lucide/stretch-horizontal.svg");
    out property <image> equal-size: @image-url("../icons/lucide/scaling.svg");
    out property <image> rotate-left: @image-url("../icons/lucide/rotate-ccw.svg");
    out property <image> rotate-right: @image-url("../icons/lucide/rotate-cw.svg");
    out property <image> info: @image-url("../icons/lucide/info.svg");
    out property <image> warning: @image-url("../icons/lucide/triangle-alert.svg");
    out property <image> error: @image-url("../icons/lucide/circle-alert.svg");
    out property <image> more: @image-url("../icons/lucide/ellipsis.svg");
    out property <image> actual-size: @image-url("../icons/zr/um-para-um.svg");
}
