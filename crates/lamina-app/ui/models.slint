// Modelos do fotógrafo (spec MD): o nome ao salvar a lâmina como modelo e a lista "Meus modelos"
// (renomear, apagar). Só desenho: as decisões são do editor.

import { LineEdit } from "std-widgets.slint";
import { Theme, Space } from "theme.slint";
import { Icons } from "icons.slint";
import { Dialog, DialogSize, DialogFooter, DialogButton, FirstLineEdit, PickList, EmptyState } from "widgets.slint";

export global ModelUi {
    in-out property <bool> show-name;
    in-out property <string> name;
    in property <string> name-message;
    in-out property <bool> show-list;
    in property <[string]> models;
    in-out property <int> list-selected: -1;
    in-out property <string> list-name;
    in property <string> list-message;
    callback name-save();
    callback list-rename();
    callback list-delete();
    callback closed();
}

// Lâmina → Salvar como modelo…
export component ModelNameDialog inherits Dialog {
    title: "Salvar como modelo";
    child-focus: true;
    dismissed => { ModelUi.show-name = false; ModelUi.closed(); }
    FirstLineEdit {
        text <=> ModelUi.name;
        placeholder-text: "ex.: Abertura com título";
        accepted => { ModelUi.name-save(); }
    }
    if ModelUi.name-message != "": Text { text: ModelUi.name-message; color: Theme.warning; wrap: word-wrap; }
    DialogFooter {
        DialogButton { text: "Cancelar"; clicked => { ModelUi.show-name = false; ModelUi.closed(); } }
        DialogButton { text: "Salvar"; primary: true; clicked => { ModelUi.name-save(); } }
    }
}

// Lâmina → Meus modelos… Sem nada salvo, diz o que fazer; a linha de renomear só aparece com um
// modelo escolhido (spec DD, regra 24).
export component ModelsDialog inherits Dialog {
    title: "Meus modelos";
    size: DialogSize.form;
    child-focus: true;
    dismissed => { ModelUi.show-list = false; ModelUi.closed(); }
    if ModelUi.models.length == 0: EmptyState {
        icon: Icons.layouts;
        text: "Nenhum modelo salvo.\nMonte uma lâmina e use Lâmina → Salvar como modelo…";
    }
    if ModelUi.models.length > 0: Text {
        text: "Os modelos aparecem no painel de layouts quando as fotos casam com eles.";
        color: Theme.text-2;
        wrap: word-wrap;
    }
    if ModelUi.models.length > 0: PickList {
        label: "Meus modelos";
        items: ModelUi.models;
        selected <=> ModelUi.list-selected;
        picked(name) => { ModelUi.list-name = name; }
    }
    if ModelUi.list-selected >= 0: HorizontalLayout {
        spacing: Space.s2;
        vertical-stretch: 0;
        LineEdit { text <=> ModelUi.list-name; accepted => { ModelUi.list-rename(); } }
        DialogButton { text: "Renomear"; clicked => { ModelUi.list-rename(); } }
        DialogButton { text: "Apagar"; danger: true; clicked => { ModelUi.list-delete(); } }
    }
    if ModelUi.list-message != "": Text { text: ModelUi.list-message; color: Theme.warning; wrap: word-wrap; }
    DialogFooter {
        DialogButton { text: "Fechar"; primary: true; takes-focus: true; clicked => { ModelUi.show-list = false; ModelUi.closed(); } }
    }
}
