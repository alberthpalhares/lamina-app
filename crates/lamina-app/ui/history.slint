// Painel de histórico (spec HI): o começo e um passo por linha; o atual destacado, os desfeitos
// apagados e o marcador "salvo". Clique leva o álbum àquele passo. Pelo teclado (spec DD, regra 28),
// a lista é uma parada de Tab: ↑ ↓ andam sem mudar o álbum, e Enter leva ao passo marcado.

import { ListView } from "std-widgets.slint";
import { Theme, Type, Radius, Space } from "theme.slint";
import { FocusRing } from "widgets.slint";

export struct HistoryItem {
    label: string,
    undone: bool,
    saved: bool,
}

export component HistoryPanel inherits VerticalLayout {
    // A linha 0 é o começo ("Álbum aberto"); a linha k é o passo k.
    in property <[HistoryItem]> items;
    in property <int> position;
    callback go(int);
    property <length> row-height: 30px;
    // A linha marcada pelo teclado; começa no passo atual.
    property <int> mark;
    function step(delta: int) {
        root.mark = max(0, min(root.items.length - 1, root.mark + delta));
        steps.content-y = max(min(steps.content-y, -root.mark * root.row-height), steps.visible-height - (root.mark + 1) * root.row-height);
    }
    spacing: Space.s1;

    Text {
        text: "Clique num passo para voltar a ele. Os apagados ainda podem ser refeitos.";
        color: Theme.text-2;
        font-size: Type.small;
        wrap: word-wrap;
    }
    Rectangle {
        vertical-stretch: 1;
        accessible-role: AccessibleRole.list;
        accessible-label: "Histórico";
        steps := ListView {
            for item[i] in root.items: Rectangle {
                height: root.row-height;
                border-radius: Radius.small;
                background: i == root.position ? Theme.press : touch.has-hover ? Theme.hover : transparent;
                HorizontalLayout {
                    padding-left: Space.s2;
                    padding-right: Space.s2;
                    spacing: Space.s1;
                    Text {
                        text: item.label;
                        color: item.undone ? Theme.text-disabled : i == root.position ? Theme.text-strong : Theme.text;
                        font-weight: i == root.position ? Type.semibold : Type.regular;
                        font-size: Type.small;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    if item.saved: Text {
                        text: "salvo";
                        color: Theme.warning;
                        font-size: Type.caption;
                        vertical-alignment: center;
                    }
                }
                touch := TouchArea { clicked => { root.go(i); } }
                FocusRing {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: parent.height;
                    shown: keys.has-focus && i == root.mark;
                }
            }
        }
        keys := FocusScope {
            x: 0;
            width: 0;
            changed has-focus => {
                if (self.has-focus) {
                    root.mark = root.position;
                }
            }
            key-pressed(e) => {
                if (e.text == Key.UpArrow) {
                    root.step(-1);
                    return accept;
                }
                if (e.text == Key.DownArrow) {
                    root.step(1);
                    return accept;
                }
                if (e.text == Key.Return) {
                    root.go(root.mark);
                    return accept;
                }
                reject
            }
        }
    }
}
