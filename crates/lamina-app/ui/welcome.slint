// A tela inicial (specs PC, TI e DI): aparece sempre que não há álbum aberto. Na primeira vez, o
// convite para o novo álbum, com uma lâmina real do exemplo; depois, o álbum em andamento grande e
// os outros em cartões. Os botões de quem já usa ficam na barra de cima (`topbar.slint`).

import { LineEdit, ScrollView } from "std-widgets.slint";
import { Theme, Fixed, Type, Space } from "theme.slint";
import { Icons } from "icons.slint";
import { DialogButton, EmptyState, FocusRing, Panel, SectionTitle, Shade } from "widgets.slint";
import { BlankAlbum, CardGrid, PinButton, RecentsUi, RecentCard, RecentItem } from "welcome_cards.slint";

export { RecentsUi, RecentCard, RecentItem } from "welcome_cards.slint";

// A imagem do álbum, grande, como ele fica aberto: a sombra da dobra é só desta tela e nunca entra
// no arquivo da imagem (specs DJ, regra 1, e DI, regra 16).
component OpenAlbum inherits Rectangle {
    in property <image> source;
    in property <bool> fold;
    in property <string> label;
    callback clicked();
    // O tamanho da imagem dentro da área, para a sombra não passar da lâmina num álbum que não é 2:1.
    property <float> aspect: root.source.height > 0 ? root.source.width / root.source.height : 2;
    property <length> shown-width: min(root.width, root.height * root.aspect);
    property <length> shown-height: min(root.height, root.width / root.aspect);
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    background: Theme.g2;
    Image { accessible-role: none; source: root.source; image-fit: contain; width: parent.width; height: parent.height; }
    if root.fold: Rectangle {
        accessible-role: none;
        // Em pixels inteiros: com fração, o desenho por software deixa um fio no meio do degradê.
        x: floor((parent.width - self.width) / 2 / 1px) * 1px;
        y: (parent.height - self.height) / 2;
        width: 2 * round(root.shown-width * 0.035 / 1px) * 1px;
        height: root.shown-height;
        background: @linear-gradient(90deg, Fixed.ink.transparentize(1) 0%, Fixed.ink.transparentize(0.9) 50%, Fixed.ink.transparentize(1) 100%);
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    focus := FocusScope {
        x: 0;
        width: 0;
        key-pressed(e) => {
            if (e.text == Key.Space || e.text == Key.Return) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    FocusRing { shown: focus.has-focus; x: -3px; y: -3px; width: parent.width + 6px; height: parent.height + 6px; }
}

// A primeira vez: o novo álbum é o principal; o exemplo fica ao lado, sem destaque (spec DI).
component FirstUse inherits VerticalLayout {
    callback command(string);
    alignment: center;
    padding: Space.s5;
    spacing: Space.s5;
    property <length> image-width: min(min(root.width * 0.52, (root.height - 140px) * 1.4), 960px);
    property <image> picture: @image-url("../icons/exemplo-primeira-lamina.jpg");
    HorizontalLayout {
        alignment: center;
        spacing: Space.s6;
        OpenAlbum {
            width: root.image-width;
            height: root.image-width * root.picture.height / max(1, root.picture.width);
            source: root.picture;
            fold: true;
            label: "Abrir o álbum de exemplo";
            clicked => { root.command("arquivo.exemplo"); }
        }
        VerticalLayout {
            alignment: center;
            spacing: Space.s2;
            max-width: 400px;
            min-width: 240px;
            Text { text: "DIAGRAMAÇÃO DE ÁLBUNS DE FOTOS"; color: Theme.text-2; font-size: Type.caption; font-weight: Type.semibold; letter-spacing: Type.caps-spacing; wrap: word-wrap; }
            Text { text: "Comece seu primeiro álbum"; color: Theme.text; font-size: Type.display; font-weight: Type.semibold; wrap: word-wrap; }
            Text { text: "Escolha a pasta das fotos e o Lamina monta as lâminas. Depois, é só ajustar o que quiser."; color: Theme.text-2; font-size: Type.body; wrap: word-wrap; }
            HorizontalLayout {
                alignment: start;
                padding-top: Space.s2;
                spacing: Space.s2;
                DialogButton { text: "Novo álbum…"; primary: true; clicked => { root.command("arquivo.novo"); } }
                DialogButton { text: "Álbum de exemplo"; clicked => { root.command("arquivo.exemplo"); } }
            }
        }
    }
    HorizontalLayout {
        alignment: center;
        spacing: Space.s4;
        for step[i] in [
            { title: "Escolha a pasta das fotos", detail: "As fotos ficam onde estão." },
            { title: "O Lamina monta as lâminas", detail: "Ele agrupa por momento e diagrama." },
            { title: "Ajuste e exporte", detail: "Mexa no que quiser e mande para a gráfica." },
        ]: VerticalLayout {
            width: (root.image-width + 400px + Space.s6 - 2 * Space.s4) / 3;
            spacing: 2px;
            Text { text: i + 1; color: Theme.text-3; font-size: Type.caption; font-weight: Type.semibold; }
            Text { text: step.title; color: Theme.text; font-size: Type.body; font-weight: Type.semibold; wrap: word-wrap; }
            Text { text: step.detail; color: Theme.text-2; font-size: Type.small; wrap: word-wrap; }
        }
    }
}

// O álbum em andamento: a imagem grande e, ao lado, onde o fotógrafo parou (spec DI).
component Resume inherits HorizontalLayout {
    in property <length> image-height;
    property <RecentCard> data: RecentsUi.resume;
    // Na proporção do álbum, até 2,4 vezes a altura: a lâmina encosta na margem da página.
    property <float> aspect: root.data.has-thumb && root.data.thumb.height > 0 ? root.data.thumb.width / root.data.thumb.height : 2;
    spacing: Space.s6;
    Rectangle {
        width: root.image-height * min(root.aspect, 2.4);
        height: root.image-height;
        if root.data.has-thumb: OpenAlbum {
            source: root.data.thumb;
            fold: root.data.fold;
            label: root.data.button + ": " + root.data.name;
            clicked => { RecentsUi.open(root.data.index); }
        }
        if !root.data.has-thumb: BlankAlbum { name: root.data.name; blank: root.data.blank; background: Theme.g2; }
    }
    VerticalLayout {
        alignment: center;
        spacing: Space.s2;
        horizontal-stretch: 1;
        Text { text: "CONTINUAR"; color: Theme.text-2; font-size: Type.caption; font-weight: Type.semibold; letter-spacing: Type.caps-spacing; }
        Text { text: root.data.name; color: Theme.text; font-size: Type.heading; font-weight: Type.semibold; wrap: word-wrap; overflow: elide; max-height: 2.8 * Type.heading; }
        if root.data.sentence != "": Text { text: root.data.sentence; color: Theme.text; font-size: Type.title; wrap: word-wrap; }
        Text { text: root.data.meta; color: Theme.text-2; font-size: Type.small; wrap: word-wrap; }
        Text { text: root.data.folder; color: Theme.text-3; font-size: Type.small; overflow: elide; }
        HorizontalLayout {
            alignment: start;
            padding-top: Space.s2;
            spacing: Space.s2;
            DialogButton { text: root.data.button; primary: true; clicked => { RecentsUi.open(root.data.index); } }
            VerticalLayout {
                alignment: center;
                PinButton { pinned: root.data.pinned; clicked => { RecentsUi.pin(root.data.index); } }
            }
        }
    }
}

// Quem já usa: o álbum em andamento e, embaixo, os outros; a página toda rola.
component Returning inherits ScrollView {
    // A área pede a altura que os cartões precisam; a janela dá o que sobra e ela rola.
    HorizontalLayout {
        alignment: center;
        VerticalLayout {
            width: min(root.visible-width - 2 * Space.s5, 1456px);
            alignment: start;
            padding-top: Space.s5;
            padding-bottom: Space.s5;
            spacing: Space.s5;
            if RecentsUi.has-resume: Resume {
                image-height: RecentsUi.resume-height(root.height + 44px);
            }
            VerticalLayout {
                spacing: Space.s3;
                HorizontalLayout {
                    spacing: Space.s4;
                    SectionTitle {
                        horizontal-stretch: 1;
                        text: RecentsUi.has-resume ? "OUTROS ÁLBUNS" : "ÁLBUNS";
                    }
                    if RecentsUi.show-search: LineEdit {
                        width: 280px;
                        placeholder-text: "Buscar pelo nome ou pela pasta";
                        text <=> RecentsUi.query;
                        edited(text) => { RecentsUi.search(text); }
                    }
                }
                if RecentsUi.no-results == "": CardGrid { cards: RecentsUi.cards; }
                if RecentsUi.no-results != "": EmptyState {
                    padding-top: Space.s6;
                    icon: Icons.search;
                    text: RecentsUi.no-results;
                    action: "Limpar a busca";
                    act => {
                        RecentsUi.query = "";
                        RecentsUi.search("");
                    }
                }
            }
        }
    }
}

export component WelcomeScreen inherits Rectangle {
    callback command(string);
    if !RecentsUi.has-recents: FirstUse {
        width: parent.width;
        height: parent.height;
        command(name) => { root.command(name); }
    }
    if RecentsUi.has-recents: Returning {
        width: parent.width;
        height: parent.height;
    }
}

// "Limpar recentes não fixados…" pede confirmação (regra 7).
export component ClearRecentsDialog inherits Shade {
    callback closed();
    Panel {
        width: 440px;
        height: 170px;
        VerticalLayout {
            padding: Space.s5;
            spacing: Space.s3;
            Text { text: "Limpar os álbuns recentes?"; font-size: Type.heading; font-weight: Type.semibold; color: Theme.text; }
            Text { text: "Os fixados ficam na lista. Os arquivos dos álbuns não são apagados."; color: Theme.text-2; wrap: word-wrap; }
            HorizontalLayout {
                alignment: end;
                spacing: Space.s2;
                DialogButton { text: "Cancelar"; clicked => { RecentsUi.show-clear = false; root.closed(); } }
                DialogButton { text: "Limpar"; primary: true; clicked => { RecentsUi.show-clear = false; RecentsUi.clear-confirmed(); root.closed(); } }
            }
        }
    }
}
