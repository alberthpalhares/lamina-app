// Tela de boas-vindas (spec PC) e tela inicial com os álbuns recentes (spec TI): aparece sempre
// que não há álbum aberto. Sem recentes, é a boas-vindas da PC sem mudança. Cada botão chama um
// comando do registro; as decisões (ordem, busca, quais sumiram) ficam no Rust.

import { LineEdit, ScrollView } from "std-widgets.slint";
import { Theme, Type, Radius } from "theme.slint";
import { Dialog, DialogFooter, DialogButton } from "widgets.slint";

export struct RecentCard {
    index: int,
    name: string,
    folder: string,
    when: string,
    counts: string,
    pinned: bool,
    missing: bool,
    thumb: image,
    has-thumb: bool,
    blank: bool,
}

export struct RecentItem {
    index: int,
    label: string,
    enabled: bool,
}

// A lista vem do Rust (`src/recents.rs`); `index` é a posição na lista de recentes.
export global RecentsUi {
    in property <bool> has-recents;
    in property <[RecentCard]> pinned;
    in property <[RecentCard]> others;
    in property <[RecentItem]> menu;
    in property <bool> show-search;
    in-out property <string> query;
    in-out property <bool> show-clear;
    callback open(int);
    callback pin(int);
    callback browse(int);
    callback forget(int);
    callback search(string);
    callback clear-confirmed();
}

// O desenho do álbum sem miniatura: duas páginas abertas com o nome. É o álbum em branco da BR
// (sem lâminas) e também o desenho neutro quando a miniatura falhou (spec TI, regra 5).
component BlankAlbum inherits Rectangle {
    in property <string> name;
    in property <bool> blank;
    Rectangle {
        width: 152px;
        height: 80px;
        background: Theme.g5;
        border-width: 1px;
        border-color: Theme.g7;
        border-radius: Radius.hair;
        // A dobra entre as duas páginas, interrompida no meio para não cortar o nome.
        Rectangle { x: (parent.width - 1px) / 2; y: 0; width: 1px; height: 16px; background: Theme.g7; }
        Rectangle { x: (parent.width - 1px) / 2; y: parent.height - 16px; width: 1px; height: 16px; background: Theme.g7; }
        VerticalLayout {
            padding: 8px;
            alignment: center;
            spacing: 2px;
            Text { text: root.name; color: Theme.text; font-size: Type.small; font-weight: Type.semibold; horizontal-alignment: center; overflow: elide; }
            if root.blank: Text { text: "Álbum em branco"; color: Theme.text-2; font-size: Type.caption; horizontal-alignment: center; }
        }
    }
}

component Card inherits Rectangle {
    accessible-role: button;
    accessible-label: root.data.name;
    accessible-action-default => { RecentsUi.open(root.data.index); }
    in property <RecentCard> data;
    width: 200px;
    height: 210px;
    border-radius: Radius.medium;
    background: open.has-hover && !root.data.missing ? Theme.g6 : Theme.panel;
    open := TouchArea {
        enabled: !root.data.missing;
        mouse-cursor: root.data.missing ? default : pointer;
        clicked => { RecentsUi.open(root.data.index); }
    }
    VerticalLayout {
        padding: 10px;
        spacing: 4px;
        Rectangle {
            height: 112px;
            background: Theme.g3;
            border-radius: Radius.small;
            opacity: root.data.missing ? 0.35 : 1;
            if root.data.has-thumb: Image { accessible-role: none; source: root.data.thumb; image-fit: contain; width: parent.width; height: parent.height; }
            if !root.data.has-thumb: BlankAlbum { name: root.data.name; blank: root.data.blank; }
        }
        HorizontalLayout {
            spacing: 4px;
            Text { text: root.data.name; color: root.data.missing ? Theme.text-2 : Theme.text; font-weight: Type.semibold; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
            Rectangle {
                width: 22px;
                height: 22px;
                border-radius: Radius.small;
                background: pin.has-hover ? Theme.hover : transparent;
                // O alfinete: cheio quando fixado.
                Path {
                    width: 14px;
                    height: 14px;
                    viewbox-width: 16;
                    viewbox-height: 16;
                    commands: "M 5 1 L 11 1 L 10 6 L 13 9 L 3 9 L 6 6 Z M 8 9 L 8 15";
                    stroke: root.data.pinned ? Theme.text-strong : Theme.text-2;
                    stroke-width: 1.5px;
                    fill: root.data.pinned ? Theme.text-strong : transparent;
                    opacity: root.data.pinned || pin.has-hover ? 1 : 0.5;
                }
                pin := TouchArea { clicked => { RecentsUi.pin(root.data.index); } }
            }
        }
        if !root.data.missing: Text { text: root.data.when; color: Theme.text-2; font-size: Type.small; }
        if !root.data.missing: Text { text: root.data.counts; color: Theme.text-2; font-size: Type.small; }
        if root.data.missing: Text { text: "Não encontrado"; color: Theme.warning; font-size: Type.small; }
        if root.data.missing: HorizontalLayout {
            spacing: 6px;
            DialogButton { text: "Procurar…"; clicked => { RecentsUi.browse(root.data.index); } }
            DialogButton { text: "Tirar da lista"; clicked => { RecentsUi.forget(root.data.index); } }
        }
    }
}

// Os cartões em linhas que quebram conforme a largura.
component CardGrid inherits Rectangle {
    in property <[RecentCard]> cards;
    in property <length> columns-width;
    property <int> columns: max(1, floor((root.columns-width + 12px) / 212px));
    height: ceil(root.cards.length / root.columns) * 222px;
    for card[i] in root.cards: Card {
        x: mod(i, root.columns) * 212px;
        y: floor(i / root.columns) * 222px;
        data: card;
    }
}

component Section inherits Text {
    color: Theme.text-2;
    font-size: Type.small;
    font-weight: Type.semibold;
}

export component WelcomeScreen inherits VerticalLayout {
    callback command(string);
    alignment: RecentsUi.has-recents ? start : center;
    spacing: 16px;
    padding-top: RecentsUi.has-recents ? 24px : 0px;
    Image { accessible-role: none; source: @image-url("../icons/lamina-logo-escuro.svg"); height: 64px; image-fit: contain; }
    Text { text: "Diagramação de álbuns de fotos"; color: Theme.text-2; horizontal-alignment: center; }
    if !RecentsUi.has-recents: HorizontalLayout {
        alignment: center;
        DialogButton { text: "Experimentar com o álbum de exemplo"; primary: true; clicked => { root.command("arquivo.exemplo"); } }
    }
    if !RecentsUi.has-recents: HorizontalLayout {
        alignment: center;
        spacing: 12px;
        DialogButton { text: "Novo álbum com minhas fotos…"; clicked => { root.command("arquivo.novo"); } }
        DialogButton { text: "Abrir um álbum…"; clicked => { root.command("arquivo.abrir"); } }
    }
    // Com recentes, o novo álbum passa a principal e o exemplo fica ao lado (TI-B14).
    if RecentsUi.has-recents: HorizontalLayout {
        alignment: center;
        spacing: 12px;
        DialogButton { text: "Novo álbum com minhas fotos…"; primary: true; clicked => { root.command("arquivo.novo"); } }
        DialogButton { text: "Experimentar com o álbum de exemplo"; clicked => { root.command("arquivo.exemplo"); } }
        DialogButton { text: "Abrir um álbum…"; clicked => { root.command("arquivo.abrir"); } }
    }
    if RecentsUi.has-recents: HorizontalLayout {
        alignment: center;
        vertical-stretch: 1;
        list := VerticalLayout {
            width: min(root.width - 48px, 1084px);
            spacing: 10px;
            if RecentsUi.show-search: LineEdit {
                placeholder-text: "Buscar pelo nome ou pela pasta";
                text <=> RecentsUi.query;
                edited(text) => { RecentsUi.search(text); }
            }
            // A área pede a altura dos cartões; sem isso, com o topo alinhado (`start`), ela ficava
            // com a altura mínima da ScrollView e cortava o cartão logo abaixo do título. Quando
            // não cabe, a janela dá o que sobra e a área rola (correção TI de 2026-10-22).
            ScrollView {
                vertical-stretch: 1;
                min-height: 0px;
                preferred-height: shelf.preferred-height;
                shelf := VerticalLayout {
                    spacing: 10px;
                    if RecentsUi.pinned.length > 0: Section { text: "FIXADOS"; }
                    if RecentsUi.pinned.length > 0: CardGrid { cards: RecentsUi.pinned; columns-width: list.width - 16px; }
                    if RecentsUi.others.length > 0: Section { text: "RECENTES"; }
                    if RecentsUi.others.length > 0: CardGrid { cards: RecentsUi.others; columns-width: list.width - 16px; }
                }
            }
        }
    }
    HorizontalLayout {
        alignment: center;
        padding-top: 8px;
        padding-bottom: RecentsUi.has-recents ? 12px : 0px;
        Text {
            text: "Enviar sugestão ou problema";
            color: link.has-hover ? Theme.text-strong : Theme.link;
            font-size: Type.small;
            link := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.command("ajuda.enviar-sugestao"); }
            }
        }
    }
}

// "Limpar recentes não fixados…" pede confirmação (regra 7).
export component ClearRecentsDialog inherits Dialog {
    callback closed();
    title: "Limpar os álbuns recentes?";
    child-focus: true;
    dismissed => { RecentsUi.show-clear = false; root.closed(); }
    Text { text: "Os fixados ficam na lista. Os arquivos dos álbuns não são apagados."; color: Theme.text-2; wrap: word-wrap; }
    DialogFooter {
        DialogButton { text: "Cancelar"; takes-focus: true; clicked => { RecentsUi.show-clear = false; root.closed(); } }
        DialogButton { text: "Limpar"; danger: true; clicked => { RecentsUi.show-clear = false; RecentsUi.clear-confirmed(); root.closed(); } }
    }
}
