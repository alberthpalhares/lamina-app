// Ajuda → "Atalhos do teclado…" (spec AT): a lista de atalhos e gestos, com busca. Só desenho: a
// lista, a busca e o texto das teclas saem do `lamina-editor` (`shortcuts::sheet`).

import { ScrollView } from "std-widgets.slint";
import { Theme, Type, Radius, Space, Line } from "theme.slint";
import { Dialog, DialogSize, DialogFooter, DialogButton, FirstLineEdit, SectionTitle } from "widgets.slint";

// Uma linha: o que faz e as teclas (o principal e os alternativos) ou, num gesto, como fazer.
export struct ShortcutRow {
    does: string,
    keys: [string],
    gesture: bool,
}

export struct ShortcutGroup {
    title: string,
    rows: [ShortcutRow],
}

export global ShortcutsUi {
    in-out property <bool> show;
    in-out property <string> query;
    // A lista em duas colunas (janela larga) e numa só (estreita).
    in property <[ShortcutGroup]> left;
    in property <[ShortcutGroup]> right;
    in property <[ShortcutGroup]> all;
    // Busca sem resultado: a frase e a dica embaixo; vazio = há resultado.
    in property <string> empty;
    in property <string> hint;
    callback search(string);
}

// Uma tecla desenhada como teclinha.
component Keycap inherits Rectangle {
    in property <string> text;
    width: max(Space.s5, label.preferred-width + Space.s3);
    height: Space.s5;
    border-radius: Radius.small;
    border-width: Line.thin;
    border-color: Theme.line-strong;
    background: Theme.hover;
    label := Text {
        text: root.text;
        color: Theme.text;
        font-size: Type.small;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component GroupView inherits VerticalLayout {
    in property <ShortcutGroup> group;
    spacing: Space.s2;
    padding-bottom: Space.s4;
    SectionTitle { text: root.group.title; }
    for row in root.group.rows: HorizontalLayout {
        spacing: Space.s3;
        Text {
            text: row.does;
            color: Theme.text;
            font-size: Type.body;
            wrap: word-wrap;
            horizontal-stretch: 1;
            vertical-alignment: center;
        }
        if row.gesture: Text {
            text: row.keys[0];
            color: Theme.text-2;
            font-size: Type.small;
            wrap: word-wrap;
            horizontal-stretch: 2;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        if !row.gesture: HorizontalLayout {
            spacing: Space.s1;
            alignment: end;
            for key[i] in row.keys: HorizontalLayout {
                spacing: Space.s1;
                if i > 0: Text { text: "ou"; color: Theme.text-2; font-size: Type.small; vertical-alignment: center; }
                Keycap { text: key; }
            }
        }
    }
}

export component ShortcutsDialog inherits Dialog {
    callback closed();
    title: "Atalhos do teclado e do mouse";
    size: min(root.width - DialogSize.margin, 980px);
    fixed-height: min(root.height - DialogSize.margin, 760px);
    child-focus: true;
    // Um clique fora da janela fecha (regra 8).
    closes-outside: true;
    dismissed => {
        ShortcutsUi.show = false;
        root.closed();
    }
    // O cursor já começa na busca (regra 8).
    FirstLineEdit {
        placeholder-text: "Buscar: “lâmina”, “salvar” ou “ctrl+z”";
        text <=> ShortcutsUi.query;
        edited(text) => { ShortcutsUi.search(text); }
    }
    if ShortcutsUi.empty != "": VerticalLayout {
        spacing: Space.s1;
        Text { text: ShortcutsUi.empty; color: Theme.text; wrap: word-wrap; }
        Text { text: ShortcutsUi.hint; color: Theme.text-2; wrap: word-wrap; }
    }
    ScrollView {
        vertical-stretch: 1;
        // Duas colunas; numa janela estreita, uma só (seção 4).
        if root.width >= 760px: HorizontalLayout {
            spacing: Space.s6;
            padding-right: Space.s3;
            VerticalLayout {
                alignment: start;
                horizontal-stretch: 1;
                for g in ShortcutsUi.left: GroupView { group: g; }
            }
            VerticalLayout {
                alignment: start;
                horizontal-stretch: 1;
                for g in ShortcutsUi.right: GroupView { group: g; }
            }
        }
        if root.width < 760px: VerticalLayout {
            alignment: start;
            padding-right: Space.s3;
            for g in ShortcutsUi.all: GroupView { group: g; }
        }
    }
    DialogFooter {
        DialogButton {
            text: "Fechar";
            clicked => {
                ShortcutsUi.show = false;
                root.closed();
            }
        }
    }
}
