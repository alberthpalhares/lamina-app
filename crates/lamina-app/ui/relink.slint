// Reencontrar fotos que mudaram de lugar (spec RF): a janela que diz qual pasta sumiu e o que
// fazer, com "Mostrar onde está…" em cada pasta. Os textos e as decisões vêm do editor.

import { Theme, Type, Space } from "theme.slint";
import { Dialog, DialogSize, DialogBody, DialogFooter, DialogButton } from "widgets.slint";

export struct RelinkRowUi {
    // "Casamento".
    name: string,
    // "8 fotos · estava em D:\Fotos" ou "… · no disco E:, que não está conectado".
    detail: string,
    unplugged: bool,
}

export global RelinkUi {
    in-out property <bool> show;
    in property <string> title;
    in property <string> intro;
    in property <string> hint;
    // A frase do disco externo, quando alguma pasta está num disco desconectado (regra 5).
    in property <string> plug-in;
    in property <[RelinkRowUi]> rows;
    in property <string> more;
    // O resultado da última procura ("Nenhuma das 8 fotos…"), dentro da janela (seção 6).
    in property <string> status;
    // A pergunta do arquivo com outro conteúdo (regra 4): não vazia = mostrar.
    in property <string> question;
    // O que a descoberta achou, uma frase por linha (regra 11): não vazio = "Usar o lugar novo".
    in property <string> discovered;
    callback pick(int);
    callback retry();
    callback later();
    callback answer(bool);
    callback use-new();
}

export component RelinkDialog inherits Dialog {
    callback closed();
    title: RelinkUi.question != "" ? "Localizar esta foto" : RelinkUi.title;
    size: DialogSize.form;
    child-focus: true;
    dismissed => {
        if (RelinkUi.question != "") {
            RelinkUi.answer(false);
        } else {
            RelinkUi.show = false;
            RelinkUi.later();
            root.closed();
        }
    }
    if RelinkUi.question != "": Text { text: RelinkUi.question; color: Theme.text-2; wrap: word-wrap; }
    if RelinkUi.question != "": DialogFooter {
        DialogButton { text: "Cancelar"; takes-focus: true; clicked => { RelinkUi.answer(false); } }
        DialogButton { text: "Usar mesmo assim"; primary: true; clicked => { RelinkUi.answer(true); } }
    }
    if RelinkUi.question == "": DialogBody {
        if RelinkUi.discovered != "": Text { text: RelinkUi.discovered; color: Theme.text; font-weight: Type.semibold; wrap: word-wrap; }
        if RelinkUi.discovered != "": HorizontalLayout {
            alignment: start;
            DialogButton { text: "Usar o lugar novo"; primary: true; clicked => { RelinkUi.use-new(); } }
        }
        if RelinkUi.rows.length > 0: Text { text: RelinkUi.intro; color: Theme.text-2; wrap: word-wrap; }
        for row[i] in RelinkUi.rows: HorizontalLayout {
            height: 44px;
            spacing: Space.s3;
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                Text { text: row.name; color: Theme.text; font-weight: Type.semibold; overflow: elide; }
                Text {
                    text: row.detail;
                    color: row.unplugged ? Theme.warning : Theme.text-2;
                    font-size: Type.small;
                    overflow: elide;
                }
            }
            DialogButton {
                text: "Mostrar onde está…";
                accessible-label: "Mostrar onde está a pasta " + row.name;
                takes-focus: i == 0;
                clicked => { RelinkUi.pick(i); }
            }
        }
        if RelinkUi.more != "": Text { text: RelinkUi.more; color: Theme.text-2; font-size: Type.small; }
        if RelinkUi.rows.length > 0: Text { text: RelinkUi.hint; color: Theme.text; wrap: word-wrap; }
        if RelinkUi.plug-in != "": Text { text: RelinkUi.plug-in; color: Theme.warning; wrap: word-wrap; }
        if RelinkUi.status != "": Text { text: RelinkUi.status; color: Theme.warning; wrap: word-wrap; }
    }
    if RelinkUi.question == "": DialogFooter {
        DialogButton { text: "Tentar de novo"; clicked => { RelinkUi.retry(); } }
        DialogButton { text: "Agora não"; clicked => { RelinkUi.show = false; RelinkUi.later(); root.closed(); } }
    }
}
