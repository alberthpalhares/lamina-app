// Limpar as lâminas (spec LL): a pergunta antes de tirar as fotos de todas as lâminas ou de apagar
// todas elas. O texto e o botão vêm do Rust; a decisão é do editor.

import { Theme } from "theme.slint";
import { Dialog, DialogFooter, DialogButton } from "widgets.slint";

export global ClearUi {
    in-out property <bool> show;
    in property <string> title;
    in property <string> message;
    in property <string> action;
    callback confirmed();
}

export component ClearAllDialog inherits Dialog {
    callback closed();
    title: ClearUi.title;
    child-focus: true;
    dismissed => { ClearUi.show = false; root.closed(); }
    Text { text: ClearUi.message; color: Theme.text-2; wrap: word-wrap; }
    DialogFooter {
        DialogButton { text: "Cancelar"; takes-focus: true; clicked => { ClearUi.show = false; root.closed(); } }
        DialogButton { text: ClearUi.action; danger: true; clicked => { ClearUi.show = false; ClearUi.confirmed(); root.closed(); } }
    }
}
