// Novo projeto em três etapas (specs NP e DD): 1, Tamanho; 2, Montagem e aparência; 3, Fotos e
// arquivo. Cabe sem rolar numa janela de 1366 × 668: o que se escolhe à esquerda, o resultado à
// direita. Só desenho: os campos, o resumo, os erros e as prévias vêm do lamina-editor, pelo Rust
// (`src/new_project.rs`). O estado fica num global, como o dos presets.

import { ComboBox, LineEdit, SpinBox } from "std-widgets.slint";
import { NumberField } from "number_field.slint";
import { Theme, Type, Radius, Line, Space } from "theme.slint";
import { Icons } from "icons.slint";
import { Dialog, DialogSize, DialogBody, DialogFooter, DialogGap, DialogButton, CheckRow, FirstLineEdit, FocusStop, PathLabel } from "widgets.slint";
import { NewProjectUi, FormatCard, DrawData } from "new_project_ui.slint";
import { StepOne, SizeSummary, Disclosure } from "new_project_size.slint";
import { ColorSwatch, OtherColor } from "new_project_color.slint";
export { NewProjectUi, FormatCard, DrawData }

component Hint inherits Text {
    color: Theme.text-2;
    font-size: Type.small;
    wrap: word-wrap;
}

// O rótulo de uma linha, na mesma coluna em todas.
component RowLabel inherits Text {
    width: 120px;
    color: Theme.text;
    vertical-alignment: center;
}

// Um cartão de escolha: título e explicação; o escolhido fica marcado.
component Choice inherits Rectangle {
    accessible-role: button;
    accessible-label: root.title;
    accessible-checked: root.chosen;
    accessible-action-default => { root.clicked(); }
    in property <string> title;
    in property <string> text;
    in property <bool> chosen;
    callback clicked();
    horizontal-stretch: 1;
    min-height: 72px;
    border-radius: Radius.medium;
    background: root.chosen ? Theme.accent-soft : (touch.has-hover ? Theme.hover : Theme.strip);
    border-width: root.chosen ? Line.focus : Line.thin;
    border-color: root.chosen ? Theme.accent : Theme.press;
    VerticalLayout {
        padding: Space.s2;
        spacing: Space.s1;
        alignment: start;
        Text { text: root.title; color: Theme.text; font-weight: Type.semibold; }
        Hint { text: root.text; }
    }
    touch := TouchArea { clicked => { root.clicked(); } }
    FocusStop { radius: Radius.medium; activated => { root.clicked(); } }
}

// Etapa 2, opção A do dono: o que a maioria não mexe fica em "Mais opções", recolhido (regra 14).
component StepTwo inherits HorizontalLayout {
    property <bool> more-open;
    spacing: Space.s5;
    VerticalLayout {
        horizontal-stretch: 1;
        spacing: Space.s3;
        alignment: start;
        VerticalLayout {
            spacing: Space.s1;
            // Com `alignment: start`, a largura fixa da caixa não aperta a coluna inteira.
            HorizontalLayout {
                alignment: start;
                CheckRow { text: "As fotos podem atravessar o meio do álbum aberto"; takes-focus: true; checked <=> NewProjectUi.lay-flat; toggled => { NewProjectUi.mount-changed(); } }
            }
            Hint { text: "Para álbuns que abrem planos (lay-flat). Com vinco no meio, deixe desligado."; }
        }
        Text { text: "Quanto o Lamina pode cortar das suas fotos"; color: Theme.text; }
        HorizontalLayout {
            spacing: Space.s2;
            Choice {
                title: "Nada";
                text: "Fotos sempre inteiras.";
                chosen: NewProjectUi.crop == 0;
                clicked => { NewProjectUi.crop = 0; NewProjectUi.mount-changed(); }
            }
            Choice {
                title: "Pouco";
                text: "Corta até 15%, só para encaixar.";
                chosen: NewProjectUi.crop == 1;
                clicked => { NewProjectUi.crop = 1; NewProjectUi.mount-changed(); }
            }
            Choice {
                title: "Livre (recomendado)";
                text: "Corta até 35% para encher a página.";
                chosen: NewProjectUi.crop == 2;
                clicked => { NewProjectUi.crop = 2; NewProjectUi.mount-changed(); }
            }
        }
        if NewProjectUi.mode == 2: Hint { text: "Vale para as próximas sugestões de layout; as lâminas prontas ficam como estão. A aparência de um álbum pronto muda na aba Aparência, ao lado da lâmina."; }
        if NewProjectUi.mode != 2: HorizontalLayout {
            spacing: Space.s1;
            alignment: start;
            RowLabel { text: "Fundo das lâminas"; }
            for c in NewProjectUi.palette: ColorSwatch {
                y: (parent.height - self.height) / 2;
                shade: c.c;
                hex: c.hex;
                current: c.hex == NewProjectUi.background;
                picked => { NewProjectUi.background = c.hex; NewProjectUi.mount-changed(); }
            }
            OtherColor { which: 0; hex <=> NewProjectUi.background; }
        }
        if NewProjectUi.mode != 2: HorizontalLayout {
            spacing: Space.s2;
            alignment: start;
            RowLabel { text: "Borda das fotos"; }
            NumberField { accessible-label: "Espessura da borda, em milímetros"; text <=> NewProjectUi.border; width: 72px; minimum: 0; edited => { NewProjectUi.mount-changed(); } }
            Hint { text: "mm"; vertical-alignment: center; }
            ColorSwatch {
                y: (parent.height - self.height) / 2;
                shade: NewProjectUi.border-swatch;
                hex: NewProjectUi.border-color;
                current: true;
            }
            OtherColor { which: 1; hex <=> NewProjectUi.border-color; }
        }
        if NewProjectUi.mode != 2: HorizontalLayout {
            spacing: Space.s2;
            alignment: start;
            RowLabel { text: "Espaço entre fotos"; }
            NumberField { accessible-label: "Espaço entre as fotos, em milímetros"; text <=> NewProjectUi.gap; width: 72px; minimum: 0; edited => { NewProjectUi.mount-changed(); } }
            Hint { text: "mm"; vertical-alignment: center; }
            Rectangle { width: Space.s4; }
            Text { text: "Cantos"; color: Theme.text; vertical-alignment: center; }
            NumberField { accessible-label: "Cantos arredondados, em milímetros"; text <=> NewProjectUi.radius; width: 72px; minimum: 0; edited => { NewProjectUi.mount-changed(); } }
            Hint { text: "mm"; vertical-alignment: center; }
        }
        if NewProjectUi.look-error != "": Text { text: NewProjectUi.look-error; color: Theme.warning; wrap: word-wrap; }
        Disclosure {
            text: "Mais opções";
            note: "layouts sem borda, mosaicos e variedade";
            open <=> root.more-open;
        }
        if root.more-open && NewProjectUi.crop == 0: Hint { text: "Com as fotos sempre inteiras, estes arranjos ficam desligados, porque eles cortam um pouco as fotos."; }
        if root.more-open: HorizontalLayout {
            spacing: Space.s4;
            alignment: start;
            CheckRow { text: "Layouts sem borda"; checked <=> NewProjectUi.bleed-page; enabled: NewProjectUi.crop != 0; toggled => { NewProjectUi.mount-changed(); } }
            CheckRow { text: "Mosaicos"; checked <=> NewProjectUi.mosaics; enabled: NewProjectUi.crop != 0; toggled => { NewProjectUi.mount-changed(); } }
        }
        if root.more-open: HorizontalLayout {
            spacing: Space.s2;
            Text { text: "Variedade dos desenhos"; color: Theme.text; vertical-alignment: center; }
            ComboBox { model: ["Muita variedade", "Equilibrado", "Mais uniforme"]; current-index <=> NewProjectUi.reuse; selected => { NewProjectUi.mount-changed(); } }
        }
    }
    VerticalLayout {
        width: 320px;
        spacing: Space.s2;
        alignment: start;
        Hint { text: "Prévia com fotos de exemplo"; }
        for img in NewProjectUi.previews: Image { accessible-role: none; source: img; image-fit: contain; height: 120px; }
    }
}

// Etapa 3: campos com a altura normal, e a lâmina escolhida à vista. A falta da pasta é dica; âmbar,
// só para erro de verdade (regra 16).
component StepThree inherits HorizontalLayout {
    spacing: Space.s5;
    VerticalLayout {
        horizontal-stretch: 1;
        spacing: Space.s3;
        alignment: start;
        HorizontalLayout {
            spacing: Space.s2;
            RowLabel { text: "Nome do álbum"; }
            FirstLineEdit {
                text <=> NewProjectUi.name;
                edited => { NewProjectUi.file-changed(); }
                accepted => {
                    if (NewProjectUi.create-error == "" && NewProjectUi.create-hint == "") {
                        NewProjectUi.create();
                    }
                }
            }
        }
        HorizontalLayout {
            spacing: Space.s2;
            RowLabel { text: "Fotos"; }
            DialogButton { text: "Escolher pasta…"; enabled: !NewProjectUi.no-photos; clicked => { NewProjectUi.pick-folder(); } }
            Text { text: NewProjectUi.photos-text; color: Theme.text-2; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
        }
        HorizontalLayout {
            spacing: Space.s2;
            alignment: start;
            RowLabel { }
            CheckRow { text: "Começar sem fotos (importo depois)"; checked <=> NewProjectUi.no-photos; toggled => { NewProjectUi.file-changed(); } }
        }
        if !NewProjectUi.no-photos && NewProjectUi.photos > 0: HorizontalLayout {
            spacing: Space.s2;
            alignment: start;
            RowLabel { }
            CheckRow { text: NewProjectUi.build-text; checked <=> NewProjectUi.build; toggled => { NewProjectUi.file-changed(); } }
        }
        if !NewProjectUi.no-photos && NewProjectUi.photos > 0 && NewProjectUi.build: HorizontalLayout {
            spacing: Space.s2;
            RowLabel { text: "Número de lâminas"; }
            SpinBox { value <=> NewProjectUi.spreads; minimum: 1; maximum: max(1, NewProjectUi.photos); edited => { NewProjectUi.file-changed(); } }
            Text { text: NewProjectUi.suggestion; color: Theme.text-2; vertical-alignment: center; }
        }
        HorizontalLayout {
            spacing: Space.s2;
            min-height: 32px;
            RowLabel { text: "Onde salvar"; }
            PathLabel { short: NewProjectUi.file-short; full: NewProjectUi.file; }
            DialogButton { text: "Alterar…"; clicked => { NewProjectUi.change-file(); } }
        }
        if NewProjectUi.create-hint != "": HorizontalLayout {
            spacing: Space.s2;
            RowLabel { }
            Hint { text: NewProjectUi.create-hint; horizontal-stretch: 1; }
        }
        if NewProjectUi.create-error != "": Text { text: NewProjectUi.create-error; color: Theme.warning; wrap: word-wrap; }
    }
    SizeSummary { }
}

export component NewProjectDialog inherits Dialog {
    callback closed();
    title: NewProjectUi.mode == 1 ? "Especificação do álbum" : NewProjectUi.mode == 2 ? "Montagem do álbum" : "Novo álbum";
    note: NewProjectUi.mode != 0 ? "" : "Etapa " + NewProjectUi.step + " de 3 · " + (NewProjectUi.step == 1 ? "Tamanho" : NewProjectUi.step == 2 ? "Montagem e aparência" : "Fotos e arquivo");
    // O mesmo tamanho nas três etapas, para os botões não mudarem de lugar (regra 12).
    size: DialogSize.wizard;
    fixed-height: DialogSize.wizard-height;
    child-focus: true;
    dismissed => {
        NewProjectUi.cancel();
        root.closed();
    }
    confirmed => {
        if (NewProjectUi.mode == 0 && NewProjectUi.step == 1 && NewProjectUi.error == "") {
            NewProjectUi.next();
        } else if (NewProjectUi.mode == 0 && NewProjectUi.step == 2) {
            NewProjectUi.next();
        }
    }
    DialogBody {
        gap: 0px;
        if NewProjectUi.step == 1: StepOne { }
        if NewProjectUi.step == 2: StepTwo { }
        if NewProjectUi.step == 3: StepThree { }
    }
    DialogFooter {
        DialogButton { text: "Cancelar"; clicked => { NewProjectUi.cancel(); root.closed(); } }
        if NewProjectUi.mode != 0: DialogButton {
            text: "Aplicar";
            primary: true;
            enabled: NewProjectUi.mode != 1 || NewProjectUi.error == "";
            clicked => { NewProjectUi.apply(); root.closed(); }
        }
        if NewProjectUi.mode == 0 && NewProjectUi.step > 1: DialogButton { text: "Voltar"; clicked => { NewProjectUi.back(); } }
        if NewProjectUi.mode == 0 && NewProjectUi.step < 3: DialogButton {
            text: "Próximo";
            primary: true;
            enabled: NewProjectUi.step != 1 || NewProjectUi.error == "";
            clicked => { NewProjectUi.next(); }
        }
        if NewProjectUi.mode == 0 && NewProjectUi.step == 3: DialogButton {
            text: "Criar";
            primary: true;
            enabled: NewProjectUi.create-error == "" && NewProjectUi.create-hint == "";
            clicked => { NewProjectUi.create(); }
        }
    }
}
