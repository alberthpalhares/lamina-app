// O topo da janela (spec janela-principal; barra enxuta da spec JE): Início, o título com o
// contador, e à direita só Fotos, Painel e Exportar. Novo, Abrir e Salvar ficam no menu Arquivo e
// o Texto na barra da lâmina. Cada botão roda um comando do registro pelo nome estável; as dicas
// vêm do editor (`bar_tip`). Sem álbum aberto, a mesma barra traz o logo e os botões da tela inicial,
// que moram em `welcome_cards.slint` (spec DI): a trava JE-B9 continua valendo para os daqui.

import { LineEdit } from "std-widgets.slint";
import { Theme, Type } from "theme.slint";
import { Icons } from "icons.slint";
import { BarButton, IconButton, Tip } from "widgets.slint";
import { Mark } from "marks.slint";
import { WelcomeActions } from "welcome_cards.slint";

// O nome do álbum que vira campo com clique duplo (spec NA): Enter ou clicar fora confirma, Esc
// desiste. Só desenho: o editor limpa o nome e decide se muda.
component AlbumName inherits Rectangle {
    accessible-role: AccessibleRole.text;
    accessible-label: root.name;
    in property <string> title;
    in property <string> name;
    in-out property <bool> renaming;
    callback rename(string);
    property <bool> cancelled;
    min-width: 40px;
    horizontal-stretch: 0;
    preferred-width: root.renaming ? max(220px, label.preferred-width + 40px) : label.preferred-width;
    label := Text {
        visible: !root.renaming;
        width: parent.width;
        height: parent.height;
        text: root.title;
        color: Theme.text;
        font-size: Type.title;
        font-weight: Type.semibold;
        vertical-alignment: center;
        overflow: elide;
    }
    if !root.renaming: TouchArea {
        mouse-cursor: text;
        double-clicked => {
            root.cancelled = false;
            root.renaming = true;
        }
    }
    if root.renaming: FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                root.cancelled = true;
                root.renaming = false;
                return accept;
            }
            reject
        }
        field := LineEdit {
            y: (parent.height - self.height) / 2;
            width: parent.width;
            text: root.name;
            font-size: Type.body;
            init => {
                self.focus();
                self.select-all();
            }
            accepted(text) => {
                root.cancelled = true;
                root.renaming = false;
                root.rename(text);
            }
            changed has-focus => {
                if (!self.has-focus && !root.cancelled && root.renaming) {
                    root.cancelled = true;
                    root.renaming = false;
                    root.rename(self.text);
                }
            }
        }
    }
}

// Os dados do medidor de páginas, que vêm do editor (spec DJ, regra 13). `text` vazio = sem medidor.
export struct PageMeterData {
    text: string,
    short: string,
}

// O medidor de páginas: um texto, que encurta em janela estreita e mostra o inteiro na dica.
component PageMeter inherits Rectangle {
    in property <PageMeterData> data;
    in property <length> room;
    property <bool> narrow: root.room < 1366px;
    accessible-role: AccessibleRole.text;
    accessible-label: root.data.text;
    min-width: 0px;
    preferred-width: label.preferred-width;
    label := Text {
        width: parent.width;
        height: parent.height;
        text: root.narrow ? root.data.short : root.data.text;
        color: Theme.text-2;
        vertical-alignment: center;
        overflow: elide;
    }
    area := TouchArea { }
    if root.narrow: Tip {
        y: parent.height + 4px;
        text: root.data.text;
        shown: area.has-hover;
    }
}

export component TopBar inherits Rectangle {
    // O medidor de páginas (spec DJ, regra 13): só em álbum com mínimo ou máximo.
    in property <PageMeterData> page-meter;
    // A largura copiada depois do layout: ligar o medidor direto em `width` fecharia um laço.
    property <length> meter-room: 1920px;
    changed width => { self.meter-room = self.width; }
    in property <bool> has-project;
    in property <string> project-title;
    // O nome sem o "• " e o campo de renomear aberto (spec NA).
    in property <string> album-name;
    in-out property <bool> renaming;
    callback rename(string);
    in property <string> counter;
    // Fora da faixa de páginas do laboratório (spec PR): ao lado do contador.
    in property <string> counter-warning;
    // Faixas de baixo e Painel acesos quando abertos (JE, regra 9; FX, regra 7).
    in property <bool> strips-open;
    in property <bool> panel-open;
    // As dicas de Início, Fotos, Painel e Exportar, com o atalho do registro.
    in property <string> tip-home;
    in property <string> tip-photos;
    in property <string> tip-panel;
    in property <string> tip-export;
    callback command(string);
    height: 44px;
    background: Theme.bar;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        spacing: 12px;
        alignment: stretch;
        // Início: fecha o álbum e volta à tela inicial (spec TI, regra 6).
        if root.has-project: VerticalLayout {
            alignment: center;
            IconButton {
                icon: Icons.home;
                tip: root.tip-home;
                tip-side: -1;
                clicked => { root.command("arquivo.fechar"); }
                Mark { name: "botao-inicio"; }
            }
        }
        if !root.has-project: VerticalLayout {
            alignment: center;
            Image {
                accessible-role: none;
                width: 100px;
                height: 22px;
                source: @image-url("../icons/lamina-logo-escuro.svg");
                image-fit: contain;
            }
        }
        if root.has-project: AlbumName {
            title: root.project-title;
            name: root.album-name;
            renaming <=> root.renaming;
            rename(text) => { root.rename(text); }
        }
        Text { text: root.counter; color: Theme.text-2; vertical-alignment: center; overflow: elide; min-width: 0px; }
        if root.counter-warning != "": Text { text: root.counter-warning; color: Theme.warning; vertical-alignment: center; overflow: elide; min-width: 0px; }
        if root.has-project && root.page-meter.text != "": PageMeter { data: root.page-meter; room: root.meter-room; }
        Rectangle { horizontal-stretch: 1; }
        if !root.has-project: WelcomeActions { command(name) => { root.command(name); } }
        if root.has-project: VerticalLayout {
            alignment: center;
            // As faixas de baixo (spec FX, regras 7 e 8): o desenho da janela com a área de baixo
            // preenchida quando alguma aparece.
            IconButton {
                icon: root.strips-open ? Icons.strips : Icons.strips-closed;
                tip: root.tip-photos;
                tip-side: 1;
                checked: root.strips-open;
                clicked => { root.command("ver.faixas"); }
                Mark { name: "botao-faixas"; }
            }
        }
        if root.has-project: VerticalLayout {
            alignment: center;
            IconButton {
                icon: root.panel-open ? Icons.panel-right : Icons.panel-right-close;
                tip: root.tip-panel;
                tip-side: 1;
                checked: root.panel-open;
                clicked => { root.command("ver.painel"); }
                Mark { name: "botao-painel"; }
            }
        }
        if root.has-project: VerticalLayout {
            alignment: center;
            export := BarButton {
                height: 32px;
                text: "Exportar";
                primary: true;
                clicked => { root.command("arquivo.exportar"); }
                Mark { name: "botao-exportar"; }
                Tip {
                    x: parent.width - self.width;
                    y: parent.height + 4px;
                    text: root.tip-export;
                    shown: export.hovered;
                }
            }
        }
    }
}

// O aviso amarelo embaixo da barra, com "Reencontrar fotos…" quando faltam fotos (spec RF).
export component NoticeBar inherits Rectangle {
    in property <string> text;
    in property <bool> has-missing;
    callback command(string);
    height: 30px;
    background: Theme.warning-soft;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 8px;
        spacing: 12px;
        Text { text: root.text; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
        if root.has-missing: BarButton { text: "Reencontrar fotos…"; clicked => { root.command("arquivo.procurar-fotos"); } }
    }
}