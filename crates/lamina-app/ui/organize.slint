// O modo organizar a lâmina (spec EG): o título da lâmina em destaque, os quadros selecionados, o
// laço e o painel do modo. Só desenho: o editor decide e o Rust preenche o `OrganizeUi`.

import { LineEdit, ScrollView } from "std-widgets.slint";
import { NumberField } from "number_field.slint";
import { Theme, Fixed, Type, Radius, Space, Line, Elevation } from "theme.slint";
import { Icons } from "icons.slint";
import { BoxData } from "canvas.slint";
import { LookPanel } from "look.slint";
import { PhotoUi, PhotoSection } from "photo.slint";
import { FocusRing, IconButton, NeutralSlider, Tip, DialogButton, CheckRow } from "widgets.slint";
import { PaletteUi } from "palette.slint";

// Uma marca do ímã de mesmo tamanho ou de espaçamento igual: a linha e o texto, em frações da
// largura da lâmina.
export struct MarkData {
    line: BoxData,
    text: string,
    tx: float,
    ty: float,
}

// Uma marca da régua, em fração da largura da lâmina (a partir do canto com a sangria).
export struct TickData {
    at: float,
    label: string,
    major: bool,
}

// Uma linha de menu da barra (spec BO): o ícone, o nome do comando, o nome estável e se vale agora.
// O ícone vem do Rust: uma escolha entre onze imagens aqui derrubava o compilador do Rust.
export struct BarRow {
    icon: image,
    label: string,
    command: string,
    enabled: bool,
}

export global OrganizeUi {
    in property <bool> on;
    // "Organizar a lâmina 3", no painel (spec DG, regra 7).
    in property <string> title;
    // "2 quadros" (vazio sem seleção).
    in property <string> count;
    // Os quadros selecionados e a caixa do grupo, em frações da largura da lâmina.
    in property <[BoxData]> boxes;
    in property <BoxData> group;
    in property <bool> has-group;
    // As marcas do ímã durante o gesto ("= 9 cm" e os vãos iguais).
    in property <[MarkData]> marks;
    // O laço em andamento, em pixels da janela.
    in-out property <bool> lassoing;
    in-out property <length> lasso-x0;
    in-out property <length> lasso-y0;
    in-out property <length> lasso-x1;
    in-out property <length> lasso-y1;
    // Os campos da seleção (X e Y a partir do corte, largura e altura da caixa do grupo).
    in property <string> unit;
    in-out property <string> gx;
    in-out property <string> gy;
    in-out property <string> gw;
    in-out property <string> gh;
    in-out property <bool> keep: true;
    in property <string> field-error;
    // "Selecione três quadros ou mais." enquanto Distribuir não vale.
    in property <string> hint;
    // O zoom da lâmina (1 = "Ajustar") e a vista arrastada pela mão, em pixels a partir do centro
    // de Ajustar; a duração do movimento vem do editor (spec ZR, regra 6).
    in property <float> zoom: 1;
    in-out property <length> pan-x;
    in-out property <length> pan-y;
    in-out property <int> view-ms;
    // A largura de Ajustar sem a animação, para o tamanho real (spec ZR, regra 7).
    in-out property <length> fit-width;
    // A paleta: 0 = Selecionar, 1 = Quadro, 2 = Texto, 3 = Mão, 4 = Lupa. Espaço segurado também
    // é a mão.
    in-out property <int> tool;
    in-out property <bool> hand;
    // As réguas.
    in property <[TickData]> ticks-x;
    in property <[TickData]> ticks-y;
    callback done();
    // A lupa (Alt afasta) e o Ctrl+roda, no ponto a partir do centro de Ajustar; a mão soltou a
    // vista; a largura de Ajustar mudou.
    callback loupe(bool, length, length);
    callback wheel(bool, length, length);
    callback pan-done();
    callback fit-changed();
    // Um quadro (1) ou texto (2) desenhado, em frações da largura da lâmina.
    callback draw-done(int, float, float, float, float);
    // 0 = X, 1 = Y, 2 = largura, 3 = altura.
    callback field-accepted(int);
    // Um comando do registro pelo nome estável (Alinhar, Igualar, Distribuir).
    callback command(string);
    // A barra única (spec BO): o que cabe na largura (o Rust decide pela `bar-width`), se há
    // seleção para os campos, as dicas e as linhas dos três menus e a posição do controle de zoom
    // (spec CD, regra 3).
    in property <bool> bar-fit: true;
    in property <bool> bar-menus: true;
    in property <bool> bar-fields: true;
    in property <bool> can-fields;
    in property <[string]> menu-tips: ["Alinhar", "Igualar", "Distribuir"];
    in property <[BarRow]> align-rows;
    in property <[BarRow]> equal-rows;
    in property <[BarRow]> distribute-rows;
    in-out property <float> zoom-position;
    callback bar-width(length);
    callback zoom-slider(float);
}

// As linhas de um menu (ícone e nome); clicar roda o comando e fecha. Pelo teclado, as setas andam
// pelas linhas e Enter ou Espaço rodam (spec DG, regra 5); com `tab-moves`, o Tab também, porque o menu
// sozinho não tem para onde ir. Dentro do ⋯, o Tab passa para o próximo grupo.
component MenuRows inherits VerticalLayout {
    in property <[BarRow]> rows;
    in property <bool> tab-moves;
    in-out property <int> active: -1;
    callback picked();
    function run(i: int) {
        if (root.rows[i].enabled) {
            PaletteUi.command(root.rows[i].command);
            root.picked();
        }
    }
    function walk(step: int) {
        root.active = mod(max(root.active, step > 0 ? -1 : 0) + step + root.rows.length, root.rows.length);
    }
    forward-focus: scope;
    padding: Space.s1;
    spacing: Space.s1;
    scope := FocusScope {
        width: 0;
        height: 0;
        key-pressed(e) => {
            if (e.text == Key.DownArrow || (root.tab-moves && e.text == Key.Tab)) {
                root.walk(1);
                return accept;
            }
            if (e.text == Key.UpArrow || (root.tab-moves && e.text == Key.Backtab)) {
                root.walk(-1);
                return accept;
            }
            if ((e.text == Key.Return || e.text == Key.Space) && root.active >= 0) {
                root.run(root.active);
                return accept;
            }
            return reject;
        }
    }
    for r[i] in root.rows: Rectangle {
        height: 28px;
        min-width: 210px;
        border-radius: Radius.small;
        background: (row-touch.has-hover || i == root.active) && r.enabled ? Theme.press : transparent;
        HorizontalLayout {
            padding-left: Space.s2;
            padding-right: Space.s3;
            spacing: Space.s2;
            alignment: start;
            VerticalLayout {
                alignment: center;
                Image {
                    accessible-role: none;
                    width: 18px;
                    height: 18px;
                    source: r.icon;
                    colorize: r.enabled ? Theme.text : Theme.text-disabled;
                }
            }
            Text { text: r.label; color: r.enabled ? Theme.text : Theme.text-disabled; vertical-alignment: center; }
        }
        accessible-role: button;
        accessible-label: r.label;
        accessible-enabled: r.enabled;
        accessible-action-default => { root.run(i); }
        row-touch := TouchArea {
            enabled: r.enabled;
            clicked => { root.run(i); }
        }
        FocusRing { shown: i == root.active && scope.has-focus; x: 0; y: 0; width: parent.width; height: parent.height; }
    }
}

// Alinhar ▾, Igualar ▾, Distribuir ▾ (spec BO, regras 1 e 2): apagado diz o porquê na dica.
component MenuButton inherits Rectangle {
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { root.open(false); }
    in property <string> text;
    in property <string> tip;
    in property <bool> enabled;
    in property <[BarRow]> rows;
    property <int> first: -1;
    function open(by-keys: bool) {
        if (root.enabled) {
            root.first = by-keys ? 0 : -1;
            popup.show();
        }
    }
    width: label.preferred-width + 34px;
    height: 32px;
    border-radius: Radius.small;
    background: touch.has-hover && root.enabled ? Theme.press : transparent;
    // A seta é um desenho nosso: a fonte da janela não tem o "▾" (aparecia um quadradinho).
    label := Text {
        x: Space.s2;
        height: parent.height;
        text: root.text;
        color: root.enabled ? Theme.text-strong : Theme.text-disabled;
        vertical-alignment: center;
    }
    Image {
        accessible-role: none;
        x: label.x + label.preferred-width + Space.s1;
        y: (parent.height - self.height) / 2;
        width: 12px;
        height: 12px;
        source: Icons.chevron-down;
        colorize: root.enabled ? Theme.text-strong : Theme.text-disabled;
    }
    touch := TouchArea {
        clicked => { root.open(false); }
    }
    focus := FocusScope {
        x: 0;
        width: 0;
        enabled: root.enabled;
        key-pressed(e) => {
            if (e.text == Key.Space || e.text == Key.Return) {
                root.open(true);
                return accept;
            }
            return reject;
        }
    }
    FocusRing { shown: focus.has-focus; x: -3px; y: -3px; width: parent.width + 6px; height: parent.height + 6px; }
    popup := PopupWindow {
        forward-focus: list;
        y: parent.height + Line.focus;
        Rectangle {
            background: Theme.raised;
            border-radius: Radius.medium;
            border-width: Line.thin;
            border-color: Theme.line;
            drop-shadow-blur: Elevation.menu-blur;
            drop-shadow-offset-y: Elevation.menu-y;
            drop-shadow-color: Elevation.menu-color;
            list := MenuRows { rows: root.rows; tab-moves: true; active: root.first; picked => { popup.close(); } }
        }
    }
    Tip {
        x: 0px;
        y: parent.height + Space.s1;
        text: root.tip;
        shown: touch.has-hover && !touch.pressed;
    }
}

// X, Y, L, A e o cadeado de "Manter proporção" (spec BO, regra 1, item 5).
component BarFields inherits HorizontalLayout {
    spacing: Space.s1;
    alignment: start;
    Text { text: "X"; color: Theme.text-strong; vertical-alignment: center; }
    NumberField { step-accepts: true; width: 58px; text <=> OrganizeUi.gx; accepted => { OrganizeUi.field-accepted(0); } }
    Text { text: "Y"; color: Theme.text-strong; vertical-alignment: center; }
    NumberField { step-accepts: true; width: 58px; text <=> OrganizeUi.gy; accepted => { OrganizeUi.field-accepted(1); } }
    Text { text: "L"; color: Theme.text-strong; vertical-alignment: center; }
    NumberField { step-accepts: true; width: 58px; text <=> OrganizeUi.gw; accepted => { OrganizeUi.field-accepted(2); } }
    Text { text: "A"; color: Theme.text-strong; vertical-alignment: center; }
    NumberField { step-accepts: true; width: 58px; text <=> OrganizeUi.gh; accepted => { OrganizeUi.field-accepted(3); } }
    VerticalLayout {
        alignment: center;
        IconButton {
            icon: OrganizeUi.keep ? Icons.lock : Icons.lock-open;
            tip: OrganizeUi.keep ? "Manter proporção (ligado)" : "Manter proporção (desligado)";
            checked: OrganizeUi.keep;
            clicked => { OrganizeUi.keep = !OrganizeUi.keep; }
        }
    }
}

component Separator inherits Rectangle {
    width: Line.thin;
    height: 20px;
    background: Theme.line;
}

// A barra única do modo organizar (specs BO e DG), em cima da área da lâmina. À esquerda, o que age
// na seleção; à direita, o que muda a vista. O que não cabe vai para o ⋯ (BO, regra 3).
export component OrganizeBar inherits Rectangle {
    accessible-role: groupbox;
    accessible-label: "Barra do modo organizar";
    height: 40px;
    background: Theme.bar;
    init => { OrganizeUi.bar-width(self.width); }
    changed width => { OrganizeUi.bar-width(self.width); }
    property <bool> shows-fields: OrganizeUi.bar-fields && OrganizeUi.can-fields;
    property <bool> all-in: OrganizeUi.bar-fit && OrganizeUi.bar-menus && (OrganizeUi.bar-fields || !OrganizeUi.can-fields);
    // O fio que separa da barra de cima.
    Rectangle { y: 0; height: Line.thin; background: Theme.line; }
    HorizontalLayout {
        padding-left: Space.s2;
        padding-right: Space.s2;
        spacing: Space.s2;
        // Voltar no lugar de Concluir (spec ZR, regra 12): a tela anima a saída.
        VerticalLayout {
            horizontal-stretch: 0;
            alignment: center;
            back := DialogButton {
                text: "Voltar";
                clicked => { OrganizeUi.done(); }
                Tip { x: 0px; y: parent.height + Space.s1; text: "Voltar (Esc)"; shown: back.hovered; }
            }
        }
        VerticalLayout { horizontal-stretch: 0; alignment: center; Separator { } }
        HorizontalLayout {
            horizontal-stretch: 0;
            spacing: Space.s1;
            alignment: start;
            VerticalLayout { alignment: center; IconButton { icon: Icons.pointer; tip: PaletteUi.tips[0]; selected: PaletteUi.tool == 0; clicked => { PaletteUi.pick-tool(0); } } }
            VerticalLayout { alignment: center; IconButton { icon: Icons.frame; tip: PaletteUi.tips[1]; selected: PaletteUi.tool == 1; clicked => { PaletteUi.pick-tool(1); } } }
            VerticalLayout { alignment: center; IconButton { icon: Icons.text; tip: PaletteUi.tips[2]; selected: PaletteUi.tool == 2; clicked => { PaletteUi.pick-tool(2); } } }
            VerticalLayout { alignment: center; IconButton { icon: Icons.hand; tip: PaletteUi.tips[3]; selected: PaletteUi.tool == 3; clicked => { PaletteUi.pick-tool(3); } } }
            VerticalLayout { alignment: center; IconButton { icon: Icons.zoom; tip: PaletteUi.tips[4]; selected: PaletteUi.tool == 4; clicked => { PaletteUi.pick-tool(4); } } }
        }
        if OrganizeUi.bar-menus: HorizontalLayout {
            horizontal-stretch: 0;
            spacing: Space.s1;
            VerticalLayout { alignment: center; Separator { } }
            VerticalLayout { alignment: center; MenuButton { text: "Alinhar"; tip: OrganizeUi.menu-tips[0]; enabled: PaletteUi.can-align; rows: OrganizeUi.align-rows; } }
            VerticalLayout { alignment: center; MenuButton { text: "Igualar"; tip: OrganizeUi.menu-tips[1]; enabled: PaletteUi.can-align; rows: OrganizeUi.equal-rows; } }
            VerticalLayout { alignment: center; MenuButton { text: "Distribuir"; tip: OrganizeUi.menu-tips[2]; enabled: PaletteUi.can-distribute; rows: OrganizeUi.distribute-rows; } }
        }
        if root.shows-fields: HorizontalLayout {
            horizontal-stretch: 0;
            spacing: Space.s2;
            VerticalLayout { alignment: center; Separator { } }
            BarFields { }
        }
        // O vão entre os dois lados.
        Rectangle { horizontal-stretch: 1; }
        // O zoom da lâmina (spec CD, regra 3): −, o controle, + e o valor.
        HorizontalLayout {
            horizontal-stretch: 0;
            spacing: Space.s1;
            alignment: start;
            VerticalLayout { alignment: center; IconButton { icon: Icons.minus; tip: PaletteUi.tips[5]; clicked => { PaletteUi.command("organizar.menos-zoom"); } } }
            VerticalLayout {
                alignment: center;
                NeutralSlider {
                    width: 120px;
                    minimum: 0;
                    maximum: 1;
                    neutral: 0;
                    value <=> OrganizeUi.zoom-position;
                    changed(v) => { OrganizeUi.zoom-slider(v); }
                    reset => { PaletteUi.command("organizar.ajustar"); }
                }
            }
            VerticalLayout { alignment: center; IconButton { icon: Icons.plus; tip: PaletteUi.tips[6]; clicked => { PaletteUi.command("organizar.mais-zoom"); } } }
            Text {
                width: 56px;
                text: PaletteUi.zoom;
                color: Theme.text-strong;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        if OrganizeUi.bar-fit: HorizontalLayout {
            horizontal-stretch: 0;
            spacing: Space.s1;
            VerticalLayout { alignment: center; IconButton { icon: Icons.fit; tip: PaletteUi.tips[8]; tip-side: 1; clicked => { PaletteUi.command("organizar.ajustar"); } } }
            VerticalLayout { alignment: center; IconButton { icon: Icons.actual-size; tip: PaletteUi.tips[7]; tip-side: 1; clicked => { PaletteUi.command("organizar.tamanho-real"); } } }
        }
        // O que não coube (BO, regra 3): Ajustar e 1:1, os menus e os campos, nessa ordem de volta.
        if !root.all-in: VerticalLayout {
            horizontal-stretch: 0;
            alignment: center;
            IconButton {
                icon: Icons.more;
                tip: "Mais opções";
                tip-side: 1;
                clicked => { more-popup.show(); }
                more-popup := PopupWindow {
                    x: parent.width - 260px;
                    y: parent.height + Line.focus;
                    close-policy: close-on-click-outside;
                    Rectangle {
                        width: 260px;
                        background: Theme.raised;
                        border-radius: Radius.medium;
                        border-width: Line.thin;
                        border-color: Theme.line;
                        drop-shadow-blur: Elevation.menu-blur;
                        drop-shadow-offset-y: Elevation.menu-y;
                        drop-shadow-color: Elevation.menu-color;
                        VerticalLayout {
                            padding: Space.s2;
                            spacing: Space.s1;
                            if !OrganizeUi.bar-fit: HorizontalLayout {
                                spacing: Space.s1;
                                alignment: start;
                                IconButton { icon: Icons.fit; tip: PaletteUi.tips[8]; clicked => { PaletteUi.command("organizar.ajustar"); } }
                                IconButton { icon: Icons.actual-size; tip: PaletteUi.tips[7]; clicked => { PaletteUi.command("organizar.tamanho-real"); } }
                            }
                            if !OrganizeUi.bar-menus: MenuRows { rows: OrganizeUi.align-rows; picked => { more-popup.close(); } }
                            if !OrganizeUi.bar-menus: MenuRows { rows: OrganizeUi.equal-rows; picked => { more-popup.close(); } }
                            if !OrganizeUi.bar-menus: MenuRows { rows: OrganizeUi.distribute-rows; picked => { more-popup.close(); } }
                            if !OrganizeUi.bar-fields && OrganizeUi.can-fields: GridLayout {
                                spacing: Space.s1;
                                Row {
                                    Text { text: "X"; color: Theme.text; vertical-alignment: center; }
                                    NumberField { step-accepts: true; text <=> OrganizeUi.gx; accepted => { OrganizeUi.field-accepted(0); } }
                                    Text { text: "Y"; color: Theme.text; vertical-alignment: center; }
                                    NumberField { step-accepts: true; text <=> OrganizeUi.gy; accepted => { OrganizeUi.field-accepted(1); } }
                                }
                                Row {
                                    Text { text: "L"; color: Theme.text; vertical-alignment: center; }
                                    NumberField { step-accepts: true; text <=> OrganizeUi.gw; accepted => { OrganizeUi.field-accepted(2); } }
                                    Text { text: "A"; color: Theme.text; vertical-alignment: center; }
                                    NumberField { step-accepts: true; text <=> OrganizeUi.gh; accepted => { OrganizeUi.field-accepted(3); } }
                                }
                            }
                            if !OrganizeUi.bar-fields && OrganizeUi.can-fields: CheckRow { text: "Manter proporção"; checked <=> OrganizeUi.keep; }
                        }
                    }
                }
            }
        }
    }
}

// As réguas, presas às bordas da área da lâmina: a de cima e a do lado acompanham o zoom e a
// mão. `lx`, `ly` e `unit` são a posição e a largura da lâmina desenhada, na área. O fundo é o da
// barra, e o canto diz a unidade (spec DG, regra 11).
export component OrganizeRulers inherits Rectangle {
    in property <length> lx;
    in property <length> ly;
    in property <length> unit;
    property <length> size: 18px;
    top := Rectangle {
        x: root.size;
        y: 0;
        width: root.width - root.size;
        height: root.size;
        background: Theme.bar;
        clip: true;
        for t in OrganizeUi.ticks-x: Rectangle {
            x: root.lx + t.at * root.unit - top.x;
            y: t.major ? 0px : root.size * 0.6;
            width: Line.thin;
            height: t.major ? root.size : root.size * 0.4;
            background: Theme.text-3;
            if t.label != "": Text {
                x: 3px;
                y: 0px;
                text: t.label;
                color: Theme.text-2;
                font-size: Type.micro;
            }
        }
    }
    side := Rectangle {
        x: 0;
        y: root.size;
        width: root.size;
        height: root.height - root.size;
        background: Theme.bar;
        clip: true;
        for t in OrganizeUi.ticks-y: Rectangle {
            x: t.major ? 0px : root.size * 0.6;
            y: root.ly + t.at * root.unit - side.y;
            width: t.major ? root.size : root.size * 0.4;
            height: Line.thin;
            background: Theme.text-3;
            if t.label != "": Text {
                x: 1px;
                y: 2px;
                text: t.label;
                color: Theme.text-2;
                font-size: Type.micro;
            }
        }
    }
    Rectangle {
        width: root.size;
        height: root.size;
        x: 0;
        y: 0;
        background: Theme.bar;
        Text {
            text: OrganizeUi.unit;
            color: Theme.text-2;
            font-size: Type.micro;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// A paleta e a mão por cima da lâmina: arrastar desenha um quadro ou um texto, ou move a vista.
// `lx`, `ly` e `unit` como nas réguas.
export component OrganizeTools inherits TouchArea {
    in property <length> lx;
    in property <length> ly;
    in property <length> unit;
    // O centro de Ajustar, na área: a lupa mede o ponto a partir dele (spec ZR, regra 5).
    in property <length> cx;
    in property <length> cy;
    property <bool> panning: OrganizeUi.hand || OrganizeUi.tool == 3;
    property <bool> loupe: OrganizeUi.tool == 4 && !OrganizeUi.hand;
    property <bool> alt;
    property <length> px;
    property <length> py;
    property <length> start-x;
    property <length> start-y;
    mouse-cursor: root.panning ? (self.pressed ? grabbing : grab) : crosshair;
    pointer-event(e) => {
        root.alt = e.modifiers.alt;
        if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
            root.px = self.mouse-x;
            root.py = self.mouse-y;
            root.start-x = OrganizeUi.pan-x;
            root.start-y = OrganizeUi.pan-y;
            // A mão acompanha na hora, sem animar (MV, regra 6).
            if (root.panning) {
                OrganizeUi.view-ms = 0;
            }
        }
        if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up && root.panning) {
            OrganizeUi.pan-done();
        }
        // A lupa: um passo por clique, sem selecionar nem abrir o recorte (spec ZR, regra 2).
        if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up && root.loupe) {
            OrganizeUi.loupe(e.modifiers.alt, self.mouse-x - root.cx, self.mouse-y - root.cy);
        } else if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up && !root.panning) {
            OrganizeUi.draw-done(OrganizeUi.tool,
                (root.px - root.lx) / root.unit, (root.py - root.ly) / root.unit,
                (self.mouse-x - root.lx) / root.unit, (self.mouse-y - root.ly) / root.unit);
        }
    }
    moved => {
        if (root.panning) {
            OrganizeUi.pan-x = root.start-x + self.mouse-x - root.px;
            OrganizeUi.pan-y = root.start-y + self.mouse-y - root.py;
        }
    }
    // O sinal da lupa ao lado da cruz (o Slint não tem o ponteiro de lupa; desenho nosso).
    if root.loupe && root.has-hover: Image {
        accessible-role: none;
        x: root.mouse-x + 10px;
        y: root.mouse-y + 8px;
        width: 14px;
        height: 14px;
        source: root.alt ? Icons.minus : Icons.plus;
        colorize: Theme.text-strong;
    }
    if root.pressed && !root.panning && !root.loupe: Rectangle {
        x: min(root.px, root.mouse-x);
        y: min(root.py, root.mouse-y);
        width: abs(root.mouse-x - root.px);
        height: abs(root.mouse-y - root.py);
        border-width: 1px;
        border-color: Theme.accent;
        background: Theme.accent-soft;
    }
}

// Os quadros selecionados por cima da lâmina (`unit` = a largura dela em pixels).
export component OrganizeMarks inherits Rectangle {
    in property <length> unit;
    for b in OrganizeUi.boxes: Rectangle {
        x: b.x * root.unit;
        y: b.y * root.unit;
        width: b.w * root.unit;
        height: b.h * root.unit;
        border-width: 3px;
        border-color: Theme.accent;
    }
    if OrganizeUi.has-group: Rectangle {
        x: OrganizeUi.group.x * root.unit - 3px;
        y: OrganizeUi.group.y * root.unit - 3px;
        width: OrganizeUi.group.w * root.unit + 6px;
        height: OrganizeUi.group.h * root.unit + 6px;
        border-width: 1px;
        border-color: Theme.overlay-strong;
    }
    for m in OrganizeUi.marks: Rectangle {
        Rectangle {
            x: m.line.x * root.unit;
            y: m.line.y * root.unit;
            width: max(1px, m.line.w * root.unit);
            height: max(1px, m.line.h * root.unit);
            background: Fixed.guide;
        }
        Rectangle {
            x: m.tx * root.unit;
            y: m.ty * root.unit - self.height / 2;
            width: label.preferred-width + 8px;
            height: label.preferred-height + 4px;
            background: Theme.shadow-strong;
            border-radius: Radius.small;
            label := Text {
                x: 4px;
                y: 2px;
                text: m.text;
                color: Fixed.guide;
                font-size: Type.caption;
            }
        }
    }
}

// O laço, em pixels da janela.
export component LassoBox inherits Rectangle {
    x: min(OrganizeUi.lasso-x0, OrganizeUi.lasso-x1);
    y: min(OrganizeUi.lasso-y0, OrganizeUi.lasso-y1);
    width: abs(OrganizeUi.lasso-x1 - OrganizeUi.lasso-x0);
    height: abs(OrganizeUi.lasso-y1 - OrganizeUi.lasso-y0);
    background: Theme.accent-soft;
    border-width: 1px;
    border-color: Theme.accent;
}

// O painel da direita no modo (EG-B23): a seleção, a foto, fundo e espaço da lâmina. Os campos de
// posição e tamanho foram para a barra de cima (spec BO, regra 1).
export component OrganizePanel inherits ScrollView {
    callback done();
    VerticalLayout {
    width: root.visible-width;
    spacing: Space.s2;
    Text { text: OrganizeUi.title; color: Theme.text; font-weight: Type.semibold; }
    if OrganizeUi.count != "": Text { text: OrganizeUi.count; color: Theme.text-2; wrap: word-wrap; }
    if OrganizeUi.field-error != "": Text { text: OrganizeUi.field-error; color: Theme.error; wrap: word-wrap; }
    if PhotoUi.has-photo: PhotoSection { }
    LookPanel {
        frame-style: !PhotoUi.has-photo;
        done => { root.done(); }
    }
    }
}
