// Linha do tempo (spec FQ, regra 8): as fotos na ordem do álbum e um corte entre as lâminas.
// Arrastar um corte leva fotos de uma lâmina para a vizinha; arrastar uma foto a leva para outra
// lâmina ou muda a ordem dela (spec SQ). Só os itens perto da parte visível
// existem na tela (spec RL, regra 22; PF, seção 10): o Rust dá a posição de cada um e a largura
// toda, e troca os itens quando a rolagem passa de um trecho para outro.

import { ScrollView } from "std-widgets.slint";
import { Theme, Radius } from "theme.slint";
import { Motion } from "motion.slint";
import { StripTheme } from "strip_header.slint";
import { DragUi } from "drag.slint";
import { RollUi, TimelineStep } from "roll.slint";
import { FocusRing } from "widgets.slint";

// Uma posição da timeline: uma foto, ou o corte depois da lâmina `spread`.
export struct TimelineItem {
    img: image,
    cut: bool,
    spread: int,
    // A posição na linha inteira.
    x: length,
    // A posição na lista inteira da Sequência (o editor acha a foto por ela; spec SQ).
    row: int,
}

export component TimelineStrip inherits Rectangle {
    in property <[TimelineItem]> timeline;
    callback cut-moved(int, int);
    // Arrastar uma foto (spec SQ): o x da linha de entrada para o ponteiro e o soltar.
    pure callback seq-marker(length) -> length;
    callback seq-drop(int, length);
    // A foto levantada: o ponteiro na linha inteira, a miniatura, a posição e se está na faixa.
    property <length> seq-x;
    property <image> seq-img;
    property <int> seq-row: -1;
    property <bool> seq-inside: true;
    property <bool> seq-on: DragUi.kind == 5 && !DragUi.cancel;
    // O ponteiro dentro da parte visível, para rolar sozinho perto das bordas (spec FX, regra 4).
    property <length> seq-view-x: root.seq-x + line-scroll.content-x;
    // Clique numa foto: vai para a lâmina dela (spec RL, regra 22).
    callback go-to(int);
    callback focus-main();
    // Uma parada de Tab (spec DD, regra 28): ← → andam pelas fotos, com o anel na foto marcada, e
    // Enter vai para a lâmina dela. O Rust acha a foto, porque só as de perto existem na tela.
    property <TimelineStep> mark;
    function step(delta: int) {
        root.mark = RollUi.line-step(root.mark.row, delta);
        // A foto marcada fica à vista.
        let left = root.mark.x;
        if (left + line-scroll.content-x < 0px) {
            line-scroll.content-x = -left;
        } else if (left + 46px + line-scroll.content-x > line-scroll.visible-width) {
            line-scroll.content-x = line-scroll.visible-width - left - 46px;
        }
    }
    accessible-role: AccessibleRole.list;
    accessible-label: "Sequência";
    keys := FocusScope {
        x: 0;
        width: 0;
        changed has-focus => {
            if (self.has-focus) {
                root.mark.row = -1;
                root.step(1);
            }
        }
        key-pressed(e) => {
            if (e.text == Key.LeftArrow) {
                root.step(-1);
                return accept;
            }
            if (e.text == Key.RightArrow) {
                root.step(1);
                return accept;
            }
            if (e.text == Key.Return && root.mark.row >= 0) {
                root.go-to(root.mark.spread);
                return accept;
            }
            reject
        }
    }
    background: StripTheme.timeline;
    Rectangle { y: 0; height: 1px; background: StripTheme.line; }

    // A roda vertical rola a faixa (spec MV, regra 10), suave pelo relógio; giros seguidos somam.
    property <bool> sc-running;
    property <duration> sc-t0;
    property <length> sc-from;
    property <length> sc-to;
    property <float> sc-p: self.sc-running ? min(1, (animation-tick() - self.sc-t0) / max(1ms, Motion.scroll-ms * 1ms)) : 1;
    changed sc-p => {
        if (self.sc-running) {
            line-scroll.content-x = self.sc-from + (self.sc-to - self.sc-from) * (1 - pow(1 - self.sc-p, 3));
            if (self.sc-p >= 1) {
                self.sc-running = false;
            }
        }
    }
    function wheel(dy: length) {
        let base = root.sc-running ? root.sc-to : line-scroll.content-x;
        let target = max(line-scroll.visible-width - RollUi.line-w, min(0px, base + dy));
        if (Motion.on && Motion.scroll-ms > 0) {
            root.sc-from = line-scroll.content-x;
            root.sc-to = target;
            root.sc-t0 = animation-tick();
            root.sc-running = true;
        } else {
            line-scroll.content-x = target;
        }
    }
    // O trecho da lâmina atual fica no meio da linha, rolando pelo relógio (spec RL, regra 22).
    property <length> run-center: RollUi.run-x + RollUi.run-w / 2;
    changed run-center => {
        let target = max(0px, min(root.run-center - line-scroll.visible-width / 2, RollUi.line-w - line-scroll.visible-width));
        if (Motion.on && Motion.scroll-ms > 0) {
            root.sc-from = line-scroll.content-x;
            root.sc-to = -target;
            root.sc-t0 = animation-tick();
            root.sc-running = true;
        } else {
            line-scroll.content-x = -target;
        }
    }
    // O trecho da linha à vista (de 400 em 400 px): o Rust troca os itens quando ele muda.
    property <int> stretch: floor(-line-scroll.content-x / 400px);
    property <length> seen-width: line-scroll.visible-width;
    changed stretch => { RollUi.line-window(-line-scroll.content-x, line-scroll.visible-width); }
    changed seen-width => { RollUi.line-window(-line-scroll.content-x, line-scroll.visible-width); }
    init => { RollUi.line-window(-line-scroll.content-x, line-scroll.visible-width); }
    line-scroll := ScrollView {
        // Arrastar é para levar a foto (ou o corte), não para rolar.
        mouse-drag-pan-enabled: false;
        content-width: RollUi.line-w;
        content-height: self.height;
        scrolled => { root.sc-running = false; }
        TouchArea {
            width: RollUi.line-w;
            height: line-scroll.height;
            scroll-event(e) => {
                if (e.delta-y != 0) {
                    root.wheel(e.delta-y);
                    return accept;
                }
                reject
            }
        }
        // O fundo destacado do trecho da lâmina atual.
        if RollUi.run-w > 0: Rectangle {
            x: RollUi.run-x - 3px;
            y: 3px;
            width: RollUi.run-w + 6px;
            height: line-scroll.height - 6px;
            border-radius: Radius.small;
            background: Theme.press;
        }
        for t in root.timeline: Rectangle {
            x: t.x;
            y: 6px;
            height: line-scroll.height - 12px;
            width: t.cut ? 14px : 46px;
            // `visible` em vez de `if`: a vaga troca de foto para corte sem refazer a peça
            // (spec RL, regra 31).
            Image {
                visible: !t.cut;
                accessible-role: none;
                width: 44px;
                height: 44px;
                source: t.img;
                image-fit: contain;
            }
            // Clique vai para a lâmina; depois de 6 px a foto levanta e segue o mouse (spec SQ).
            TouchArea {
                visible: !t.cut;
                pointer-event(e) => {
                    if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                        DragUi.press-x = self.absolute-position.x + self.mouse-x;
                        DragUi.press-y = self.absolute-position.y + self.mouse-y;
                        DragUi.cancel = false;
                    }
                    if (e.kind == PointerEventKind.move && self.pressed) {
                        if (DragUi.kind == 0 && DragUi.far(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y)) {
                            DragUi.kind = 5;
                            root.seq-img = t.img;
                            root.seq-row = t.row;
                        }
                        if (DragUi.kind == 5) {
                            root.seq-x = t.x + self.mouse-x;
                            root.seq-inside = self.mouse-y > -12px && self.mouse-y < line-scroll.height;
                        }
                    }
                    if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up) {
                        if (DragUi.kind == 5) {
                            // Esc ou soltar fora da faixa: desiste.
                            if (!DragUi.cancel && root.seq-inside) {
                                root.seq-drop(root.seq-row, root.seq-x);
                            }
                            DragUi.kind = 0;
                            DragUi.cancel = false;
                            root.seq-row = -1;
                        } else {
                            root.go-to(t.spread);
                        }
                        root.focus-main();
                    }
                }
            }
            Rectangle {
                visible: t.cut;
                cut-touch := TouchArea {
                    mouse-cursor: ew-resize;
                    pointer-event(e) => {
                        if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                            DragUi.press-x = self.absolute-position.x + self.mouse-x;
                        }
                        if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up) {
                            let dx = self.absolute-position.x + self.mouse-x - DragUi.press-x;
                            root.cut-moved(t.spread, round(dx / 48px));
                            root.focus-main();
                        }
                    }
                }
                Rectangle {
                    x: 5px;
                    width: 4px;
                    border-radius: Radius.hair;
                    background: cut-touch.has-hover || cut-touch.pressed ? Theme.text-strong : Theme.text-2;
                }
            }
        }
        if keys.has-focus && root.mark.row >= 0: FocusRing {
            x: root.mark.x - 2px;
            y: 4px;
            width: 50px;
            height: line-scroll.height - 8px;
            shown: true;
        }
        // Fora do `for` (spec RL, regra 31): a linha de onde a foto entra e a miniatura levantada.
        if root.seq-on && root.seq-inside: Rectangle {
            x: root.seq-marker(root.seq-x) - 1.5px;
            y: 2px;
            width: 3px;
            height: line-scroll.height - 4px;
            border-radius: Radius.hair;
            background: Theme.text-strong;
        }
        if root.seq-on: Image {
            accessible-role: none;
            x: root.seq-x - 22px;
            y: 7px;
            width: 44px;
            height: 44px;
            source: root.seq-img;
            image-fit: contain;
            opacity: root.seq-inside ? 0.85 : 0.4;
        }
    }
    // Perto das bordas, a faixa rola sozinha com a foto levantada; o ponteiro fica parado na tela.
    Timer {
        interval: 16ms;
        running: root.seq-on && (root.seq-view-x < 40px || root.seq-view-x > line-scroll.visible-width - 40px);
        triggered => {
            let step = root.seq-view-x < 40px ? 8px : -8px;
            let to = max(line-scroll.visible-width - RollUi.line-w, min(0px, line-scroll.content-x + step));
            root.seq-x = root.seq-x - (to - line-scroll.content-x);
            line-scroll.content-x = to;
        }
    }
}
