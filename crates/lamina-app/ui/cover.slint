// A capa na janela (spec CA): a caixa "Medidas da capa" e o item da capa na faixa. Só desenho: as
// contas ficam no `lamina-editor::cover_form` e o Rust preenche o `CoverUi`.

import { ComboBox } from "std-widgets.slint";
import { Theme, Type, Radius, Space } from "theme.slint";
import { DialogButton, FilterTab, Dialog, DialogBody, DialogFooter, Field, CheckRow } from "widgets.slint";
import { NumberField } from "number_field.slint";
import { SpreadCanvas, SpreadData } from "canvas.slint";
import { DragUi } from "drag.slint";

export global CoverUi {
    // A capa aberta.
    in property <bool> on;
    // O item da faixa.
    in property <bool> has-cover;
    in property <SpreadData> tile;
    in property <float> tile-aspect: 0.5;
    // O atalho do rolo, na lâmina 1: "← Capa" ou "Criar a capa".
    in property <string> roll-pill;
    callback tile-clicked();
    callback tile-double-clicked();
    callback tile-dropped(int);
    callback pill-clicked();

    // A caixa.
    in-out property <bool> open;
    in property <bool> creating;
    in-out property <int> tab;
    in-out property <string> face-width;
    in-out property <string> face-height;
    in-out property <bool> spine-auto;
    in-out property <string> sheet;
    in-out property <string> spine;
    in-out property <string> wrap;
    in-out property <string> safe;
    in-out property <string> total-width;
    in-out property <string> total-height;
    in-out property <bool> includes-wrap;
    in-out property <string> guide-width;
    in property <string> guide-name;
    in property <bool> needs-guide-width;
    in property <string> error;
    in property <string> summary;
    in property <string> warnings;
    in property <float> draw-aspect: 2;
    in property <float> back-x;
    in property <float> back-y;
    in property <float> back-w;
    in property <float> back-h;
    in property <float> spine-x;
    in property <float> spine-w;
    in property <float> front-x;
    in property <float> front-w;
    callback changed();
    callback tab-picked(int);
    callback choose-guide();
    callback confirm();
    callback cancel();
}

// O item da capa na faixa de lâminas, fora da rolagem: sempre à mão, antes da lâmina 1.
export component CoverTile inherits VerticalLayout {
    in property <length> thumb: 84px;
    // Fotos arrastadas do painel sobre ele.
    out property <bool> photos-over: DragUi.kind == 1
        && DragUi.x >= box.absolute-position.x && DragUi.x <= box.absolute-position.x + box.width
        && DragUi.y >= box.absolute-position.y && DragUi.y <= box.absolute-position.y + box.height;
    padding-left: 10px;
    padding-right: 6px;
    padding-top: 8px;
    spacing: 4px;
    alignment: start;
    box := Rectangle {
        width: root.thumb / max(0.01, CoverUi.tile-aspect) + 6px;
        height: root.thumb + 6px;
        border-radius: Radius.small;
        border-width: 2px;
        border-color: root.photos-over || CoverUi.on ? Theme.text-strong : Theme.press;
        background: root.photos-over ? Theme.hover : transparent;
        accessible-role: button;
        accessible-label: CoverUi.has-cover ? "Ir para a capa" : "Criar a capa";
        accessible-action-default => { CoverUi.tile-double-clicked(); }
        if CoverUi.has-cover: SpreadCanvas {
            x: 3px;
            y: 3px;
            width: parent.width - 6px;
            height: parent.height - 6px;
            data: CoverUi.tile;
            interactive: false;
        }
        if !CoverUi.has-cover: Text {
            width: parent.width - 8px;
            text: "Solte fotos aqui\npara criar a capa";
            color: Theme.text-2;
            font-size: Type.caption;
            wrap: word-wrap;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        TouchArea {
            clicked => { CoverUi.tile-clicked(); }
            double-clicked => { CoverUi.tile-double-clicked(); }
        }
    }
    Text {
        text: "Capa";
        horizontal-alignment: center;
        color: CoverUi.on ? Theme.text-strong : Theme.text-2;
        font-size: Type.small;
        font-weight: CoverUi.on ? Type.semibold : Type.regular;
    }
}

// O desenho ao vivo da capa aberta, em proporção.
component CoverDrawing inherits Rectangle {
    property <length> w: min(root.width, root.height * CoverUi.draw-aspect);
    property <length> h: self.w / max(0.1, CoverUi.draw-aspect);
    accessible-role: image;
    accessible-label: root.summary-text;
    in property <string> summary-text;
    Rectangle {
        x: (root.width - root.w) / 2;
        y: (root.height - root.h) / 2;
        width: root.w;
        height: root.h;
        background: Theme.press;
        border-radius: Radius.small;
        Rectangle {
            x: CoverUi.back-x * parent.width;
            y: CoverUi.back-y * parent.height;
            width: CoverUi.back-w * parent.width;
            height: CoverUi.back-h * parent.height;
            background: Theme.hover;
            Text { text: "Verso"; color: Theme.text; font-size: Type.small; }
        }
        Rectangle {
            x: CoverUi.spine-x * parent.width;
            y: CoverUi.back-y * parent.height;
            width: CoverUi.spine-w * parent.width;
            height: CoverUi.back-h * parent.height;
            background: Theme.line;
        }
        Rectangle {
            x: CoverUi.front-x * parent.width;
            y: CoverUi.back-y * parent.height;
            width: CoverUi.front-w * parent.width;
            height: CoverUi.back-h * parent.height;
            background: Theme.hover;
            Text { text: "Frente"; color: Theme.text; font-size: Type.small; }
        }
    }
}

// Uma linha da caixa: o rótulo mais largo pede 200 px, para os campos ficarem na mesma coluna.
component CoverRow inherits Field {
    label-width: 200px;
}

// Um campo de medida: cada mudança refaz as contas, e Enter aciona o principal (spec DD, regra 10).
component CoverNumber inherits NumberField {
    minimum: 0;
    input-type: decimal;
    edited => { CoverUi.changed(); }
    accepted => {
        if (CoverUi.error == "") {
            CoverUi.confirm();
        }
    }
}

// O primeiro campo de cada aba recebe o foco ao abrir (spec DD, regra 7).
component FirstCoverNumber inherits CoverNumber {
    init => { self.focus(); }
}

// A medida total recebe o foco só na aba dela; no arquivo-guia, ele vai para "Escolher arquivo…".
component TotalWidth inherits CoverNumber {
    init => {
        if (CoverUi.tab == 1) {
            self.focus();
        }
    }
}

// Os campos que a medida total e o arquivo-guia dividem.
component TotalFields inherits VerticalLayout {
    spacing: Space.s3;
    CoverRow {
        label: "Total (largura × altura, cm)";
        TotalWidth { width: 104px; text <=> CoverUi.total-width; }
        CoverNumber { width: 104px; text <=> CoverUi.total-height; }
    }
    CheckRow {
        text: "O total já inclui a dobra";
        checked <=> CoverUi.includes-wrap;
        toggled => { CoverUi.changed(); }
    }
    CoverRow {
        label: "Lombada (cm)";
        CoverNumber { text <=> CoverUi.spine; }
    }
}

export component CoverDialog inherits Dialog {
    title: CoverUi.creating ? "Criar a capa" : "Medidas da capa";
    // A capa mantém a largura que o desenho pede (spec DD, regra 2).
    size: 820px;
    child-focus: true;
    dismissed => { CoverUi.cancel(); }
    confirmed => {
        if (CoverUi.error == "") {
            CoverUi.confirm();
        }
    }
    DialogBody {
        HorizontalLayout {
            spacing: Space.s1;
            alignment: start;
            FilterTab { text: "Calcular pelo álbum"; active: CoverUi.tab == 0; clicked => { CoverUi.tab-picked(0); } }
            FilterTab { text: "Medida total do laboratório"; active: CoverUi.tab == 1; clicked => { CoverUi.tab-picked(1); } }
            FilterTab { text: "Arquivo-guia"; active: CoverUi.tab == 2; clicked => { CoverUi.tab-picked(2); } }
        }
        HorizontalLayout {
            spacing: Space.s4;
            VerticalLayout {
                width: 430px;
                spacing: Space.s3;
                alignment: start;
                if CoverUi.tab == 0: CoverRow {
                    label: "Face (largura × altura, cm)";
                    FirstCoverNumber { width: 104px; text <=> CoverUi.face-width; }
                    CoverNumber { width: 104px; text <=> CoverUi.face-height; }
                }
                if CoverUi.tab == 0: CheckRow {
                    text: "Calcular a lombada pelo álbum";
                    checked <=> CoverUi.spine-auto;
                    toggled => { CoverUi.changed(); }
                }
                if CoverUi.tab == 0 && CoverUi.spine-auto: CoverRow {
                    label: "Espessura de cada folha (mm)";
                    CoverNumber { text <=> CoverUi.sheet; }
                }
                if CoverUi.tab == 0 && !CoverUi.spine-auto: CoverRow {
                    label: "Lombada (cm)";
                    CoverNumber { text <=> CoverUi.spine; }
                }
                if CoverUi.tab == 2: HorizontalLayout {
                    spacing: Space.s3;
                    DialogButton { text: "Escolher arquivo…"; takes-focus: true; clicked => { CoverUi.choose-guide(); } }
                    Text {
                        text: CoverUi.guide-name != "" ? CoverUi.guide-name : "JPEG, PNG ou TIFF";
                        color: Theme.text-2;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
                if CoverUi.tab == 2 && CoverUi.needs-guide-width: CoverRow {
                    label: "Largura total do guia (cm)";
                    CoverNumber { text <=> CoverUi.guide-width; }
                }
                if CoverUi.tab != 0: TotalFields { }
                CoverRow {
                    label: "Dobra (cm)";
                    CoverNumber { text <=> CoverUi.wrap; }
                }
                CoverRow {
                    label: "Zona segura (cm)";
                    CoverNumber { text <=> CoverUi.safe; }
                }
                if CoverUi.tab == 2: Text {
                    text: "O guia fica por cima da capa, só na tela. Ele não vai para a impressão.";
                    color: Theme.text-2;
                    wrap: word-wrap;
                }
            }
            VerticalLayout {
                spacing: Space.s2;
                alignment: start;
                CoverDrawing { height: 170px; summary-text: CoverUi.summary; }
                Text { text: CoverUi.summary; color: Theme.text; wrap: word-wrap; }
                if CoverUi.warnings != "": Text { text: CoverUi.warnings; color: Theme.warning; wrap: word-wrap; }
            }
        }
        if CoverUi.error != "": Text { text: CoverUi.error; color: Theme.warning; wrap: word-wrap; }
    }
    DialogFooter {
        DialogButton { text: "Cancelar"; clicked => { CoverUi.cancel(); } }
        DialogButton {
            text: CoverUi.creating ? "Criar a capa" : "Aplicar";
            primary: true;
            enabled: CoverUi.error == "";
            clicked => { CoverUi.confirm(); }
        }
    }
}
