// A lâmina desenhada (spec JP, regra 5). Todas as medidas chegam em frações da largura da lâmina
// com a sangria: x de 0 a 1 e y de 0 a `aspect`. O Rust calcula tudo (lamina-editor); aqui só se
// desenha.

export struct BoxData {
    x: float,
    y: float,
    w: float,
    h: float,
}

export struct FrameData {
    x: float,
    y: float,
    w: float,
    h: float,
    // 0 = vazio, 1 = foto, 2 = texto
    kind: int,
    has-img: bool,
    img: image,
    // A foto inteira (ou a imagem do texto), em frações da largura; o quadro recorta (spec MV,
    // regra 7). A parte dentro do quadro é a mesma da impressão.
    px: float,
    py: float,
    pw: float,
    ph: float,
    // A vaga (spec MV, regra 4): o número dela, o quadro que mostra (-1 = saindo), a ordem de
    // desenho e se desliza, se está viva e se acabou de nascer. `photo` muda com a imagem.
    id: int,
    index: int,
    z: float,
    fly: bool,
    live: bool,
    born: bool,
    photo: int,
    missing: bool,
    label: string,
    // Texto vazio (spec TX, regra 4): só o contorno e "Digite o texto", que não saem impressos.
    blank: bool,
    // Cantos (cima-esquerda, cima-direita, baixo-direita, baixo-esquerda) e borda (spec AP).
    tl: float,
    tr: float,
    br: float,
    bl: float,
    bw: float,
    bcolor: color,
    bx: float,
    by: float,
    bww: float,
    bh: float,
    // A opacidade da foto, de 0 a 1 (spec OP): só a foto fica translúcida; a borda e o aviso de
    // foto ausente continuam opacos.
    op: float,
}

export struct SpreadData {
    // O selo da miniatura: "1 pág." nas pontas com página simples (spec DJ, regra 17).
    badge: string,
    aspect: float,
    bg: color,
    bg-right: color,
    trim: BoxData,
    safe-l: BoxData,
    safe-r: BoxData,
    spine-x: float,
    inactive: [BoxData],
    // Páginas em branco de propósito, com o rótulo só de tela (spec PB).
    blank: [BoxData],
    frames: [FrameData],
    warning: bool,
    // Linhas das guias que pegaram no ímã (spec TX, regra 7).
    snaps: [BoxData],
    // O quadro selecionado e o quadro em modo recorte (as vagas não estão na ordem dos quadros).
    selected-box: BoxData,
    cropping-box: BoxData,
}

import { Handles } from "handles.slint";
import { Motion } from "motion.slint";
import { CoverLook } from "cover_look.slint";
import { Theme, Fixed, Type, Radius } from "theme.slint";

// A foto da vaga (spec MV, regra 2): a imagem só troca quando a foto muda (`photo`), não a cada
// mudança de posição; senão a tela sobe a textura de novo e o primeiro quadro atrasa.
component SlotImage inherits Image {
    accessible-role: none;
    in property <image> img;
    in property <int> photo;
    init => {
        self.source = root.img;
    }
    changed photo => {
        self.source = root.img;
    }
    image-fit: fill;
}

// Uma vaga da lâmina (spec MV, regras 4 a 8; ADR 0011, decisões 2 a 4): anima frações da lâmina
// (a conversão para pixels fica fora do `animate`, para redimensionar a janela não animar) e
// desenha a foto inteira recortada pelo quadro, que nunca deforma no meio do caminho.
component Slot inherits Rectangle {
    in property <FrameData> f;
    // Largura da lâmina em pixels.
    in property <length> unit;
    in property <bool> small;
    // Destaque do quadro em modo recorte.
    in property <bool> mark;
    property <float> fx: f.x;
    property <float> fy: f.y;
    property <float> fw: f.w;
    property <float> fh: f.h;
    property <float> ix: f.px;
    property <float> iy: f.py;
    property <float> iw: f.pw;
    property <float> ih: f.ph;
    animate fx, fy, fw, fh, ix, iy, iw, ih {
        duration: Motion.slide-ms * 1ms;
        easing: cubic-bezier(0.2, 0, 0, 1);
        enabled: Motion.on && f.fly;
    }
    // Nasce esmaecida (lendo o alpha antes de mudar, senão não anima) e sai esmaecendo.
    property <bool> is-born;
    property <float> alpha: self.is-born && f.live ? 1 : 0;
    property <float> alpha-seen;
    animate alpha {
        duration: Motion.fade-ms * 1ms;
        enabled: Motion.on && (f.born || !f.live);
    }
    init => {
        self.alpha-seen = self.alpha;
        self.is-born = true;
    }
    opacity: self.alpha;
    x: self.fx * self.unit;
    y: self.fy * self.unit;
    width: self.fw * self.unit;
    height: self.fh * self.unit;
    z: f.z;
    clip: true;
    border-top-left-radius: f.tl * self.unit;
    border-top-right-radius: f.tr * self.unit;
    border-bottom-right-radius: f.br * self.unit;
    border-bottom-left-radius: f.bl * self.unit;
    background: f.kind == 2 || f.has-img ? transparent : Fixed.placeholder;
    // O X do quadro vazio (spec JE, regra 1): só na tela, de canto a canto, recortado pelos
    // cantos; nunca num quadro de foto (carregando ou ausente) nem num texto.
    if f.kind == 0 && !f.has-img: Path {
        width: 100%;
        height: 100%;
        viewbox-width: 1;
        viewbox-height: 1;
        commands: "M0 0 L1 1 M1 0 L0 1";
        stroke: Fixed.paper.with-alpha(0.35);
        stroke-width: root.small ? 1px : 1.5px;
    }
    // O texto muda de imagem a cada edição: vai direto.
    if f.has-img && f.kind == 2: Image {
        accessible-role: none;
        x: (root.ix - root.fx) * root.unit;
        y: (root.iy - root.fy) * root.unit;
        width: root.iw * root.unit;
        height: root.ih * root.unit;
        source: f.img;
        image-fit: fill;
    }
    if f.has-img && f.kind != 2: SlotImage {
        accessible-role: none;
        x: (root.ix - root.fx) * root.unit;
        y: (root.iy - root.fy) * root.unit;
        width: root.iw * root.unit;
        height: root.ih * root.unit;
        img: f.img;
        photo: f.photo;
        opacity: f.op;
    }
    if f.blank && !root.small: Rectangle {
        border-width: 1px;
        border-color: Fixed.placeholder-line;
        Text { text: "Digite o texto"; color: Fixed.placeholder; font-size: Type.small; }
    }
    if f.missing && !root.small: Text {
        width: parent.width - 16px;
        // O que fazer está no próprio quadro (spec RF, regra 8).
        text: "Foto não encontrada\n" + f.label + "\nclique duas vezes para localizar";
        color: Fixed.paper;
        font-size: Type.small;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
    // Borda da foto, no quadro do corte final, para dentro (spec AP, regra 4).
    if f.bw > 0: Rectangle {
        x: (f.bx - f.x) * root.unit;
        y: (f.by - f.y) * root.unit;
        width: f.bww * root.unit;
        height: f.bh * root.unit;
        border-width: f.bw * root.unit;
        border-color: f.bcolor;
        border-top-left-radius: f.tl * root.unit;
        border-top-right-radius: f.tr * root.unit;
        border-bottom-right-radius: f.br * root.unit;
        border-bottom-left-radius: f.bl * root.unit;
    }
    if root.mark: Rectangle {
        border-width: 3px;
        border-color: Fixed.crop;
    }
}

export component SpreadCanvas inherits Rectangle {    in property <SpreadData> data;
    // As vagas. Na lâmina grande vêm de uma propriedade que nunca muda: se viessem de `data`, cada
    // `data` novo sujaria o modelo do `for` até o próximo desenho, e o Slint perde a linha mudada
    // nesse intervalo (spec RL, regra 32).
    in property <[FrameData]> frames: root.data.frames;
    in property <bool> guides;
    // A sombra da dobra (spec DJ, regra 1): só na lâmina grande, só na tela.
    in property <bool> gutter-shadow;
    in property <bool> small;
    // Lâmina grande: quadros clicáveis e arrastáveis (spec FQ).
    in property <bool> interactive;
    in property <int> selected: -1;
    callback frame-down(int, length, length);
    // O quadro, o ponto e a imagem do quadro (o fantasma do arrasto).
    callback frame-move(int, length, length, image);
    // O quadro, o ponto e se Ctrl (ou Cmd) e Shift estavam apertados (seleção no modo organizar).
    callback frame-up(int, length, length, bool, bool);
    // O fundo da lâmina (fora dos quadros): 0 = apertou, 1 = arrastou, 2 = soltou; e o Shift. O
    // laço do modo organizar.
    callback back-press(int, length, length, bool);
    // Recorte (spec RC): o quadro em modo recorte, a prévia da foto inteira e os gestos.
    in property <int> cropping: -1;
    in property <bool> has-preview;
    in property <BoxData> preview;
    in property <image> preview-img;
    callback frame-double(int);
    // Clique direito num quadro (-1 = no fundo), em pixels da janela: o menu de contexto (spec EG).
    // O quadro (-1 = fundo), o ponto na janela e a fração da largura da lâmina.
    callback context(int, length, length, float);
    // A grade do recorte (spec AF): os terços, e a grade fina enquanto o ângulo muda. Só na tela.
    in property <bool> grid-thirds;
    in property <bool> grid-fine;
    callback crop-drag(float, float);
    callback crop-end();
    // Quanto a roda girou, em pixels (um entalhe da roda costuma valer 120).
    callback crop-wheel(float);
    // Quadros à mão (spec TX): segurar uma alça (ou um texto), arrastar e soltar. O último
    // número de `grab` é a largura da lâmina em pixels, para o Rust converter em mm.
    callback grab(int, int, length, length, length);
    callback grab-move(length, length, bool, bool);
    // Modo organizar (spec EG): segurar o corpo de qualquer quadro move o grupo; com Ctrl ou Shift,
    // o clique soma ou tira da seleção. O último número é a largura da lâmina em pixels.
    in property <bool> organizing;
    callback organize-press(int, bool, bool, length, length, length);
    callback grab-end();
    // Onde o mouse está na lâmina, em frações da largura (o T cria o texto naquela página).
    in-out property <float> hover-fx: -1;
    background: root.data.bg;
    clip: true;

    // Fundo da página direita (igual ao da esquerda quando não há fundo por página).
    Rectangle {
        x: root.data.spine-x * root.width;
        width: root.width - self.x;
        height: root.height;
        background: root.data.bg-right;
    }

    if root.interactive: TouchArea {
        changed mouse-x => { root.hover-fx = self.mouse-x / root.width; }
        // Duplo clique no fundo (fora dos quadros) abre o modo organizar (spec EG).
        double-clicked => { root.frame-double(-1); }
        moved => { root.back-press(1, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y, false); }
        pointer-event(e) => {
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                root.context(-1, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y, self.mouse-x / root.width);
            }
            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                root.back-press(0, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y, e.modifiers.shift);
            }
            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up) {
                root.back-press(2, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y, e.modifiers.shift);
            }
        }
    }

    // Prévia do recorte: a foto inteira, apagada, por baixo dos quadros.
    if root.has-preview: Image {
        accessible-role: none;
        x: root.preview.x * root.width;
        y: root.preview.y * root.width;
        width: root.preview.w * root.width;
        height: root.preview.h * root.width;
        source: root.preview-img;
        image-fit: fill;
        opacity: 0.35;
    }

    // As vagas: a foto desliza e esmaece (spec MV); a tela desenha, o editor decide.
    for f in root.frames: Slot {
        f: f;
        unit: root.width;
        small: root.small;
        mark: f.index >= 0 && f.index == root.selected && f.index == root.cropping;
    }

    // Os toques ficam no lugar final do quadro, sem deslizar: um clique no meio de um movimento
    // vale para a posição final (spec MV, regra 13).
    for f in root.frames: TouchArea {
        x: f.x * root.width;
        y: f.y * root.width;
        width: f.w * root.width;
        height: f.h * root.width;
        z: f.z;
        enabled: root.interactive && f.live;
        visible: root.interactive && f.live;
        mouse-cursor: f.kind == 2 || f.has-img ? move : default;
        double-clicked => { root.frame-double(f.index); }
        moved => {
            if (f.kind != 2) {
                root.frame-move(f.index, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y, f.img);
            }
        }
        changed mouse-x => {
            root.hover-fx = (self.absolute-position.x + self.mouse-x - root.absolute-position.x) / root.width;
        }
        pointer-event(e) => {
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                root.context(f.index, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y, 0);
                return;
            }
            // No modo organizar, o corpo de qualquer quadro segura o grupo (nenhuma foto troca de
            // quadro, spec EG, regra 4).
            if (root.organizing) {
                if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                    root.organize-press(f.index, e.modifiers.control || e.modifiers.meta, e.modifiers.shift, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y, root.width);
                }
                if (e.kind == PointerEventKind.move && self.pressed) {
                    root.grab-move(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y, e.modifiers.alt, e.modifiers.shift);
                }
                if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up) {
                    root.grab-end();
                }
                return;
            }
            // O texto não tem foto para arrastar: segurar o corpo dele move o quadro.
            if (f.kind == 2) {
                if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                    root.grab(f.index, 0, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y, root.width);
                }
                if (e.kind == PointerEventKind.move && self.pressed) {
                    root.grab-move(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y, e.modifiers.alt, e.modifiers.shift);
                }
                if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up) {
                    root.grab-end();
                }
                return;
            }
            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                root.frame-down(f.index, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up) {
                root.frame-up(f.index, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y, e.modifiers.control || e.modifiers.meta, e.modifiers.shift);
            }
        }
    }
    // Página sem conteúdo (lâmina de ponta com página simples).
    for b in root.data.inactive: Rectangle {
        // Acima das vagas, que têm a ordem de desenho dos quadros (z).
        z: 1000;
        x: b.x * root.width;
        y: b.y * root.width;
        width: b.w * root.width;
        height: b.h * root.width;
        background: Theme.line;
    }

    // A capa aberta (spec CA, regra 8): o guia do laboratório, as linhas da lombada e os nomes.
    // Só na tela: a exportação não passa por aqui.
    if root.interactive && CoverLook.on: Rectangle {
        z: 1001;
        if CoverLook.guide-on: Image {
            accessible-role: none;
            x: CoverLook.guide-x * root.width;
            y: CoverLook.guide-y * root.width;
            width: CoverLook.guide-w * root.width;
            height: CoverLook.guide-h * root.width;
            source: CoverLook.guide-image;
            image-fit: fill;
            opacity: 0.55;
        }
        for line in [CoverLook.spine-l, CoverLook.spine-r]: Rectangle {
            x: line * root.width;
            y: root.data.trim.y * root.width;
            width: 1px;
            height: root.data.trim.h * root.width;
            background: Theme.accent.with-alpha(0.8);
        }
        for name[i] in [
            { text: "Verso", at: (root.data.trim.x + CoverLook.spine-l) / 2 },
            { text: "Lombada", at: (CoverLook.spine-l + CoverLook.spine-r) / 2 },
            { text: "Frente", at: (CoverLook.spine-r + root.data.trim.x + root.data.trim.w) / 2 },
        ]: Rectangle {
            x: name.at * root.width - self.width / 2;
            y: max(2px, CoverLook.trim-top * root.width / 2 - self.height / 2);
            width: label.preferred-width + 12px;
            height: label.preferred-height + 4px;
            border-radius: Radius.small;
            background: Theme.panel;
            label := Text { text: name.text; color: Theme.text; font-size: Type.caption; }
        }
    }

    // O rótulo da página em branco, só na tela (spec PB): a exportação não passa por aqui.
    if root.interactive: Rectangle {
        z: 1000;
        for b in root.data.blank: Text {
            x: b.x * root.width;
            y: b.y * root.width;
            width: b.w * root.width;
            height: b.h * root.width;
            text: "Página em branco";
            color: Theme.text-2;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // A sombra da dobra: 7% da largura, no máximo 10% no centro.
    if root.gutter-shadow: Rectangle {
        z: 999;
        x: (root.data.spine-x - 0.035) * root.width;
        width: 0.07 * root.width;
        height: root.height;
        background: @linear-gradient(90deg, Fixed.ink.with-alpha(0) 0%, Fixed.ink.with-alpha(0.1) 50%, Fixed.ink.with-alpha(0) 100%);
    }

    // Lombada. Na capa aberta, ela tem duas linhas próprias (spec CA, regra 8).
    if !(root.interactive && CoverLook.on): Rectangle {
        // Acima das vagas, que têm a ordem de desenho dos quadros (z).
        z: 1000;
        x: root.data.spine-x * root.width;
        width: 1px;
        height: root.height;
        background: Fixed.ink.with-alpha(0.25);
    }

    if root.guides && !root.small: Rectangle {
        // Acima das vagas, que têm a ordem de desenho dos quadros (z).
        z: 1000;
        // Faixa de sangria escurecida (o que fica fora do corte).
        Rectangle {
            x: 0;
            y: 0;
            width: root.width;
            height: root.data.trim.y * root.width;
            background: Fixed.ink.with-alpha(0.4);
        }
        Rectangle {
            x: 0;
            y: (root.data.trim.y + root.data.trim.h) * root.width;
            width: root.width;
            height: root.height - self.y;
            background: Fixed.ink.with-alpha(0.4);
        }
        Rectangle {
            x: 0;
            y: root.data.trim.y * root.width;
            width: root.data.trim.x * root.width;
            height: root.data.trim.h * root.width;
            background: Fixed.ink.with-alpha(0.4);
        }
        Rectangle {
            x: (root.data.trim.x + root.data.trim.w) * root.width;
            y: root.data.trim.y * root.width;
            width: root.width - self.x;
            height: root.data.trim.h * root.width;
            background: Fixed.ink.with-alpha(0.4);
        }
        // Zona segura de cada página.
        for b in [root.data.safe-l, root.data.safe-r]: Rectangle {
            x: b.x * root.width;
            y: b.y * root.width;
            width: b.w * root.width;
            height: b.h * root.width;
            border-width: 1px;
            border-color: Fixed.margin;
        }
    }

    // Linhas do ímã durante o gesto.
    for b in root.data.snaps: Rectangle {
        // Acima das vagas, que têm a ordem de desenho dos quadros (z).
        z: 1000;
        x: b.x * root.width;
        y: b.y * root.width;
        width: max(1px, b.w * root.width);
        height: max(1px, b.h * root.width);
        background: Fixed.guide;
    }

    // Alças do quadro selecionado (fora do modo recorte).
    if root.interactive && !root.small && root.cropping < 0 && root.selected >= 0: Handles {
        // Acima das vagas, que têm a ordem de desenho dos quadros (z).
        z: 1000;
        fx: root.data.selected-box.x * root.width;
        fy: root.data.selected-box.y * root.width;
        fw: root.data.selected-box.w * root.width;
        fh: root.data.selected-box.h * root.width;
        grab(n, x, y) => { root.grab(root.selected, n, x, y, root.width); }
        drag(x, y, alt, shift) => { root.grab-move(x, y, alt, shift); }
        release => { root.grab-end(); }
    }

    if root.cropping >= 0 && root.grid-thirds: Rectangle {
        z: 1000;
        x: root.data.cropping-box.x * root.width;
        y: root.data.cropping-box.y * root.width;
        width: root.data.cropping-box.w * root.width;
        height: root.data.cropping-box.h * root.width;
        for _[i] in root.grid-fine ? 11 : 0: Rectangle {
            x: parent.width * (i + 1) / 12;
            width: 1px;
            background: Fixed.paper.with-alpha(0.25);
        }
        for _[i] in root.grid-fine ? 11 : 0: Rectangle {
            y: parent.height * (i + 1) / 12;
            height: 1px;
            background: Fixed.paper.with-alpha(0.25);
        }
        for _[i] in 2: Rectangle {
            x: parent.width * (i + 1) / 3;
            width: 1px;
            background: Fixed.paper.with-alpha(0.69);
        }
        for _[i] in 2: Rectangle {
            y: parent.height * (i + 1) / 3;
            height: 1px;
            background: Fixed.paper.with-alpha(0.69);
        }
    }

    // Quadro em modo recorte: por cima de tudo (inclusive das guias, que senão ficam com a roda
    // do mouse), recebe o arrasto e a roda (spec RC).
    if root.cropping >= 0: TouchArea {
        // Acima das vagas, que têm a ordem de desenho dos quadros (z).
        z: 1000;
        property <length> last-x;
        property <length> last-y;
        x: root.data.cropping-box.x * root.width;
        y: root.data.cropping-box.y * root.width;
        width: root.data.cropping-box.w * root.width;
        height: root.data.cropping-box.h * root.width;
        mouse-cursor: move;
        scroll-event(e) => {
            root.crop-wheel(e.delta-y / 1px);
            accept
        }
        moved => {
            root.crop-drag((self.mouse-x - self.last-x) / self.width, (self.mouse-y - self.last-y) / self.height);
            self.last-x = self.mouse-x;
            self.last-y = self.mouse-y;
        }
        pointer-event(e) => {
            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                self.last-x = self.mouse-x;
                self.last-y = self.mouse-y;
            }
            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up) {
                root.crop-end();
            }
        }
    }
}
