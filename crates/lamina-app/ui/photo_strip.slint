// O painel de fotos em grade (spec PF): as fotos da aba em linhas de N peças, que rolam para baixo.
// Só as linhas visíveis existem: cada vaga mostra sempre a linha de mesmo resto (linha mod vagas),
// então rolar uma linha troca só a vaga que entra (regra 2). Arrastar uma peça leva a foto (ou a
// seleção); arrastar no vão faz o laço; Ctrl+roda é o zoom. As contas são do editor
// (`lamina_editor::photo_grid`), pelo Rust; aqui, o desenho e o gesto.

import { Theme, Type, Radius } from "theme.slint";
import { Icons } from "icons.slint";
import { Motion } from "motion.slint";
import { StripTheme } from "strip_header.slint";
import { DragUi } from "drag.slint";
import { PhotoMenuUi } from "photo_menu.slint";

export struct PhotoData {
    img: image,
    name: string,
    uses: int,
    selected: bool,
    // A proporção da foto (largura / altura; 0 = sem tamanho) e se já está usada, na aba Todas
    // (esmaecida). A posição na lista é a da peça na grade (linha × colunas + coluna): guardada
    // aqui, ficaria velha quando o Rust só insere ou remove linhas.
    aspect: float,
    dim: bool,
    // A foto não está onde estava: a marca âmbar; o duplo clique localiza (spec RF, regra 8).
    missing: bool,
}

// O que outras partes da janela leem da grade: a divisória sendo arrastada (a lâmina acompanha
// sem animar; regra 6).
export global PhotoGridUi {
    in-out property <bool> resizing;
}

// Uma peça: a miniatura inteira dentro do quadrado (a horizontal ocupa a largura, a vertical a
// altura), o nome embaixo e o selo de usos. Antes da miniatura chegar, um retângulo neutro na
// proporção da foto; ela entra esmaecendo (spec MV).
component PhotoTile inherits Rectangle {
    in property <PhotoData> data;
    in property <int> index;
    in property <length> tile;
    in property <bool> named;
    // Na seleção (ou cruzada pelo laço) e a foto dos dados do painel.
    in property <bool> lit;
    in property <bool> current;
    callback pressed(int, bool, bool);
    callback double-clicked(int);
    callback dropped();
    // A roda sobre a peça vai para a grade (posição na janela, para o zoom pela Ctrl+roda).
    callback wheel(length, bool, length, length);
    callback focus-main();
    height: root.tile + (root.named ? 18px : 0px);
    border-radius: Radius.small;
    // Para o leitor de tela, a peça é um item só, com o nome da foto: a miniatura, o nome e o
    // selo por dentro ficam fora da árvore (spec RL, regra 30).
    accessible-role: list-item;
    accessible-label: root.data.uses > 0 ? root.data.name + ", usada " + root.data.uses + "×" : root.data.name;
    background: root.lit ? Theme.accent-soft : root.current ? Theme.press : transparent;

    property <bool> arrived: root.data.img.width > 0;
    property <float> faded: root.data.dim ? 0.45 : 1;
    property <length> pw: root.data.aspect <= 0 || root.data.aspect >= 1 ? root.tile : root.tile * root.data.aspect;
    property <length> ph: root.data.aspect <= 0 ? root.tile : root.data.aspect >= 1 ? root.tile / root.data.aspect : root.tile;
    Rectangle {
        x: (root.tile - root.pw) / 2;
        y: (root.tile - root.ph) / 2;
        width: root.pw;
        height: root.ph;
        background: Theme.g6;
        opacity: root.arrived ? 0 : root.faded;
    }
    Image {
        accessible-role: none;
        x: (root.tile - root.pw) / 2;
        y: (root.tile - root.ph) / 2;
        width: root.pw;
        height: root.ph;
        source: root.data.img;
        image-fit: contain;
        opacity: root.arrived ? root.faded : 0;
        animate opacity { duration: Motion.on ? Motion.fade-ms * 1ms : 0ms; }
    }
    if root.named: Text {
        accessible-role: none;
        x: 4px;
        y: root.tile;
        width: root.tile - 36px;
        height: 18px;
        text: root.data.name;
        color: Theme.text-2;
        font-size: Type.caption;
        vertical-alignment: center;
        overflow: elide;
    }
    if root.data.missing: Rectangle {
        x: 4px;
        y: 4px;
        width: 18px;
        height: 18px;
        border-radius: self.height / 2;
        background: Theme.warning;
        Text {
            accessible-role: none;
            text: "!";
            color: Theme.g1;
            font-size: Type.small;
            font-weight: Type.semibold;
        }
    }
    // O selo de usos: na linha do nome; sem nome, sobre o canto da miniatura.
    if root.data.uses > 0: Rectangle {
        x: root.tile - self.width - 2px;
        y: root.named ? root.tile + 1px : 2px;
        width: badge.preferred-width + 8px;
        height: 16px;
        border-radius: Radius.small;
        background: root.named ? transparent : Theme.shadow-strong;
        badge := Text {
            accessible-role: none;
            text: "×" + root.data.uses;
            color: Theme.text;
            font-size: Type.caption;
        }
    }
    if root.lit: Rectangle {
        border-radius: Radius.small;
        border-width: 2px;
        border-color: Theme.accent;
    }
    TouchArea {
        double-clicked => { root.double-clicked(root.index); }
        scroll-event(e) => {
            if (e.delta-y == 0) {
                return reject;
            }
            root.wheel(e.delta-y, e.modifiers.control || e.modifiers.meta, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            accept
        }
        moved => {
            let x = self.absolute-position.x + self.mouse-x;
            let y = self.absolute-position.y + self.mouse-y;
            if (DragUi.kind == 0 && DragUi.far(x, y)) {
                DragUi.kind = 1;
                DragUi.from = root.index;
                DragUi.img = root.data.img;
            }
            DragUi.x = x;
            DragUi.y = y;
        }
        pointer-event(e) => {
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) {
                // Botão direito numa foto fora da seleção seleciona só ela (spec TF, regra 1).
                if (!root.lit) {
                    root.pressed(root.index, false, false);
                }
            }
            // O menu abre ao soltar, o mesmo da lâmina (spec DC, regra 1; TF-B10).
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                PhotoMenuUi.menu-at(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                DragUi.press-x = self.absolute-position.x + self.mouse-x;
                DragUi.press-y = self.absolute-position.y + self.mouse-y;
            }
            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up) {
                if (DragUi.kind == 1) {
                    root.dropped();
                } else {
                    root.pressed(root.index, e.modifiers.control || e.modifiers.meta, e.modifiers.shift);
                }
                DragUi.kind = 0;
                root.focus-main();
            }
        }
    }
}

export component PhotoGrid inherits Rectangle {
    in property <[PhotoData]> photos;
    in property <int> selected-photo: -1;
    // Colunas e zoom vêm do editor; a rolagem é da janela (o Rust a põe de volta na mesma foto).
    in property <int> columns: 1;
    in property <int> zoom: 96;
    in-out property <length> scroll;
    // Quanto o laço rola por quadro com o ponteiro em `y` (editor, regra 9).
    pure callback lasso-speed(length, length) -> length;
    callback view-changed(length, length, length);
    callback zoom-wheel(bool, length, length);
    callback lasso-done(length, length, length, length, bool);
    callback photo-double-clicked(int);
    callback photo-pressed(int, bool, bool);
    // Uma foto foi solta fora do painel: a janela calcula onde.
    callback dropped();
    callback focus-main();
    background: StripTheme.photos;
    clip: true;

    property <length> gap: 8px;
    property <length> tile: max(1px, min(root.zoom * 1px, root.width - 2 * root.gap));
    property <bool> named: root.zoom >= 96;
    property <length> row-h: root.tile + root.gap + (root.named ? 18px : 0px);
    property <int> rows: ceil(root.photos.length / max(1, root.columns));
    property <length> max-scroll: max(0px, root.rows * root.row-h + root.gap - root.height);
    property <int> first-row: max(0, floor(root.scroll / root.row-h));
    property <int> slots: min(root.rows, ceil(root.height / root.row-h) + 1);

    function notify() {
        root.view-changed(root.width, root.height, root.scroll);
    }
    init => { root.notify(); }
    changed width => { root.notify(); }
    changed height => { root.notify(); }
    changed scroll => { root.notify(); }
    changed max-scroll => {
        if (root.scroll > root.max-scroll) {
            root.scroll = root.max-scroll;
        }
    }

    // A roda rola suave (spec MV, regra 10), pelo relógio; giros seguidos somam. O Timer de
    // reserva encerra o relógio se ele ficar preso (spike G0 do rolo).
    property <bool> sc-running;
    property <duration> sc-t0;
    property <length> sc-from;
    property <length> sc-to;
    property <float> sc-p: self.sc-running ? min(1, (animation-tick() - self.sc-t0) / max(1ms, Motion.scroll-ms * 1ms)) : 1;
    changed sc-p => {
        if (self.sc-running) {
            root.scroll = self.sc-from + (self.sc-to - self.sc-from) * (1 - pow(1 - self.sc-p, 3));
            if (self.sc-p >= 1) {
                self.sc-running = false;
            }
        }
    }
    Timer {
        interval: 50ms;
        running: root.sc-running;
        triggered => {
            if (animation-tick() - root.sc-t0 > Motion.scroll-ms * 1ms + 50ms) {
                root.scroll = root.sc-to;
                root.sc-running = false;
            }
        }
    }
    function wheel(dy: length) {
        let base = root.sc-running ? root.sc-to : root.scroll;
        let target = max(0px, min(root.max-scroll, base - dy));
        if (Motion.on && Motion.scroll-ms > 0) {
            root.sc-from = root.scroll;
            root.sc-to = target;
            root.sc-t0 = animation-tick();
            root.sc-running = true;
        } else {
            root.scroll = target;
        }
    }

    // O laço: o canto onde começou (no conteúdo, com a rolagem) e o ponteiro (no painel).
    property <bool> lassoing;
    property <bool> lasso-moved;
    property <bool> lasso-add;
    property <length> lx0;
    property <length> ly0;
    property <length> lx1;
    property <length> lpy;
    property <length> lasso-step: root.lassoing && root.lasso-moved ? root.lasso-speed(root.lpy, root.height) : 0px;
    pure function crosses(row: int, column: int) -> bool {
        let left = root.gap + column * (root.tile + root.gap);
        let top = row * root.row-h + root.gap;
        let y1 = root.lpy + root.scroll;
        max(root.lx0, root.lx1) > left && min(root.lx0, root.lx1) < left + root.tile
            && max(root.ly0, y1) > top && min(root.ly0, y1) < (row + 1) * root.row-h
    }
    Timer {
        interval: 16ms;
        running: root.lasso-step != 0px;
        triggered => {
            root.scroll = max(0px, min(root.max-scroll, root.scroll + root.lasso-step));
        }
    }

    // Por baixo das peças: a roda, a Ctrl+roda e o laço (o vão e o fundo da grade).
    TouchArea {
        scroll-event(e) => {
            if (e.modifiers.control || e.modifiers.meta) {
                if (e.delta-y != 0) {
                    root.zoom-wheel(e.delta-y > 0, self.mouse-x, self.mouse-y);
                }
                return accept;
            }
            if (e.delta-y != 0) {
                root.wheel(e.delta-y);
                return accept;
            }
            reject
        }
        pointer-event(e) => {
            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                root.sc-running = false;
                root.lassoing = true;
                root.lasso-moved = false;
                root.lasso-add = e.modifiers.control || e.modifiers.meta || e.modifiers.shift;
                root.lx0 = self.mouse-x;
                root.ly0 = self.mouse-y + root.scroll;
                root.lx1 = self.mouse-x;
                root.lpy = self.mouse-y;
            }
            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up && root.lassoing) {
                root.lassoing = false;
                // Um clique no vão, sem arrastar, não muda nada.
                if (root.lasso-moved) {
                    root.lasso-done(root.lx0, root.ly0, root.lx1, root.lpy + root.scroll, root.lasso-add);
                }
                root.focus-main();
            }
        }
        moved => {
            if (root.lassoing) {
                root.lx1 = self.mouse-x;
                root.lpy = self.mouse-y;
                root.lasso-moved = root.lasso-moved || abs(self.mouse-x - root.lx0) > 4px || abs(self.mouse-y + root.scroll - root.ly0) > 4px;
            }
        }
    }

    for k in root.slots: Rectangle {
        property <int> line: root.first-row + Math.mod(Math.mod(k - root.first-row, root.slots) + root.slots, root.slots);
        y: self.line * root.row-h - root.scroll;
        width: root.width;
        height: root.row-h;
        visible: self.line < root.rows;
        for c in root.columns: PhotoTile {
            property <int> i: parent.line * root.columns + c;
            x: root.gap + c * (root.tile + root.gap);
            y: root.gap;
            width: root.tile;
            visible: self.i < root.photos.length;
            data: root.photos[self.i];
            index: self.i;
            tile: root.tile;
            named: root.named;
            lit: root.lassoing && root.lasso-moved
                ? (root.crosses(parent.line, c) || (root.lasso-add && self.data.selected))
                : self.data.selected;
            current: self.i == root.selected-photo;
            pressed(i, ctrl, shift) => { root.photo-pressed(i, ctrl, shift); }
            double-clicked(i) => { root.photo-double-clicked(i); }
            dropped => { root.dropped(); }
            wheel(dy, ctrl, ax, ay) => {
                if (ctrl) {
                    root.zoom-wheel(dy > 0, ax - root.absolute-position.x, ay - root.absolute-position.y);
                } else {
                    root.wheel(dy);
                }
            }
            focus-main => { root.focus-main(); }
        }
    }

    if root.lassoing && root.lasso-moved: Rectangle {
        x: min(root.lx0, root.lx1);
        y: min(root.ly0 - root.scroll, root.lpy);
        width: abs(root.lx1 - root.lx0);
        height: abs(root.lpy + root.scroll - root.ly0);
        background: Theme.accent-soft;
        border-width: 1px;
        border-color: Theme.accent;
    }

    if root.photos.length == 0: Text {
        text: "Nenhuma foto ainda. Use + Fotos ou arraste fotos do Explorador.";
        color: Theme.text-2;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}
