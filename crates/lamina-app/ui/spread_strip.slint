// Faixa de lâminas (spec PN): a atual com contorno claro e o número embaixo de cada uma. Arrastar
// uma lâmina muda a ordem; fotos do navegador soltas num vão viram uma lâmina nova (spec IM).

import { ScrollView } from "std-widgets.slint";
import { Theme, Type, Radius } from "theme.slint";
import { Icons } from "icons.slint";
import { SpreadCanvas, SpreadData } from "canvas.slint";
import { Motion } from "motion.slint";
import { StripTheme } from "strip_header.slint";
import { DragUi } from "drag.slint";
import { RollUi } from "roll.slint";
import { FocusRing } from "widgets.slint";

export component SpreadStrip inherits Rectangle {
    in property <[SpreadData]> spreads;
    // A altura do desenho da miniatura (spec DJ, regra 12).
    in property <length> thumb: 84px;
    in property <int> current-index;
    in property <float> current-aspect;
    callback go-to(int);
    // A lâmina arrastada e o vão onde ela foi solta (0 = antes da primeira).
    callback move-spread(int, int);
    // As contas do arrasto, pelas larguras reais (spec FX, regras 1 a 4; `motion::strip_drag`):
    // o vão para o meio da miniatura levantada, quanto cada vizinha corre, onde a levantada pousa
    // e a velocidade da rolagem perto das bordas.
    pure callback strip-gap(int, length) -> int;
    pure callback strip-shift(int, int, int) -> length;
    pure callback strip-landing(int, int) -> length;
    pure callback strip-edge(length, length) -> length;
    // O vão mais perto do ponteiro para as fotos arrastadas do navegador (spec IM).
    function gap() -> int {
        let item = root.thumb / max(0.01, root.current-aspect) + 16px;
        let at = (DragUi.x - strip-scroll.absolute-position.x - strip-scroll.content-x - 10px) / item;
        max(0, min(root.spreads.length, round(at)))
    }
    callback focus-main();
    // A miniatura levantada (spec FX, regras 1 a 6): onde o ponteiro a pegou, o pouso e o vão de
    // agora, na fileira (sem o recuo de 10 px da borda).
    property <length> grab-dx;
    property <length> grab-dy;
    property <bool> landing;
    property <bool> snap;
    property <int> drop-gap: -1;
    property <length> lift-w: DragUi.kind == 3 && DragUi.from >= 0 && DragUi.from < root.spreads.length
        ? root.thumb / max(0.01, root.spreads[DragUi.from].aspect) + 6px : 0px;
    property <length> lift-x: DragUi.x - strip-scroll.absolute-position.x - strip-scroll.content-x - 10px - root.grab-dx;
    property <int> live-gap: DragUi.kind != 3 ? -1
        : root.landing ? root.drop-gap : root.strip-gap(DragUi.from, root.lift-x + root.lift-w / 2);
    // Soltar: a levantada pousa no vão e só então a ordem muda; fora da faixa (ou Esc), volta.
    function release(inside: bool) {
        root.drop-gap = inside ? root.live-gap : DragUi.from;
        root.landing = true;
        land-timer.running = true;
    }
    land-timer := Timer {
        interval: max(1ms, Motion.reorder-ms * 1ms);
        running: false;
        triggered => {
            self.running = false;
            let from = DragUi.from;
            let gap = root.drop-gap;
            // O desenho final é o do último quadro: as vizinhas param de correr sem animar.
            root.snap = true;
            DragUi.kind = 0;
            root.landing = false;
            if (gap != from && gap != from + 1) {
                root.move-spread(from, gap);
            }
            unsnap.running = true;
            root.focus-main();
        }
    }
    unsnap := Timer {
        interval: 16ms;
        running: false;
        triggered => {
            self.running = false;
            root.snap = false;
        }
    }
    property <bool> cancel-asked: DragUi.cancel;
    changed cancel-asked => {
        if (DragUi.cancel) {
            DragUi.cancel = false;
            if (DragUi.kind == 3 && !root.landing) {
                root.release(false);
            }
        }
    }
    // Perto das bordas, a faixa rola sozinha (regra 4).
    Timer {
        interval: 16ms;
        running: DragUi.kind == 3 && !root.landing;
        triggered => {
            let speed = root.strip-edge(DragUi.x - strip-scroll.absolute-position.x, strip-scroll.visible-width);
            if (speed != 0px) {
                root.sc-running = false;
                strip-scroll.content-x = max(strip-scroll.visible-width - strip.preferred-width, min(0px, strip-scroll.content-x - speed * 0.016));
            }
        }
    }
    // Fotos arrastadas do navegador sobre a faixa (spec IM, regra 7): o vão onde a lâmina nova
    // entraria (o número de lâminas = a área de lâmina nova, no fim); -1 fora da faixa.
    pure function over() -> bool {
        DragUi.x >= root.absolute-position.x && DragUi.x <= root.absolute-position.x + root.width
            && DragUi.y >= root.absolute-position.y && DragUi.y <= root.absolute-position.y + root.height
    }
    out property <int> photo-gap: DragUi.kind == 1 && root.over() ? root.gap() : -1;
    // A foto de um quadro arrastada sobre uma miniatura (spec ML, regra 11): a lâmina dela e o ponto
    // em frações da largura, para a janela soltar ali; o destino acende na miniatura.
    property <length> item: root.thumb / max(0.01, root.current-aspect) + 16px;
    property <length> rel-x: DragUi.x - strip-scroll.absolute-position.x - strip-scroll.content-x - 10px;
    property <int> body: DragUi.kind == 2 && root.over() ? floor(root.rel-x / root.item) : -1;
    property <length> in-x: root.rel-x - root.body * root.item - 3px;
    property <length> in-y: DragUi.y - strip-scroll.absolute-position.y - 8px - 3px;
    property <length> thumb-w: root.item - 22px;
    property <int> over-spread: root.body >= 0 && root.body < root.spreads.length && root.in-x >= 0 && root.in-x <= root.thumb-w && root.in-y >= 0 && root.in-y <= root.thumb ? root.body : -1;
    changed over-spread => { RollUi.strip-spread = self.over-spread; }
    changed in-x => { RollUi.strip-fx = self.in-x / max(1px, self.thumb-w); }
    changed in-y => { RollUi.strip-fy = self.in-y / max(1px, self.thumb-w); }
    // O ponteiro sobre a área de lâmina nova (fotos soltas do Explorador; regra 11).
    out property <bool> new-hover: new-touch.has-hover;
    background: StripTheme.spreads;

    // A lâmina atual fica visível na faixa (spec JP, regra 7): se saiu da área vista, a faixa
    // rola até deixá-la no meio.
    changed current-index => {
        if (root.current-aspect <= 0) {
            return;
        }
        let item = root.thumb / root.current-aspect + 6px + 10px;
        let left = 10px + root.current-index * item;
        let shown = strip-scroll.visible-width;
        if (left + strip-scroll.content-x < 0px || left + item + strip-scroll.content-x > shown) {
            root.follow(max(min(0px, shown / 2 - left - item / 2), shown - strip.preferred-width));
        }
    }

    // Rolagem suave pelo relógio (spec MV, regra 10; ADR 0011, decisão 6): a barra continua
    // respondendo na hora e rolar à mão para o acompanhamento.
    property <bool> sc-running;
    property <duration> sc-t0;
    property <length> sc-from;
    property <length> sc-to;
    property <float> sc-p: self.sc-running ? min(1, (animation-tick() - self.sc-t0) / max(1ms, Motion.scroll-ms * 1ms)) : 1;
    changed sc-p => {
        if (self.sc-running) {
            strip-scroll.content-x = self.sc-from + (self.sc-to - self.sc-from) * (1 - pow(1 - self.sc-p, 3));
            if (self.sc-p >= 1) {
                self.sc-running = false;
            }
        }
    }
    function follow(target: length) {
        if (Motion.on && Motion.scroll-ms > 0) {
            root.sc-from = strip-scroll.content-x;
            root.sc-to = target;
            root.sc-t0 = animation-tick();
            root.sc-running = true;
        } else {
            strip-scroll.content-x = target;
        }
    }
    // A roda vertical rola a faixa; giros seguidos somam ao destino anterior.
    function wheel(dy: length) {
        let base = root.sc-running ? root.sc-to : strip-scroll.content-x;
        root.follow(max(strip-scroll.visible-width - strip.preferred-width, min(0px, base + dy)));
    }

    // Uma parada de Tab (spec DD, regra 28): o anel fica na lâmina atual, e ← → seguem até a janela,
    // que já troca de lâmina.
    accessible-role: AccessibleRole.list;
    accessible-label: "Lâminas";
    keys := FocusScope {
        x: 0;
        width: 0;
    }

    strip-scroll := ScrollView {
        // Arrastar com o botão apertado é para mover a lâmina, não para rolar a faixa.
        mouse-drag-pan-enabled: false;
        content-width: strip.preferred-width;
        content-height: self.height;
        scrolled => { root.sc-running = false; }
        TouchArea {
            width: strip.preferred-width;
            height: strip-scroll.height;
            scroll-event(e) => {
                if (e.delta-y != 0) {
                    root.wheel(e.delta-y);
                    return accept;
                }
                reject
            }
        }
        strip := HorizontalLayout {
            padding: 8px;
            padding-left: 10px;
            padding-right: 10px;
            spacing: 10px;
            for s[i] in root.spreads: VerticalLayout {
                spacing: 4px;
                Rectangle {
                    width: root.thumb / s.aspect + 6px;
                    height: (root.thumb + 6px);
                    // Reordenar (spec FX, regra 2): as vizinhas correm o tamanho da levantada; no
                    // fim, param sem animar (`snap`), porque a ordem nova já as põe no lugar.
                    property <length> off: DragUi.kind == 3 ? root.strip-shift(DragUi.from, root.live-gap, i) : 0px;
                    animate off {
                        duration: root.snap || !Motion.on ? 0ms : Motion.reorder-ms * 1ms;
                        easing: cubic-bezier(0.2, 0, 0, 1);
                    }
                    Rectangle {
                        x: parent.off;
                        width: parent.width;
                        height: parent.height;
                        border-radius: Radius.small;
                        border-width: 2px;
                        border-color: i == root.current-index || i == root.over-spread ? Theme.text-strong : transparent;
                        // A levantada sai do lugar: quem aparece é a miniatura que segue o mouse.
                        opacity: DragUi.kind == 3 && DragUi.from == i ? 0 : 1;
                        SpreadCanvas {
                            x: 3px;
                            y: 3px;
                            width: parent.width - 6px;
                            height: parent.height - 6px;
                            data: s;
                            small: true;
                        }
                        if s.warning: Rectangle {
                            x: parent.width - 21px;
                            y: 6px;
                            width: 14px;
                            height: 14px;
                            border-radius: self.height / 2;
                            background: Theme.warning;
                            Text { text: "!"; color: Theme.g1; font-size: Type.micro; font-weight: Type.semibold; }
                        }
                    }
                    TouchArea {
                        mouse-cursor: DragUi.kind == 3 ? MouseCursor.grabbing : MouseCursor.default;
                        moved => {
                            let x = self.absolute-position.x + self.mouse-x;
                            let y = self.absolute-position.y + self.mouse-y;
                            // Uma lâmina só não tem para onde ir (spec FX, seção 6).
                            if (DragUi.kind == 0 && !root.landing && root.spreads.length > 1 && DragUi.far(x, y)) {
                                root.grab-dx = DragUi.press-x - self.absolute-position.x;
                                root.grab-dy = DragUi.press-y - self.absolute-position.y;
                                DragUi.kind = 3;
                                DragUi.from = i;
                            }
                            if (!root.landing) {
                                DragUi.x = x;
                                DragUi.y = y;
                            }
                        }
                        pointer-event(e) => {
                            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                                DragUi.press-x = self.absolute-position.x + self.mouse-x;
                                DragUi.press-y = self.absolute-position.y + self.mouse-y;
                            }
                            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up) {
                                if (DragUi.kind == 3) {
                                    // O vão vira a posição pela regra do editor (spec MV, MV-B23),
                                    // depois do pouso (spec FX, regra 3).
                                    if (!root.landing) {
                                        root.release(root.over());
                                    }
                                } else if (!root.landing) {
                                    root.go-to(i);
                                    root.focus-main();
                                }
                            }
                        }
                    }
                }
                Text {
                    // Só as pontas com página simples têm selo (spec DJ, regra 17).
                    text: s.badge != "" ? (i + 1) + " · " + s.badge : (i + 1) + "";
                    horizontal-alignment: center;
                    color: i == root.current-index ? Theme.text-strong : Theme.text-2;
                    font-size: Type.small;
                    font-weight: i == root.current-index ? Type.semibold : Type.regular;
                }
            }
            // A área de lâmina nova: fotos soltas aqui viram uma lâmina montada.
            VerticalLayout {
                spacing: 4px;
                Rectangle {
                    width: root.thumb / max(0.01, root.current-aspect) + 6px;
                    height: (root.thumb + 6px);
                    border-radius: Radius.small;
                    border-width: 2px;
                    border-color: root.photo-gap == root.spreads.length ? Theme.text-strong : Theme.press;
                    background: root.photo-gap == root.spreads.length ? Theme.hover : transparent;
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        HorizontalLayout {
                            alignment: center;
                            Image { accessible-role: none; source: Icons.plus; colorize: Theme.text-2; width: 11px; height: 11px; }
                        }
                        Text {
                            text: "Lâmina nova\nsolte fotos aqui";
                            color: Theme.text-2;
                            font-size: Type.caption;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    new-touch := TouchArea { }
                }
                Text { text: " "; font-size: Type.small; }
            }
        }
        if keys.has-focus: FocusRing {
            x: 10px + root.current-index * root.item - 3px;
            y: 8px - 3px;
            width: root.thumb / max(0.01, root.current-aspect) + 6px + 6px;
            height: root.thumb + 6px + 6px;
            shown: true;
        }
        // Fotos soltas entre duas lâminas: o marcador no vão da lâmina nova (regra 7).
        if root.photo-gap >= 0 && root.photo-gap < root.spreads.length: Rectangle {
            x: 10px + root.photo-gap * (root.thumb / max(0.01, root.current-aspect) + 16px) - 7px;
            y: 8px;
            width: 4px;
            height: (root.thumb + 6px);
            border-radius: Radius.hair;
            background: Theme.text-strong;
        }
        // A miniatura levantada (spec FX, regras 1 e 3): segue o ponteiro, 8% maior e com sombra;
        // ao soltar, desliza até o vão (ou de volta ao lugar).
        if DragUi.kind == 3 && DragUi.from >= 0 && DragUi.from < root.spreads.length: Rectangle {
            property <length> follow-x: 10px + root.lift-x;
            property <length> follow-y: DragUi.y - strip-scroll.absolute-position.y - root.grab-dy;
            property <length> land-x: 10px + root.strip-landing(DragUi.from, root.drop-gap);
            x: (root.landing ? self.land-x : self.follow-x) - root.lift-w * 0.04;
            y: (root.landing ? 8px : self.follow-y) - (root.thumb + 6px) * 0.04;
            animate x, y {
                duration: root.landing && Motion.on ? Motion.reorder-ms * 1ms : 0ms;
                easing: cubic-bezier(0.2, 0, 0, 1);
            }
            width: root.lift-w * 1.08;
            height: (root.thumb + 6px) * 1.08;
            border-radius: Radius.small;
            border-width: 2px;
            border-color: Theme.text-strong;
            background: StripTheme.spreads;
            drop-shadow-blur: 12px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: Theme.shadow-strong;
            SpreadCanvas {
                x: 3px;
                y: 3px;
                width: parent.width - 6px;
                height: parent.height - 6px;
                data: root.spreads[DragUi.from];
                small: true;
            }
        }
    }
}
