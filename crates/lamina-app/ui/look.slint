// Painel de aparência (spec AP): espaço entre fotos, fundo, borda e cantos. Só desenho: os
// valores e as edições vêm do editor.

import { Button, LineEdit } from "std-widgets.slint";
import { Theme, Type, Radius, Space, Line, Elevation } from "theme.slint";
import { ColorArea, DialogButton, CheckRow } from "widgets.slint";
import { Icons } from "icons.slint";

export struct Swatch {
    c: color,
    name: string,
}

export component Stepper inherits HorizontalLayout {
    in property <string> value;
    callback step(int);
    spacing: 8px;
    Button { icon: Icons.minus; colorize-icon: true; accessible-label: "Menos"; width: 34px; clicked => { root.step(-1); } }
    Text {
        text: root.value;
        color: Theme.text;
        vertical-alignment: center;
        horizontal-alignment: center;
        min-width: 70px;
    }
    Button { icon: Icons.plus; colorize-icon: true; accessible-label: "Mais"; width: 34px; clicked => { root.step(1); } }
}

// 12 cores em duas linhas de 6.
export component Swatches inherits Rectangle {
    in property <[Swatch]> palette;
    in property <color> chosen;
    callback pick(int);
    height: 2 * 30px;
    for s[i] in root.palette: Rectangle {
        x: mod(i, 6) * 32px;
        y: floor(i / 6) * 30px;
        width: 26px;
        height: 26px;
        border-radius: Radius.small;
        background: s.c;
        border-width: s.c == root.chosen ? 2px : 1px;
        border-color: s.c == root.chosen ? Theme.text-strong : Theme.press;
        accessible-role: button;
        accessible-label: "Cor " + (i + 1);
        accessible-checked: s.c == root.chosen;
        accessible-action-default => { root.pick(i); }
        TouchArea { clicked => { root.pick(i); } }
    }
}

component Label inherits Text {
    color: Theme.text-2;
    font-size: Type.small;
}

// O estado da aba fica num global, como o dos presets (`app.slint` estava grande demais).
export global LookUi {
    in property <[Swatch]> palette;
    in property <string> gap;
    in property <string> border;
    in property <string> radius;
    in property <bool> split;
    in property <color> left;
    in property <color> right;
    in property <color> border-color;
    in property <bool> only-frame;
    in property <string> hex;
    in property <string> hex-right;
    in-out property <string> hex-error;
    callback gap-step(int);
    callback border-step(int);
    callback radius-step(int);
    callback background(int, int);
    // Uma cor pelo código ou pelo quadro de cores; o segundo número é o lado (-1 = a lâmina toda).
    callback background-hex(string, int);
    callback background-at(float, float, int);
    callback split-changed(bool);
    callback border-pick(int);
    callback apply-all();
    // Lâmina à mão (spec TX, regra 8): o espaço entre fotos não mexe nos quadros dela.
    in property <bool> manual;
}

// "Outra cor…" (spec DG, regra 9): o quadro de cores do Novo álbum e o código, para quem tem o número
// da gráfica. `side` é o lado do fundo, como nas cores prontas.
component OtherColor inherits HorizontalLayout {
    in property <int> side: -1;
    in property <color> current;
    in property <string> code;
    property <string> draft;
    changed code => { root.draft = root.code; }
    alignment: start;
    DialogButton {
        text: "Outra cor…";
        clicked => {
            root.draft = root.code;
            LookUi.hex-error = "";
            popup.show();
        }
        popup := PopupWindow {
            y: parent.height + Line.focus;
            close-policy: close-on-click-outside;
            Rectangle {
                background: Theme.raised;
                border-radius: Radius.medium;
                border-width: Line.thin;
                border-color: Theme.line;
                drop-shadow-blur: Elevation.menu-blur;
                drop-shadow-offset-y: Elevation.menu-y;
                drop-shadow-color: Elevation.menu-color;
                VerticalLayout {
                    padding: Space.s3;
                    spacing: Space.s2;
                    HorizontalLayout {
                        spacing: Space.s2;
                        Rectangle { width: 28px; height: 28px; border-radius: Radius.small; background: root.current; border-width: Line.thin; border-color: Theme.overlay; }
                        LineEdit {
                            width: 140px;
                            text <=> root.draft;
                            placeholder-text: "#F5F0E6";
                            accepted(t) => { LookUi.background-hex(t, root.side); }
                        }
                    }
                    if LookUi.hex-error != "": Text { text: LookUi.hex-error; color: Theme.warning; font-size: Type.small; wrap: word-wrap; }
                    ColorArea { picked(x, y) => { LookUi.background-at(x, y, root.side); } }
                }
            }
        }
    }
}

export component LookPanel inherits VerticalLayout {
    // Borda e cantos aqui; no modo organizar, com a seção Foto à vista, eles ficam só nela (OP).
    in property <bool> frame-style: true;
    // Depois de um clique, o teclado volta para a lâmina.
    callback done();
    spacing: 8px;

    Label { text: "Espaço entre fotos"; }
    Stepper { value: LookUi.gap; step(d) => { LookUi.gap-step(d); root.done(); } }
    if LookUi.manual: Text {
        text: "Esta lâmina está à mão: o espaço entre fotos não muda os quadros dela.";
        color: Theme.text-2;
        font-size: Type.small;
        wrap: word-wrap;
    }

    HorizontalLayout {
        Label { text: "Fundo"; vertical-alignment: center; }
        Rectangle { horizontal-stretch: 1; }
        CheckRow {
            text: "Por página";
            checked: LookUi.split;
            toggled => { LookUi.split-changed(self.checked); root.done(); }
        }
    }
    if !LookUi.split: Swatches {
        palette: LookUi.palette;
        chosen: LookUi.left;
        pick(i) => { LookUi.background(i, -1); root.done(); }
    }
    if !LookUi.split: OtherColor { current: LookUi.left; code: LookUi.hex; }
    if LookUi.split: Label { text: "Página esquerda"; }
    if LookUi.split: Swatches {
        palette: LookUi.palette;
        chosen: LookUi.left;
        pick(i) => { LookUi.background(i, 0); root.done(); }
    }
    if LookUi.split: OtherColor { side: 0; current: LookUi.left; code: LookUi.hex; }
    if LookUi.split: Label { text: "Página direita"; }
    if LookUi.split: Swatches {
        palette: LookUi.palette;
        chosen: LookUi.right;
        pick(i) => { LookUi.background(i, 1); root.done(); }
    }
    if LookUi.split: OtherColor { side: 1; current: LookUi.right; code: LookUi.hex-right; }

    if root.frame-style: Label { text: LookUi.only-frame ? "Borda (quadro selecionado)" : "Borda (todas as fotos da lâmina)"; }
    if root.frame-style: Stepper { value: LookUi.border; step(d) => { LookUi.border-step(d); root.done(); } }
    if root.frame-style: Swatches {
        palette: LookUi.palette;
        chosen: LookUi.border-color;
        pick(i) => { LookUi.border-pick(i); root.done(); }
    }

    if root.frame-style: Label { text: LookUi.only-frame ? "Cantos (quadro selecionado)" : "Cantos (todas as fotos da lâmina)"; }
    if root.frame-style: Stepper { value: LookUi.radius; step(d) => { LookUi.radius-step(d); root.done(); } }

    Rectangle { vertical-stretch: 1; }
    DialogButton { text: "Aplicar a todas as lâminas"; clicked => { LookUi.apply-all(); root.done(); } }
}
