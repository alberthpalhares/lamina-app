// Presets (spec PR): o nome de um preset novo e a lista dos presets do fotógrafo. O estado mora no
// global `PresetUi`, que o Rust lê e escreve; a especificação do álbum é a etapa 1 do Novo álbum.

import { LineEdit } from "std-widgets.slint";
import { Theme, Type, Space } from "theme.slint";
import { Icons } from "icons.slint";
import { Dialog, DialogSize, DialogFooter, DialogButton, FirstLineEdit, PickList, EmptyState } from "widgets.slint";

export global PresetUi {
    // Os nomes: os do Lamina, os do fotógrafo e, por último, "Personalizado".
    in property <[string]> presets;
    // Novo álbum: o preset escolhido e a faixa de páginas.
    in-out property <int> new-preset;
    in-out property <string> new-min;
    in-out property <string> new-max;
    // Especificação do álbum aberto.
    in-out property <bool> show-spec;
    in-out property <int> spec-preset;
    in-out property <string> spec-width;
    in-out property <string> spec-height;
    in-out property <string> spec-dpi;
    in-out property <string> spec-bleed;
    in-out property <string> spec-safe;
    in-out property <string> spec-spine;
    in-out property <bool> spec-starts;
    in-out property <bool> spec-ends;
    in-out property <string> spec-min;
    in-out property <string> spec-max;
    in property <string> spec-error;
    // Nome de um preset novo.
    in-out property <bool> show-name;
    in-out property <string> name;
    // A encadernadora do preset novo, opcional (spec ET, regra 7).
    in-out property <string> lab;
    in property <string> labs-text;
    in property <string> name-message;
    // Presets do fotógrafo.
    in-out property <bool> show-list;
    in property <[string]> user-presets;
    in-out property <int> list-selected: -1;
    in-out property <string> list-name;
    in property <string> list-message;
    // 0 = novo álbum, 1 = especificação do álbum.
    callback picked(int, int);
    callback save-as(int);
    callback new-changed();
    callback spec-changed();
    callback spec-apply();
    callback name-save();
    callback list-rename();
    callback list-delete();
    callback closed();
}

// O nome de um preset novo.
export component PresetNameDialog inherits Dialog {
    title: "Salvar como preset";
    child-focus: true;
    dismissed => { PresetUi.show-name = false; }
    FirstLineEdit { text <=> PresetUi.name; placeholder-text: "ex.: Flat 30 × 30"; accepted => { PresetUi.name-save(); } }
    LineEdit { text <=> PresetUi.lab; placeholder-text: "Encadernadora (opcional)"; accepted => { PresetUi.name-save(); } }
    if PresetUi.labs-text != "": Text { text: "Já usados: " + PresetUi.labs-text; color: Theme.text-2; font-size: Type.small; wrap: word-wrap; }
    if PresetUi.name-message != "": Text { text: PresetUi.name-message; color: Theme.warning; wrap: word-wrap; }
    DialogFooter {
        DialogButton { text: "Cancelar"; clicked => { PresetUi.show-name = false; } }
        DialogButton { text: "Salvar"; primary: true; clicked => { PresetUi.name-save(); } }
    }
}

// Arquivo → Presets…: os presets do fotógrafo. Sem nada salvo, diz o que fazer; a linha de renomear
// só aparece com um preset escolhido (spec DD, regra 24).
export component PresetsDialog inherits Dialog {
    title: "Meus presets";
    size: DialogSize.form;
    child-focus: true;
    dismissed => { PresetUi.show-list = false; PresetUi.closed(); }
    if PresetUi.user-presets.length == 0: EmptyState {
        icon: Icons.layouts;
        text: "Nenhum preset salvo.\nUse \"Salvar como preset…\" no Novo álbum, em Personalizado.";
    }
    if PresetUi.user-presets.length > 0: Text {
        text: "Os presets do Lamina não aparecem aqui: não dá para mudá-los.";
        color: Theme.text-2;
        wrap: word-wrap;
    }
    if PresetUi.user-presets.length > 0: PickList {
        label: "Meus presets";
        items: PresetUi.user-presets;
        selected <=> PresetUi.list-selected;
        picked(name) => { PresetUi.list-name = name; }
    }
    if PresetUi.list-selected >= 0: HorizontalLayout {
        spacing: Space.s2;
        vertical-stretch: 0;
        LineEdit { text <=> PresetUi.list-name; accepted => { PresetUi.list-rename(); } }
        DialogButton { text: "Renomear"; clicked => { PresetUi.list-rename(); } }
        DialogButton { text: "Apagar"; danger: true; clicked => { PresetUi.list-delete(); } }
    }
    if PresetUi.list-message != "": Text { text: PresetUi.list-message; color: Theme.warning; wrap: word-wrap; }
    DialogFooter {
        DialogButton { text: "Fechar"; primary: true; takes-focus: true; clicked => { PresetUi.show-list = false; PresetUi.closed(); } }
    }
}
