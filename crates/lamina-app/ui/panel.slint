// O painel da direita da janela: as abas Detalhes, Aparência, Quadro e Histórico (os layouts ficam
// na faixa de layouts, spec FL). Só desenho: os dados chegam da janela principal, e cada clique
// devolve o teclado à lâmina.

import { Theme } from "theme.slint";
import { LookPanel } from "look.slint";
import { FramePanel } from "frame.slint";
import { HistoryPanel, HistoryItem } from "history.slint";
import { PanelTabs, InfoPanel, DetailRow } from "side.slint";
import { PhotoPreview } from "photo_view.slint";
import { OrganizeUi, OrganizePanel } from "organize.slint";

// A borda esquerda do painel (spec FX, regra 13): arrastar muda a largura, clique duplo volta à
// de sempre. O Rust prende a largura entre 260 px e 45% da janela e a guarda.
export component PanelDivider inherits Rectangle {
    in property <length> shown;
    callback moved(length);
    callback released();
    callback reset();
    width: 5px;
    background: touch.has-hover || root.dragging ? Theme.g7 : Theme.panel;
    property <length> start-w;
    property <length> press-x;
    property <bool> dragging;
    touch := TouchArea {
        mouse-cursor: col-resize;
        double-clicked => { root.reset(); }
        pointer-event(e) => {
            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                root.start-w = root.shown;
                root.press-x = self.absolute-position.x + self.mouse-x;
            }
            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up && root.dragging) {
                root.dragging = false;
                root.released();
            }
        }
        moved => {
            if (self.pressed) {
                root.dragging = true;
                root.moved(root.start-w + root.press-x - (self.absolute-position.x + self.mouse-x));
            }
        }
    }
}

export component RightPanel inherits Rectangle {
    // A largura arrastada pela borda (spec FX, regra 13).
    in property <length> panel-width: 300px;
    // A prévia da foto escolhida, acima das abas (spec VF, decisão do dono 2026-11-04).
    in property <bool> photo-preview: false;
    in-out property <int> tab;
    in property <[HistoryItem]> history;
    in property <int> history-pos;
    in property <string> info-album;
    in property <string> info-spread;
    in property <string> info-warnings;
    in property <string> info-frame;
    in property <bool> info-frame-warn;
    in property <string> info-photo;
    // A aba Detalhes (spec AF): as linhas e o tipo da seleção (0 álbum, 1 foto, 2 texto, 3 vários).
    in property <[DetailRow]> details;
    // As linhas da seção Impressão (spec DJ, regra 15).
    in property <[DetailRow]> details-print;
    in property <int> details-kind;
    in property <string> details-count;
    callback history-go(int);
    callback done();
    // Um comando do registro pelo nome estável (o painel de alinhar do modo; spec GJ).
    callback command(string);
    width: root.panel-width;
    background: Theme.panel;
    // A zona própria do painel: um fio na borda (spec DJ, saída 5).
    Rectangle { x: 0; width: 1px; background: Theme.line; }
    VerticalLayout {
        padding: 12px;
        spacing: 8px;
        // A prévia da foto (spec VF): área fixa acima das abas; some (0 px) sem foto escolhida.
        PhotoPreview { }
        // No modo organizar, o painel do modo no lugar das abas (spec EG, EG-B23).
        if OrganizeUi.on: OrganizePanel {
            vertical-stretch: 1;
            done => { root.done(); }
            command(c) => { root.command(c); }
        }
        if !OrganizeUi.on: PanelTabs { tab <=> root.tab; }
        if !OrganizeUi.on && root.tab == 2: LookPanel {
            vertical-stretch: 1;
            done => { root.done(); }
        }
        if !OrganizeUi.on && (root.tab == 4 || (root.tab == 1 && root.details-kind == 2)): FramePanel {
            vertical-stretch: 1;
            done => { root.done(); }
        }
        if !OrganizeUi.on && root.tab == 3: HistoryPanel {
            vertical-stretch: 1;
            items: root.history;
            position: root.history-pos;
            go(i) => { root.history-go(i); root.done(); }
        }
        if !OrganizeUi.on && root.tab == 1 && root.details-kind != 2: InfoPanel {
            vertical-stretch: 1;
            rows: root.details;
            print-rows: root.details-print;
            kind: root.details-kind;
            count: root.details-count;
            album: root.info-album;
            spread: root.info-spread;
            warnings: root.info-warnings;
            frame: root.info-frame;
            frame-warn: root.info-frame-warn;
            photo: root.info-photo;
        }
    }
}